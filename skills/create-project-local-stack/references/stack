#!/usr/bin/env python3
"""Isolated local stack for this repository. Run `local-stack/stack --help`."""

import argparse
import contextlib
import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
CHECKOUT = HERE.parent
CONFIG = json.loads((HERE / "stack.json").read_text())
APP = CONFIG["app"]
PORTS = CONFIG.get("ports", {})
SWITCHES = CONFIG.get("switches", {})
VARS = CONFIG.get("vars", {})
PROVIDES = CONFIG.get("provides", [])
DEFAULT_STACK_FILE = HERE / ".stack.env"
VARIABLE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
READY_TIMEOUT_SECONDS = 900
PORT_ATTEMPTS = 3


class StackError(Exception):
    pass


def main():
    args = parse_args()
    try:
        check_config()
        args.run(args)
    except StackError as error:
        sys.exit(f"stack: {error}")


def check_config():
    for key in [*PORTS, *VARS, *PROVIDES]:
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise StackError(f"stack.json: {key!r} must be an upper-case variable name")
    for switch, spec in SWITCHES.items():
        modes = spec["modes"]
        if spec["default"] not in modes:
            raise StackError(f"stack.json: switch {switch!r} defaults to a mode it does not have")
        if spec.get("shared") and "stub" not in modes:
            raise StackError(f"stack.json: shared switch {switch!r} needs a stub mode")
        keys = {mode: set(spec_mode.get("vars", {})) for mode, spec_mode in modes.items()}
        if len({frozenset(names) for names in keys.values()}) > 1:
            raise StackError(f"stack.json: every mode of switch {switch!r} must set the same variables")
        for mode, spec_mode in modes.items():
            for target, request in spec_mode.get("dependencies", {}).items():
                where = f"stack.json: {switch}={mode} dependencies.{target}"
                if not any("stack" in target_mode for target_mode in SWITCHES.get(target, {}).get("modes", {}).values()):
                    raise StackError(f"{where}: {target!r} is not a switch with a stack mode")
                if set(request) - {"modes", "env"}:
                    raise StackError(f"{where}: only \"modes\" and \"env\" are allowed")
                for key in request.get("env", {}):
                    if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
                        raise StackError(f"{where}: {key!r} must be an upper-case variable name")
            repo = spec_mode.get("stack")
            if repo is not None and not re.fullmatch(r"[\w.-]+(/[\w.-]+)+", repo):
                raise StackError(f"stack.json: {switch}={mode} \"stack\" must be the other repo's path in its git remote, such as \"my-org/catalog\"")


def parse_args():
    parser = argparse.ArgumentParser(prog="local-stack/stack", description=f"Isolated local stack of {APP}.")
    commands = parser.add_subparsers(required=True, metavar="command")

    def command(name, run, help_text):
        sub = commands.add_parser(name, help=help_text, description=help_text)
        sub.add_argument("--name", help="stack name; default: the current branch")
        sub.set_defaults(run=run)
        return sub

    up_parser = command("up", up, "start the stack, or update a running one")
    up_parser.set_defaults(attach=[])
    attach_parser = command("attach", up, "like up, but each named switch uses another repo's stack that already runs, found by its stack name; never starts, stops or changes that stack; down here undoes it")
    attach_parser.add_argument("attach", nargs="+", metavar="SWITCH=NAME", help="a switch with a stack mode and the name of the other repo's running stack")
    for sub in (up_parser, attach_parser):
        sub.add_argument("--app", action="store_true", help="also run the app in a container: every switch with a container mode")
        sub.add_argument("--stubs", action="store_true", help="stub every shared service, here and in dependency stacks")
        sub.add_argument("--mode", action="append", default=[], metavar="SWITCH=MODE", help="pick one switch's mode")
        sub.add_argument("--use", action="append", default=[], metavar="SWITCH=FOLDER", help="the clone of the repo a switch starts, for this run only, instead of the one next to this repo")
    command("down", down, "stop the stack; keep its data and ports; remove its stack file until the next up")
    command("destroy", destroy, "remove the stack: containers, volumes, built images, its files, dependency stacks")
    command("status", status, "show the stack's modes, ports and containers")
    env_parser = command("env", env, "print the stack file")
    env_parser.add_argument("--provides", action="store_true", help="print only the variables this stack provides to others")
    compose_parser = command("compose", compose, "run docker compose on this stack, e.g. `compose logs -f`")
    compose_parser.add_argument("compose_args", nargs=argparse.REMAINDER)
    return parser.parse_args()


def up(args):
    name = stack_name(args.name)
    project = f"{APP}-{name}"
    attachments = chosen_attachments(args.attach)
    modes = chosen_modes(args, attachments)
    clones = chosen_clones(args.use)
    both = sorted(set(clones) & set(attachments))
    if both:
        raise StackError(f"--use and attach both name {', '.join(both)}; an attached switch starts no clone")
    attached = {switch: find_attached(switch, SWITCHES[switch]["modes"][modes[switch]]["stack"], attached_name) for switch, attached_name in attachments.items()}
    with stack_lock(name):
        check_owner(project)
        spare_from = spare_ports_start()
        too_high = [f"{key}={port}" for key, port in PORTS.items() if port >= spare_from]
        if too_high:
            raise StackError(f"stack.json: usual ports must be below {spare_from}, where this system's spare ports start: {', '.join(too_high)}")
        dependencies = {switch: dependency_record(switch, SWITCHES[switch]["modes"][mode]["stack"], project, clones) for switch, mode in modes.items() if SWITCHES[switch]["modes"][mode].get("stack") and switch not in attached}
        record = read_record(name)
        for switch, other in attached.items():
            if other in record.get("needs", []):
                raise StackError(f"stack {other['name']} in {other['checkout']} is a dependency stack this stack started; run `local-stack/stack up`, which uses it already")
        for switch, dependency in dependencies.items():
            elsewhere = [other["checkout"] for other in record.get("needs", []) if other["switch"] == switch and other["checkout"] != dependency["checkout"]]
            if elsewhere:
                raise StackError(f"stack {project} runs {switch} from {elsewhere[0]}, not {dependency['checkout']}; run `local-stack/stack destroy --name {name}` first, or pick another name with --name")
        gateway = gateway_ip()
        active, published = compose_plan(project, modes, gateway)
        ports = choose_ports(project, name, record.get("ports", {}), published, spare_from)
        record.update(modes=modes, ports=ports, attached=list(attached.values()))
        write_record(name, record)
        base = {"LOCAL_STACK_GATEWAY_IP": gateway, "LOCAL_STACK_CHECKOUT": str(CHECKOUT)}
        requests = dependency_requests(modes, {**base, **ports})
        for switch in attached:
            request = requests.get(switch, {})
            if request.get("modes") or request.get("env"):
                print(f"stack: {switch} is attached, so its stack runs as it was started, without what this stack's modes ask of it: {describe(request.get('modes', {}))}; env {', '.join(request.get('env', {})) or 'none'}", file=sys.stderr)
        records = record.get("needs", [])
        started = []
        dependency_values = {}
        for switch, dependency in dependencies.items():
            if dependency not in records:
                records.append(dependency)
            record["needs"] = records
            write_record(name, record)
            dependency_values.update(start_dependency(switch, dependency, args.stubs, requests.get(switch, {})))
            started.append(dependency)
        for switch, other in attached.items():
            dependency_values.update(provided_values(switch, other))
        summary = stack_summary(project, dependencies, attached)
        path = stack_file(name)
        if name == default_stack_name():
            link_default_stack_file(path)
        for attempt in range(1, PORT_ATTEMPTS + 1):
            values = stack_values(project, name, summary, modes, {**base, **ports, **dependency_values})
            record.update(ports=ports, values=values)
            write_record(name, record)
            path.write_text("".join(f"{key}={value}\n" for key, value in values.items()))
            stop_inactive_services(project, values, active)
            if not active:
                break
            try:
                run_compose(project, values, profiles(modes), ["up", "--detach", "--build", "--remove-orphans"])
                break
            except StackError:
                lost = lost_ports(project, ports, published)
                if not lost or attempt == PORT_ATTEMPTS:
                    raise
                if any(ports[key] < spare_from for key in lost):
                    raise StackError(f"usual ports taken while the stack started: {describe_ports(lost, ports)}; free them and run up again")
                print(f"stack: ports taken before the stack could bind them: {describe_ports(lost, ports)}; picking new ones", file=sys.stderr)
                ports = {**ports, **spare_ports(list(lost), set(ports.values()) | set(port_holders()))}
        if active:
            wait_until_ready(project, values, modes, active)
        for dependency in records:
            if dependency not in started:
                run_dependency(dependency, "down")
    print(f"Stack {project} is up. Modes: {describe(modes)}.", file=sys.stderr)
    for switch, other in attached.items():
        print(f"Attached {switch}: stack {other['name']} of {other['checkout']}, which this stack never starts, stops or changes", file=sys.stderr)
    print(f"Stack file: {path}", file=sys.stderr)


def stack_values(project, name, summary, modes, values):
    values = dict(values)
    for switch, mode in modes.items():
        for key, template in SWITCHES[switch]["modes"][mode].get("vars", {}).items():
            values[key] = interpolate(template, values, f"{switch}={mode} {key}")
    for key, template in VARS.items():
        values[key] = interpolate(template, values, key)
    return {"LOCAL_STACK_PROJECT": project, "LOCAL_STACK_NAME": name, "LOCAL_STACK_SUMMARY": summary, **values}


def stack_summary(project, dependencies, attached):
    others = [f"{switch} from stack {other['name']} of {other['checkout']}" for switch, other in dependencies.items()]
    others += [f"{switch} from stack {other['name']} of {other['checkout']} (attached)" for switch, other in attached.items()]
    return f"Local stack {', '.join([f'{project} of {CHECKOUT}', *others])}. Run local-stack/stack down to stop using it."


def link_default_stack_file(path):
    temporary = HERE / f".stack.{os.getpid()}.env"
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(path.name)
    temporary.replace(DEFAULT_STACK_FILE)


def down(args):
    name = stack_name(args.name)
    project = f"{APP}-{name}"
    with stack_lock(name):
        check_owner(project)
        running = docker("ps", "--filter", f"label=com.docker.compose.project={project}", "--format", "{{.ID}} {{.Names}}").splitlines()
        if running:
            docker("stop", *(line.split()[0] for line in running))
            for line in running:
                print(f"stack: stopped {line.split()[1]}", file=sys.stderr)
        record = read_record(name)
        for dependency in record.get("needs", []):
            run_dependency(dependency, "down")
        stack_file(name).unlink(missing_ok=True)
        if record.pop("attached", None):
            write_record(name, record)


def destroy(args):
    name = stack_name(args.name)
    project = f"{APP}-{name}"
    with stack_lock(name):
        check_owner(project)
        record = read_record(name)
        run_compose(project, saved_values(name, record), ["*"], ["down", "--volumes", "--rmi", "local", "--remove-orphans"])
        for dependency in record.get("needs", []):
            run_dependency(dependency, "destroy")
        stack_file(name).unlink(missing_ok=True)
        record_path(name).unlink(missing_ok=True)


def status(args):
    name = stack_name(args.name)
    project = f"{APP}-{name}"
    record = read_record(name)
    if not record:
        print(f"No stack {project} in {CHECKOUT}.")
        return
    print(f"Stack {project} of {CHECKOUT}. Modes: {describe(record.get('modes', {}))}.")
    print(f"Stack file: {stack_file(name)}")
    for key, port in record.get("ports", {}).items():
        print(f"  {key}={port}")
    for dependency in record.get("needs", []):
        print(f"Dependency {dependency['switch']}: {dependency['checkout']}, stack name {dependency['name']}")
    for other in record.get("attached", []):
        print(f"Attached {other['switch']}: {other['checkout']}, stack name {other['name']}")
    sys.stdout.flush()
    run_compose(project, saved_values(name, record), ["*"], ["ps", "--all"])


def env(args):
    name = stack_name(args.name)
    check_owner(f"{APP}-{name}")
    path = stack_file(name)
    if not path.exists():
        raise StackError(f"no stack file {path}; run `local-stack/stack up` first")
    for key, value in parse_env(path.read_text()).items():
        if not args.provides or key in PROVIDES:
            print(f"{key}={value}")


def compose(args):
    name = stack_name(args.name)
    project = f"{APP}-{name}"
    check_owner(project)
    record = read_record(name)
    if not record:
        raise StackError(f"no stack {project}; run `local-stack/stack up` first")
    compose_args = args.compose_args[1:] if args.compose_args[:1] == ["--"] else args.compose_args
    run_compose(project, saved_values(name, record), profiles(record.get("modes", {})), compose_args)


def stack_name(given):
    name = given or default_name()
    name = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if not name:
        raise StackError("the stack name is empty after keeping only letters, digits and dashes")
    return name


def default_name():
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch and branch != "HEAD":
        return branch
    commit = git("rev-parse", "--short", "HEAD")
    return f"detached-{commit}" if commit else CHECKOUT.name


def git(*args):
    result = subprocess.run(["git", "-C", str(CHECKOUT), *args], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def default_stack_name():
    return stack_name(default_name())


def check_owner(project):
    working_dirs = docker("ps", "--all", "--filter", f"label=com.docker.compose.project={project}", "--format", '{{.Label "com.docker.compose.project.working_dir"}}').split("\n")
    others = sorted({working_dir for working_dir in working_dirs if working_dir and working_dir != str(HERE)})
    if others:
        raise StackError(f"stack {project} belongs to {Path(others[0]).parent}; run this there, or pick another name with --name")


def stack_file(name):
    return HERE / f".stack-{name}.env"


def record_path(name):
    return HERE / f".stack-{name}.json"


def read_record(name):
    path = record_path(name)
    return json.loads(path.read_text()) if path.exists() else {}


def write_record(name, record):
    path = record_path(name)
    temporary = path.with_name(f"{path.name}.tmp")
    temporary.write_text(json.dumps(record, indent=2) + "\n")
    temporary.replace(path)


def chosen_attachments(attach):
    attachments = {}
    for choice in attach:
        switch, _, name = choice.partition("=")
        if not stack_modes(switch):
            raise StackError(f"attach {choice}: {switch!r} is not a switch with a stack mode")
        if not name:
            raise StackError(f"attach {choice}: name the other repo's running stack, such as {switch}=main")
        attachments[switch] = stack_name(name)
    return attachments


def stack_modes(switch):
    return [mode for mode, spec in SWITCHES.get(switch, {}).get("modes", {}).items() if "stack" in spec]


def chosen_modes(args, attachments):
    modes = {switch: spec["default"] for switch, spec in SWITCHES.items()}
    if args.stubs:
        modes.update({switch: "stub" for switch, spec in SWITCHES.items() if spec.get("shared")})
    if args.app:
        modes.update({switch: "container" for switch, spec in SWITCHES.items() if "container" in spec["modes"]})
    for choice in args.mode:
        switch, _, mode = choice.partition("=")
        if switch not in SWITCHES:
            raise StackError(f"unknown switch {switch!r}; switches: {', '.join(SWITCHES) or 'none'}")
        if mode not in SWITCHES[switch]["modes"]:
            raise StackError(f"switch {switch!r} has no mode {mode!r}; modes: {', '.join(SWITCHES[switch]['modes'])}")
        modes[switch] = mode
    for switch in attachments:
        if modes[switch] not in stack_modes(switch):
            if len(stack_modes(switch)) > 1:
                raise StackError(f"switch {switch!r} has several stack modes: {', '.join(stack_modes(switch))}; pick one with --mode {switch}=<mode>")
            modes[switch] = stack_modes(switch)[0]
    return modes


def profiles(modes):
    return [f"{switch}-{mode}" for switch, mode in modes.items()]


def describe(modes):
    return ", ".join(f"{switch}={mode}" for switch, mode in modes.items()) or "none"


def interpolate(template, values, where):
    def replace(match):
        key = match.group(1)
        if key in values:
            return str(values[key])
        if key in os.environ:
            return os.environ[key]
        raise StackError(f"{where} needs ${{{key}}}, which is neither a stack value nor set in your environment")

    return VARIABLE.sub(replace, template)


@contextlib.contextmanager
def stack_lock(name):
    path = HERE / f".stack-{name}.lock"
    waiting = False
    while True:
        with open(path, "a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                if not waiting:
                    print(f"stack: waiting for another command on stack {APP}-{name}", file=sys.stderr)
                    waiting = True
                fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                current = os.stat(path).st_ino
            except FileNotFoundError:
                current = None
            # the lock file is deleted while held when its stack has no record; a waiter that locked the deleted file locks again
            if current == os.fstat(lock.fileno()).st_ino:
                try:
                    yield
                finally:
                    if not record_path(name).exists():
                        path.unlink(missing_ok=True)
                return


def spare_ports_start():
    linux = Path("/proc/sys/net/ipv4/ip_local_port_range")
    if linux.exists():
        return int(linux.read_text().split()[0])
    result = subprocess.run(["sysctl", "-n", "net.inet.ip.portrange.first"], capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.strip().isdigit():
        return int(result.stdout)
    raise StackError("cannot read this system's ephemeral port range")


def compose_plan(project, modes, gateway):
    probe_ports = {key: str(index + 1) for index, key in enumerate(PORTS)}
    placeholders = {key: "" for spec in SWITCHES.values() for mode in spec["modes"].values() for key in mode.get("vars", {})}
    placeholders.update({key: "" for key in [*VARS, "LOCAL_STACK_PROJECT", "LOCAL_STACK_NAME", "LOCAL_STACK_CHECKOUT"]})
    values = {**placeholders, "LOCAL_STACK_GATEWAY_IP": gateway, **probe_ports}
    services = json.loads(run_compose(project, values, profiles(modes), ["config", "--format", "json"], capture=True)).get("services") or {}
    numbers = {port for service in services.values() for entry in service.get("ports", []) for port in port_range(str(entry.get("published", "")))}
    return set(services), {key for key, probe in probe_ports.items() if int(probe) in numbers}


def port_range(text):
    first, _, last = text.partition("-")
    return range(int(first), int(last or first) + 1) if first.isdigit() else range(0)


def choose_ports(project, name, recorded, published, spare_from):
    holders = port_holders()

    def available(port):
        holder = holders.get(port)
        return holder["project"] == project if holder else port_is_free(port)

    if name == default_stack_name():
        blocked = {key: PORTS[key] for key in published if not available(PORTS[key])}
        if not blocked:
            return dict(PORTS)
        siblings = sorted({describe_holder(port, holders) for port in blocked.values() if is_sibling_stack(holders.get(port))})
        if not siblings:
            raise StackError(f"usual ports are taken: {describe_ports(blocked, PORTS, holders)}; free them and run up again")
        print(f"stack: the usual ports are held by {', '.join(siblings)}, so this stack uses spare ports", file=sys.stderr)
    def unused_by_others(port):
        holder = holders.get(port)
        return not holder or holder["project"] == project

    kept = {key: port for key, port in recorded.items() if key in PORTS and port >= spare_from and (available(port) if key in published else unused_by_others(port))}
    picked = spare_ports([key for key in PORTS if key not in kept], set(kept.values()) | set(holders))
    return {key: kept.get(key, picked.get(key)) for key in PORTS}


def is_sibling_stack(holder):
    if not holder or not holder["working_dir"]:
        return False
    config = Path(holder["working_dir"]) / "stack.json"
    try:
        return json.loads(config.read_text()).get("app") == APP
    except (OSError, ValueError):
        return False


def spare_ports(keys, avoid):
    chosen = {}
    probes = []
    try:
        for key in keys:
            for _ in range(100):
                probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                probes.append(probe)
                probe.bind(("0.0.0.0", 0))
                port = probe.getsockname()[1]
                if port not in avoid:
                    break
            else:
                raise StackError("the system has no free spare port left")
            chosen[key] = port
            avoid.add(port)
    finally:
        for probe in probes:
            probe.close()
    return chosen


def lost_ports(project, ports, published):
    holders = port_holders()
    lost = {}
    for key in published:
        holder = holders.get(ports[key])
        if holder and holder["project"] == project:
            continue
        if holder or not port_is_free(ports[key]):
            lost[key] = ports[key]
    return lost


def port_holders():
    output = docker("ps", "--format", '{{.Names}}\t{{.Label "com.docker.compose.project"}}\t{{.Label "com.docker.compose.project.working_dir"}}\t{{.Ports}}')
    holders = {}
    for line in output.splitlines():
        container, project, working_dir, published = (line.split("\t") + ["", "", "", ""])[:4]
        for first, last in re.findall(r":(\d+)(?:-(\d+))?->", published):
            for port in range(int(first), int(last or first) + 1):
                holders[port] = {"project": project, "working_dir": working_dir, "container": container}
    return holders


def describe_ports(keys, ports, holders=None):
    holders = port_holders() if holders is None else holders
    return ", ".join(f"{key}={ports[key]} by {describe_holder(ports[key], holders)}" for key in keys)


def describe_holder(port, holders):
    holder = holders.get(port)
    if holder and holder["working_dir"]:
        return f"Compose project {holder['project']} in {holder['working_dir']}"
    if holder:
        return f"container {holder['container']}"
    return process_holding(port)


def process_holding(port):
    with contextlib.suppress(OSError):
        output = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpc"], capture_output=True, text=True).stdout
        match = re.search(r"^p(\d+)\nc(.+)$", output, re.MULTILINE)
        if match:
            return f"process {match.group(2)} (PID {match.group(1)})"
    with contextlib.suppress(OSError):
        output = subprocess.run(["ss", "-Hltnp", f"sport = :{port}"], capture_output=True, text=True).stdout
        match = re.search(r'"([^"]+)",pid=(\d+)', output)
        if match:
            return f"process {match.group(1)} (PID {match.group(2)})"
    return "a process this user cannot see"


def port_is_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("0.0.0.0", port))
        except OSError:
            return False
    return True


def docker(*args):
    result = subprocess.run(["docker", *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise StackError(f"docker {args[0]} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def dependency_record(switch, repo, project, clones):
    command = (clones.get(switch) or find_clone(switch, repo)) / "local-stack" / "stack"
    if not os.access(command, os.X_OK):
        raise StackError(f"{command} does not exist; {switch} needs its own local stack first")
    return {"switch": switch, "checkout": str(command.parent.parent), "name": project}


def find_clone(switch, repo):
    advice = f"clone it next to this repo, or name your clone for this run: `local-stack/stack up --use {switch}=<folder>`"
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    main_clone = Path(common).parent if common.endswith("/.git") else CHECKOUT
    found = sorted(folder for folder in main_clone.parent.iterdir() if (folder / ".git").is_dir() and is_clone(folder, repo))
    if not found:
        raise StackError(f"{switch} needs a clone of {repo}, and none is next to this repo in {main_clone.parent}; {advice}")
    if len(found) > 1:
        raise StackError(f"{switch} needs a clone of {repo}, and {main_clone.parent} holds several: {', '.join(map(str, found))}; pick one for this run: `local-stack/stack up --use {switch}=<folder>`")
    return found[0]


def chosen_clones(uses):
    clones = {}
    for use in uses:
        switch, _, folder = use.partition("=")
        if not stack_modes(switch):
            raise StackError(f"--use {use}: {switch!r} is not a switch with a stack mode")
        folder = Path(folder).expanduser().resolve()
        repo = SWITCHES[switch]["modes"][stack_modes(switch)[0]]["stack"]
        if not is_clone(folder, repo):
            raise StackError(f"--use {use}: {folder} is not a clone of {repo}")
        clones[switch] = folder
    return clones


def is_clone(folder, repo):
    """Whether a remote of the git checkout in folder is repo; reads only .git/config of a main clone, so a scan stays fast."""
    git_dir = folder / ".git"
    if git_dir.is_dir():
        config = git_dir / "config"
        urls = remote_urls(config.read_text(errors="replace")) if config.is_file() else []
    elif git_dir.is_file():
        result = subprocess.run(["git", "-C", str(folder), "config", "--get-regexp", r"^remote\..*\.url$"], capture_output=True, text=True)
        urls = [line.split(maxsplit=1)[-1] for line in result.stdout.splitlines()]
    else:
        return False
    wanted = repo.removesuffix(".git").lower()
    return any(re.search(rf"[/:]{re.escape(wanted)}$", url.rstrip("/").removesuffix(".git").lower()) for url in urls)


def remote_urls(config):
    urls = []
    section = None
    for line in config.splitlines():
        header = re.match(r'\s*\[\s*([^\]\s"]+)', line)
        if header:
            section = header.group(1).lower()
            continue
        url = re.match(r"\s*url\s*=\s*(.+?)\s*$", line, re.IGNORECASE)
        if section == "remote" and url:
            urls.append(url.group(1).strip('"'))
    return urls


def dependency_requests(modes, values):
    requests = {}
    for switch, mode in modes.items():
        for target, request in SWITCHES[switch]["modes"][mode].get("dependencies", {}).items():
            merged = requests.setdefault(target, {"modes": {}, "env": {}})
            for target_switch, target_mode in request.get("modes", {}).items():
                if merged["modes"].get(target_switch, target_mode) != target_mode:
                    raise StackError(f"two modes ask dependency {target!r} for different {target_switch!r} modes")
                merged["modes"][target_switch] = target_mode
            for key, template in request.get("env", {}).items():
                value = interpolate(template, values, f"{switch}={mode} dependencies.{target}.env.{key}")
                if merged["env"].get(key, value) != value:
                    raise StackError(f"two modes give dependency {target!r} different values of {key}")
                merged["env"][key] = value
    return requests


def find_attached(switch, repo, name):
    found = {}
    for line in set(docker("ps", "--format", '{{.Label "com.docker.compose.project"}}\t{{.Label "com.docker.compose.project.working_dir"}}').splitlines()):
        project, _, working_dir = line.partition("\t")
        if not working_dir:
            continue
        try:
            app = json.loads((Path(working_dir) / "stack.json").read_text())["app"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        checkout = Path(working_dir).parent
        if project.startswith(f"{app}-") and is_clone(checkout, repo):
            found[project.removeprefix(f"{app}-")] = checkout
    if name in found:
        return {"switch": switch, "checkout": str(found[name]), "name": name}
    running = ", ".join(f"{other} in {checkout}" for other, checkout in sorted(found.items())) or "none"
    raise StackError(f"no stack {name} of {repo} is running; its running stacks: {running}. Start it with `local-stack/stack up` in its checkout, or attach a running one")


def start_dependency(switch, record, stubs, request):
    mode_args = [f"--mode={target_switch}={mode}" for target_switch, mode in request.get("modes", {}).items()]
    run_dependency(record, "up", "--app", *(["--stubs"] if stubs else []), *mode_args, env=request.get("env", {}))
    return provided_values(switch, record)


def provided_values(switch, record):
    command = Path(record["checkout"]) / "local-stack" / "stack"
    result = subprocess.run([str(command), "env", "--provides", "--name", record["name"]], capture_output=True, text=True)
    if result.returncode != 0:
        raise StackError(f"{command} env --provides --name {record['name']} failed: {result.stderr.strip()}")
    prefix = re.sub(r"[^A-Z0-9]+", "_", switch.upper())
    values = {}
    for key, value in parse_env(result.stdout).items():
        values[f"{prefix}_{key}"] = value
        values[f"{prefix}_{key}_FROM_CONTAINER"] = re.sub(r"(?<![\w.-])(localhost|127\.0\.0\.1)(?![\w.-])", "host.docker.internal", value)
    return values


def run_dependency(record, *command, env=None):
    stack = Path(record["checkout"]) / "local-stack" / "stack"
    if not stack.exists():
        print(f"stack: skipping dependency {stack}, which no longer exists", file=sys.stderr)
        return
    result = subprocess.run([str(stack), *command, "--name", record["name"]], env={**os.environ, **(env or {})})
    if result.returncode != 0:
        raise StackError(f"dependency stack {stack} {command[0]} failed")


def saved_values(name, record):
    if record.get("values"):
        return record["values"]
    path = stack_file(name)
    if path.exists():
        return parse_env(path.read_text())
    values = {key: "" for spec in SWITCHES.values() for mode in spec["modes"].values() for key in mode.get("vars", {})}
    values.update({key: "" for key in VARS})
    values["LOCAL_STACK_GATEWAY_IP"] = "127.0.0.1"
    values.update({key: "0" for key in PORTS})
    values.update(record.get("ports", {}))
    return values


def gateway_ip():
    result = subprocess.run(["docker", "network", "inspect", "bridge", "--format", "{{(index .IPAM.Config 0).Gateway}}"], capture_output=True, text=True)
    address = result.stdout.strip()
    if result.returncode != 0 or not address:
        raise StackError("cannot read the gateway address of Docker's bridge network")
    return address


def wait_until_ready(project, values, modes, active):
    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    while True:
        output = run_compose(project, values, profiles(modes), ["ps", "--all", "--format", "json"], capture=True)
        containers = [entry for entry in parse_json_lines(output) if entry.get("Service") in active]
        failed = [entry["Service"] for entry in containers if entry.get("Health") == "unhealthy" or (entry.get("State") == "exited" and entry.get("ExitCode") != 0)]
        if failed:
            raise StackError(f"not ready: {', '.join(sorted(failed))}; see `local-stack/stack compose -- logs <service>`")
        waiting = active - {entry["Service"] for entry in containers if is_ready(entry)}
        if not waiting:
            return
        if time.monotonic() > deadline:
            raise StackError(f"still not ready after {READY_TIMEOUT_SECONDS} s: {', '.join(sorted(waiting))}")
        time.sleep(2)


def is_ready(container):
    if container.get("State") == "exited":
        return container.get("ExitCode") == 0
    return container.get("State") == "running" and container.get("Health") in ("", "healthy")


def parse_json_lines(output):
    output = output.strip()
    if output.startswith("["):
        return json.loads(output)
    return [json.loads(line) for line in output.splitlines() if line.strip()]


def stop_inactive_services(project, values, active):
    running = run_compose(project, values, ["*"], ["ps", "--all", "--services"], capture=True).split()
    inactive = [service for service in running if service not in active]
    if inactive:
        run_compose(project, values, ["*"], ["rm", "--stop", "--force", *inactive])


def run_compose(project, values, active_profiles, compose_args, capture=False):
    environment = {**os.environ, **{key: str(value) for key, value in values.items()}}
    environment.pop("COMPOSE_PROFILES", None)
    command = ["docker", "compose", "--project-name", project, "--project-directory", str(HERE), "--file", str(HERE / "compose.yaml")]
    for profile in active_profiles:
        command += ["--profile", profile]
    result = subprocess.run(command + compose_args, env=environment, stdout=subprocess.PIPE if capture else None, text=True)
    if result.returncode != 0:
        raise StackError(f"docker compose {' '.join(compose_args[:1])} failed for {project}")
    return result.stdout


def parse_env(text):
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line and not line.startswith("#"))


if __name__ == "__main__":
    main()
