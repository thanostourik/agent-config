#!/usr/bin/env python3
"""reach <ranges file>: which features check the code a change edits. bin/verify affected calls it.
reach --citations: the '# expects:' lines that cite code the checkouts do not have. bin/verify lint calls it.

The ranges file holds one changed line range per line, `<path>\t<first line>\t<lines>`, with paths as
recipes name them. Prints one finding per line:
  direct\t<feature>\t<file>: <scope>            an '# expects:' line cites the edited scope, or a unit test of it.
                                                The features whose cited behaviors share most words with the edit
                                                come first.
  caller\t<feature>\t<file>: <scope>\t<path>\t<behaviors>\t<uses>
                                                an '# expects:' line cites a scope that uses the edited one, <uses>
                                                uses away, three at most; <path> is the shortest way back to the edit,
                                                and <behaviors> are up to four behaviors the feature checks, joined by
                                                ' | ': first those that share words with the edit, then those it
                                                checks at that scope. The features that share most come first.
  listed\t<feature>                             lists a changed file, and cites no code the edit reaches
  blind\t<feature>                              lists a changed file and has no '# expects:' line with a step
  loose\t<file>: <scope>                        edited code that no recipe cites or reaches
  quiet\t<path>                                 a changed file no feature lists, with nothing reached from it
With --citations it prints `<feature>\t<file>: <name>\t<reason>` for each citation of a code file that names
no file of the checkouts, or a name that file does not hold. A change to such code can never select the feature.
A scope is the function, method, handler or block a line sits in. It is found by indentation, so it needs no
parser and works for every language whose blocks are indented. Uses are found by name, with `git grep`.
Shipped by create-project-verification-skill.
"""
import collections
import os
import pathlib
import re
import subprocess
import sys

MAX_USES, MAX_STEPS = 60, 3
CODE = set(""".ts .tsx .js .jsx .mjs .cjs .vue .svelte .py .java .kt .go .rb .php .cs .rs .swift .dart .c .cc .cpp .h
    .hpp .ino .ex .exs .scala .jsp .jspf .html .sql .sh""".split())
PROSE = (".md", ".txt", ".rst", ".lock", ".csv", ".svg", ".png", ".jpg", ".gif", ".pdf")
CONTROL = re.compile(r"^\s*[})\]]*\s*(?:if|else|elif|for|foreach|while|switch|try|catch|except|finally|do|with|return|when|match)\b")
CLOSING = re.compile(r"^\s*[{})\]]+[;,]?\s*(?:\{\s*)?$|^\s*[)\]}]|^\s*(?:public|private|protected)\s*:\s*$")
COMMENT = re.compile(r"^\s*(?://|#(?!define|include|if|else|endif)|\*|/\*|--|<!--)")
IMPORT = re.compile(r"^\s*(?:import\b|from\b.*\bimport\b|#include|using\b|require\b|package\b)")
CONTAINER = re.compile(r"\b(?:class|interface|struct|enum|namespace|object|module|impl|trait|record)\b")
TESTS = re.compile(r"(^|/)(tests?|__tests__|spec|e2e)/|[._-](test|spec)\.|Tests?\.[a-z]+$")
GENERIC_STEMS = {"index", "page", "route", "layout", "mod", "main", "__init__", "utils", "helpers", "types"}
COMMON = set("""the and for not its with that this from are was has have when then than into each only also both
    return const string null true false public privat static void import functi class else new value data name type
    list item""".split())
KEYWORDS = set("""if else for while switch case default try catch finally do return new await typeof sizeof function
    async const let var val def fn func class public private protected static final export import from void int
    long string boolean bool char double float this super null true false throw throws""".split())
USES = set("return await new throw else case typeof yield in of and or not if while for do".split())
DEFINITIONS = (
    re.compile(r"\b(?:function|def|fn|func|class|interface|struct|enum|trait|type|namespace|record)\s+\*?\s*([A-Za-z_$][\w$]*)"),
    re.compile(r"#define\s+([A-Za-z_]\w*)"),
    re.compile(r"\b(?:const|let|var|val|final|static)\b[^=(]*?([A-Za-z_$][\w$]*)\s*(?::[^=]+)?=(?!=)"),
)
CALL = re.compile(r"([A-Za-z_$][\w$]*(?:::[A-Za-z_~]\w*)*)\s*(?:<[^<>()]*>)?\s*\(")
STRING = re.compile(r"\"(?:[^\"\\]|\\.)*\"|'(?:[^'\\]|\\.)*'")
TEMPLATE = re.compile(r"`[^`]*`")
WORDS_ONLY = re.compile(r"^\s*[A-Za-z0-9'’-]+(?: [A-Za-z0-9'’-]+)+[.!?…]?\s*$")
MEMBER = re.compile(r"^\s*[\"']?([A-Za-z_$][\w$.-]*)[\"']?\s*[:=]")

skill = pathlib.Path(os.environ.get("VERIFY_SKILL") or pathlib.Path(__file__).resolve().parent.parent)
root = pathlib.Path(os.environ.get("VERIFY_ROOT") or skill.parents[2])


def app_roots():
    """Prefix of a recipe path -> the checkout it is in. A companion repo names app files '<app>/<path>'."""
    roots = {"": root}
    apps = skill / "apps"
    if apps.exists():
        for line in apps.read_text().split("\n"):
            if line.strip():
                name, path = line.split()
                variable = "APP_" + name.upper().replace("-", "_")
                roots[name + "/"] = pathlib.Path(os.environ.get(variable) or (root / path)).resolve()
    return roots


roots = app_roots()
texts = {}
depths = {}


def split(path):
    for prefix in sorted(roots, key=len, reverse=True):
        if prefix and path.startswith(prefix):
            return prefix, path[len(prefix):]
    return "", path


def read(prefix, path):
    if (prefix, path) not in texts:
        try:
            texts[prefix, path] = (roots[prefix] / path).read_text(errors="replace").split("\n")
        except OSError:
            texts[prefix, path] = []
    return texts[prefix, path]


def grep(option, word):
    """(prefix, output line) for each line `git grep` prints for the whole word, over every checkout."""
    for prefix, checkout in roots.items():
        found = subprocess.run(["git", "-C", str(checkout), "grep", "-I", option, "-w", "-F", "-e", word, "--", ".",
                                ":!.agents", ":!.claude"], capture_output=True, text=True).stdout
        for line in found.split("\n"):
            if line:
                yield prefix, line


def indent(text):
    expanded = text.expandtabs(4)
    return len(expanded) - len(expanded.lstrip())


def indents(lines):
    """The indentation of each line of a file, None for a blank line. Kept per file: enclosing() asks for it a lot."""
    if id(lines) not in depths:
        depths[id(lines)] = [indent(text) if text.strip() else None for text in lines]
    return depths[id(lines)]


def annotated(lines, at):
    """The declaration that the annotation or decorator on line `at` belongs to."""
    for after in range(at + 1, len(lines)):
        text = lines[after]
        if text.strip() and indent(text) <= indent(lines[at]) and not CLOSING.match(text) and not text.lstrip().startswith("@"):
            return after if indent(text) == indent(lines[at]) else at
    return at


def enclosing(lines, index):
    """The lines that enclose line `index`, innermost first: each is the nearest line above with less indentation."""
    depth = indents(lines)
    level = next((found for found in depth[index:] if found is not None), 0)
    result = []
    for at in range(index - 1, -1, -1):
        if not level:
            break
        if depth[at] is None or depth[at] >= level:
            continue
        text = lines[at]
        if CLOSING.match(text):
            level = depth[at] + 1
            continue
        level = depth[at]
        result.append(annotated(lines, at) if text.lstrip().startswith("@") else at)
    return result


def opens_block(lines, index):
    for after in range(index + 1, len(lines)):
        if lines[after].strip():
            return indent(lines[after]) > indent(lines[index])
    return False


def is_member(lines, index):
    """Whether a line sits at the top level or directly in a class body, where a name it defines is known outside."""
    around = [at for at in enclosing(lines, index) if not CONTROL.match(lines[at])]
    return not around or bool(CONTAINER.search(lines[around[0]]))


def signature(text):
    """The name a line declares the way a function or method signature does, or None for a call."""
    for found in CALL.finditer(text):
        name, before = found.group(1).split("::")[-1], text[:found.start()].strip()
        if name in KEYWORDS or text[:found.start()].endswith("."):
            continue
        if not before and re.fullmatch(r"[^()]*\([^()]*\)\s*(?::[^{;]*)?\{\s*", text[found.start():]):
            return name
        words = re.findall(r"[\w$]+", before)
        if re.search(r"[\w$>\]*&]$", before) and not (words and words[-1] in USES):
            return name
    return None


def defined_name(text, member=False):
    """The name a line defines, or None when it does not look like a definition."""
    if text.lstrip().startswith("<"):
        return None
    for pattern in DEFINITIONS:
        found = pattern.search(text)
        if found:
            return found.group(1)
    found = MEMBER.search(text) if member else None
    return signature(text) or (found.group(1) if found and found.group(1) not in KEYWORDS else None)


def defines(lines, index, name):
    """Whether a line is the definition of the name, not a use of it."""
    text = lines[index]
    if CONTROL.match(text):
        return False
    for pattern in DEFINITIONS:
        found = pattern.search(text)
        if found:
            return found.group(1) == name
    if not opens_block(lines, index) and not is_member(lines, index):
        return False
    key = MEMBER.match(text)
    return signature(text) == name or (bool(key) and key.group(1) == name)


def code_of(text):
    """A line without what only looks like code: quoted strings, the text of a template literal, a line of plain words."""
    if WORDS_ONLY.match(text):
        return ""
    return TEMPLATE.sub(lambda found: " ".join(re.findall(r"\$\{([^}]*)\}", found.group(0))), STRING.sub('""', text))


def names(name, text, literal):
    """Whether the text holds the name as a whole word, or as a quoted string when `literal`."""
    escaped = re.escape(name)
    pattern = r"[\"'`]" + escaped + r"[\"'`]" if literal else r"(?<![A-Za-z0-9_$])" + escaped + r"(?![A-Za-z0-9_$])"
    return re.search(pattern, text) is not None


def sources(cited):
    """(file, name) for each source of a citation such as `a.py: load, save; b.py: store`: a part without a file
    is another name in the file before it."""
    file = None
    for part in re.split(r"[,;]", cited):
        if ": " in part:
            file, part = part.split(": ", 1)
        name = re.sub(r"\(\)$", "", part.strip())
        if file and name:
            yield file.strip(), name


touches = collections.defaultdict(set)
cites = collections.defaultdict(lambda: collections.defaultdict(set))
behaviors = collections.defaultdict(list)
citations = []
for recipe in sorted((skill / "features").glob("*.sh")):
    for line in recipe.read_text(errors="replace").split("\n"):
        if line.startswith("# touches:"):
            for path in line[10:].split():
                touches[path].add(recipe.stem)
        found = re.search(r"\(([^()]*(?:\([^()]*\)[^()]*)*)\)\s*->(?! not driven)", line) if line.startswith("# expects:") else None
        if not found or ": " not in found.group(1):
            continue
        file_part, cited = found.group(1).split(": ", 1)
        cites[file_part.strip()][re.sub(r"\(\)$", "", cited.strip())].add(recipe.stem)
        for file, name in sources(found.group(1)):
            cites[file][name].add(recipe.stem)
        behaviors[recipe.stem].append((line[10:found.start()].strip(), pathlib.Path(file_part.strip()).name, cited.strip()))
        citations.append((recipe.stem, found.group(1)))


def cited_in(path):
    """name -> features, from the citations whose file part is this path or its end."""
    merged = collections.defaultdict(set)
    for file_part, by_name in cites.items():
        if path == file_part or path.endswith("/" + file_part):
            for name, features in by_name.items():
                merged[name] |= features
    return merged


def scope_of(lines, index, cited, edited_line):
    """(the innermost cited name around a line, the name of the definition the line is in); either can be None.
    An edited line counts as its own scope when it opens a block, and names a definition only as a member."""
    member = edited_line and is_member(lines, index)
    own = member or (edited_line and opens_block(lines, index))
    levels = [annotated(lines, index) if own and lines[index].lstrip().startswith("@") else index] + enclosing(lines, index)
    definition = None
    for position, at in enumerate(levels):
        text = lines[at]
        if COMMENT.match(text):
            continue
        # A statement names its scope only as the one string it dispatches on, such as `if (action.equals("get-info"))`.
        literal = bool(CONTROL.match(text)) or (position == 0 and not own)
        hits = [name for name in cited if names(name, text, literal)]
        if hits and not (literal and len(hits) > 1):
            return max(hits, key=len), None
        if literal or definition is not None or (position == 0 and not member):
            continue
        definition = False if CONTAINER.search(text) else defined_name(text, member=position == 0) or None
    return None, definition or None


def stems(text):
    """The words of a text, cut to six letters, so that `deleting` and `deletion` count as one. camelCase is split."""
    return {word.lower()[:6] for word in re.findall(r"[A-Z]?[a-z]{3,}|[A-Z]{3,}", text)} - COMMON


spread = collections.Counter(word for checked in behaviors.values() for word in set().union(*(stems(text) for text, _, _ in checked)))


def evidence(feature, file, user, words):
    """(minus how much the feature's behaviors share with the edit, up to four of them): the closest first, rare words
    weigh most. A behavior the feature checks at the caller `user` counts even when it shares no word."""
    scored = []
    for text, cited_file, cited_name in behaviors[feature]:
        score = sum(1 / spread[word] for word in stems(text) & words)
        at_user = cited_file == pathlib.Path(file).name and user in cited_name
        if score or at_user:
            scored.append((-score, not at_user, text[:170]))
    scored = sorted(set(scored))[:4]
    return (scored[0][0] if scored else 0), " | ".join(text for _, _, text in scored)


def label(path, name):
    return f"{pathlib.Path(path).name}: {name}"


def unmatched():
    """(feature, citation, reason) for each citation of a code file that the checkouts cannot match."""
    tracked = [(prefix, path) for prefix, checkout in roots.items()
               for path in subprocess.run(["git", "-C", str(checkout), "ls-files"], capture_output=True, text=True).stdout.split("\n") if path]
    def holds(file, name):
        files = [read(prefix, path) for prefix, path in tracked if prefix + path == file or (prefix + path).endswith("/" + file)]
        return "no such file" if not files else None if any(names(name, text, False) for lines in files for text in lines) else "the file has no such name"

    for feature, cited in citations:
        file, whole = (part.strip() for part in cited.split(": ", 1))
        if pathlib.Path(file).suffix not in CODE or TESTS.search(file) or not holds(file, re.sub(r"\(\)$", "", whole)):
            continue
        for file, name in sources(cited):
            if pathlib.Path(file).suffix in CODE and not TESTS.search(file) and holds(file, name):
                yield feature, f"{file}: {name}", holds(file, name)


if sys.argv[1:] == ["--citations"]:
    for found in unmatched():
        print(*found, sep="\t")
    sys.exit()


direct = collections.defaultdict(set)
closeness = collections.Counter()
callers = collections.defaultdict(list)
edited = {}
edit_words = collections.defaultdict(set)
reached = set()
changed_files = []
for line in pathlib.Path(sys.argv[1]).read_text().split("\n"):
    if not line.strip():
        continue
    listed_path, first, count = line.split("\t")
    prefix, path = split(listed_path)
    if listed_path not in changed_files:
        changed_files.append(listed_path)
    if path.endswith(PROSE) or TESTS.search(path):
        continue
    cited = cited_in(listed_path)
    if not cited and pathlib.Path(path).suffix not in CODE:
        continue
    lines = read(prefix, path)
    for index in range(int(first) - 1, min(int(first) - 1 + int(count), len(lines))):
        text = lines[index]
        if not text.strip() or COMMENT.match(text) or IMPORT.match(text):
            continue
        name, definition = scope_of(lines, index, cited, True)
        definition = name or definition
        key = (prefix, path, definition)
        if name:
            reached.add(key)
            for feature in cited[name]:
                direct[feature].add(label(path, name))
                closeness[feature] += sum(1 / spread[word] for checked, file, at in behaviors[feature]
                                          if file == pathlib.Path(path).name and name in at for word in stems(checked) & stems(text))
        if definition and pathlib.Path(path).suffix in CODE:
            edited.setdefault(key, label(path, definition))
            edit_words[key] |= stems(text) | stems(definition)

trail = dict(edited)
origin = {key: key for key in edited}
frontier = [(key, 1) for key in edited]
crowded = {}
naming = {}
while frontier:
    (prefix, path, name), steps = frontier.pop(0)
    here, source = trail[prefix, path, name], origin[prefix, path, name]
    stem = pathlib.Path(path).stem.split(".")[0]
    if stem in GENERIC_STEMS:
        stem = pathlib.Path(path).parent.name
    hits = []
    for other, found in grep("-n", name):
        file, _, rest = found.partition(":")
        number = rest.partition(":")[0]
        if number.isdigit() and pathlib.Path(file).suffix in CODE:
            hits.append((other, file, int(number) - 1))

    def near(found):
        """The hits in this file, or in a file that names it."""
        if stem not in naming:
            naming[stem] = set(grep("-l", stem))
        return [hit for hit in found if hit[:2] == (prefix, path) or hit[:2] in naming[stem]]

    # A name used all over, or defined in several files, is followed only into files that also name this file.
    if len(hits) > MAX_USES:
        hits = near(hits)
    uses, defined_in = [], set()
    for other, file, index in hits[:10 * MAX_USES]:
        lines = read(other, file)
        text = lines[index] if index < len(lines) else ""
        if not text or len(text) > 400 or COMMENT.match(text) or IMPORT.match(text) or text.lstrip().startswith("@"):
            continue
        if not names(name, code_of(text), False):
            continue
        if defines(lines, index, name):
            defined_in.add((other, file))
        else:
            uses.append((other, file, index))
    if defined_in - {(prefix, path)}:
        uses = near(uses)
    if len(uses) > MAX_USES:
        crowded[source] = f"{here} (used in {len(uses)} places, too many to follow)"
        continue
    for other, file, index in uses:
        lines, cited = read(other, file), cited_in(other + file)
        user, definition = scope_of(lines, index, cited, False)
        if TESTS.search(file) and not user:
            continue
        if user:
            reached.add(source)
            for feature in cited[user]:
                if TESTS.search(file) and steps == 1:
                    direct[feature].add(here)
                else:
                    callers[feature].append((steps, label(file, user), here, *evidence(feature, file, user, edit_words[source])))
            continue
        if definition is None and is_member(lines, index):
            definition = defined_name(lines[index], member=True) or (name if "export" in lines[index] else None)
        key = (other, file, definition)
        if definition and key not in trail and steps < MAX_STEPS:
            trail[key], origin[key] = f"{label(file, definition)} uses {here}", source
            frontier.append((key, steps + 1))

for feature, why in sorted(direct.items(), key=lambda item: (-closeness[item[0]], item[0])):
    print("direct", feature, ", ".join(sorted(why)), sep="\t")
shortest = {feature: min(found) for feature, found in callers.items() if feature not in direct}
for feature, (steps, user, path, _, checked) in sorted(shortest.items(), key=lambda item: (item[1][3], item[0])):
    print("caller", feature, user, path, checked, steps, sep="\t")
listing = {feature for path in changed_files for feature in touches.get(path, ())} - set(direct) - set(callers)
for feature in sorted(listing):
    print("listed" if behaviors[feature] else "blind", feature, sep="\t")
quiet = [path for path in changed_files if not touches.get(path) and not TESTS.search(path) and not path.endswith(PROSE)
         and not any(key[0] + key[1] == path for key in reached)]
for key, name in edited.items():
    if key not in reached and key[0] + key[1] not in quiet:
        print("loose", crowded.get(key, name), sep="\t")
for path in quiet:
    print("quiet", path, sep="\t")
