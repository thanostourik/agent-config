#!/usr/bin/env bash
# verify: drive this project's feature recipes. Shipped by create-project-verification-skill; never edit it in the project.
# verify up [--lanes N]     start or reuse the run's environment (launch.sh, then doctor.sh); --lanes N keeps exactly N extra copies for '# alone' features
# verify down               remove the run's environment and its lanes (cleanup.sh)
#                           the main copy runs the app on its dev server; VERIFY_APP=build at the first up runs the production build; lanes always run the production build
# verify affected [--dry]   drive the features a change against the default branch touches; --base <ref> picks another base; fails while the change adds entry points or actions no recipe covers
# verify all                drive every feature
# verify <feature>...       drive those features
# verify list | lint [feature...]
# verify uncovered [area]   entry points, actions (bin/actions.sh) and area expectation lines no recipe covers
# verify room               wait until the machine has room for one more browser session or process
# Options: --jobs N (default: the skill's jobs file, else the machine's cores), --deadline SECONDS per feature (default 180).
# Every verify on the machine shares one queue: a feature starts only while VERIFY_RESERVE percent of memory
# (default 20, or ~/.config/verify/reserve) stays free, with at least one feature running.
set -uo pipefail

skill=$(cd "$(dirname "$0")/.." && pwd)
root=$(cd "$skill/../../.." && pwd)
cache=$skill/.cache
max_jobs="" deadline=180 budget=45 base="" dry="" lanes=""

args=()
while (($#)); do
  case $1 in
    --jobs) max_jobs=${2:?--jobs needs a number}; shift 2 ;;
    --deadline) deadline=${2:?--deadline needs seconds}; shift 2 ;;
    --lanes) lanes=${2:?--lanes needs a number}; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
max_jobs=${max_jobs:-$(cat "$skill/jobs" 2> /dev/null || getconf _NPROCESSORS_ONLN 2> /dev/null || echo 8)}
[[ "$max_jobs$deadline" =~ ^[0-9]+$ && $max_jobs -gt 0 && $deadline -gt 0 ]] || { echo "verify: --jobs and --deadline take positive numbers" >&2; exit 2; }
command -v timeout > /dev/null || { echo "verify: needs GNU timeout (coreutils)" >&2; exit 2; }

app_variable() { echo "APP_$(tr 'a-z-' 'A-Z_' <<< "$1")"; }

export_apps() {
  local name path variable
  [[ -f "$skill/apps" ]] || return 0
  export GIT_OPTIONAL_LOCKS=0
  while read -r name path; do
    [[ -n "$name" ]] || continue
    variable=$(app_variable "$name")
    [[ -n "${!variable:-}" ]] || printf -v "$variable" '%s' "$(cd "$root" && cd "$path" 2> /dev/null && pwd)"
    [[ -n "${!variable}" ]] || { echo "verify: no checkout of $name at $path; set $variable to it" >&2; return 1; }
    export "${variable?}"
  done < "$skill/apps"
}

all_features() {
  local file
  for file in "$skill"/features/*.sh; do [[ -f "$file" ]] && basename "$file" .sh; done
}

summary_of() { sed -n '1s/^# *//p' "$skill/features/$1.sh"; }
touches_of() { sed -n 's/^# touches:[[:space:]]*//p' "$skill/features/$1.sh" | tr -s ' \t' '\n' | sed '/^$/d'; }

resolve() {
  local name=${1%%/*} variable
  if [[ -f "$skill/apps" ]] && grep -q "^$name[[:space:]]" "$skill/apps"; then
    variable=$(app_variable "$name")
    echo "${!variable}/${1#*/}"
  else
    echo "$root/$1"
  fi
}

default_branch() {
  local ref
  ref=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD) && { echo "$ref"; return; }
  for ref in main master; do
    git -C "$1" rev-parse -q --verify "$ref^{commit}" > /dev/null && { echo "$ref"; return; }
  done
  return 1
}

changed_in() {
  local dir=$1 ref merge
  ref=${base:-$(default_branch "$dir")} || { echo "verify: no default branch in $dir; pass --base <ref>" >&2; return 1; }
  merge=$(git -C "$dir" merge-base "$ref" HEAD 2> /dev/null) || { echo "verify: no merge base of $ref in $dir; pass --base <ref>" >&2; return 1; }
  { git -C "$dir" diff --name-only "$merge"; git -C "$dir" ls-files -o --exclude-standard; } | sort -u
}

changed_files() {
  local name path variable
  if [[ -f "$skill/apps" ]]; then
    while read -r name path; do
      [[ -n "$name" ]] || continue
      variable=$(app_variable "$name")
      changed_in "${!variable}" | sed "s|^|$name/|" || return 1
    done < "$skill/apps"
  fi
  changed_in "$root" || return 1
}

skill_rel=${skill#"$root"/}

names() { grep -q -E "(^|[^A-Za-z0-9_.-])$(sed 's/[.]/[.]/g' <<< "$1")([^A-Za-z0-9_.-]|$)" "${@:2}"; }

features_using() {
  local helpers=("$1") added=1 other name feature
  while ((added)); do
    added=0
    for other in "$skill"/bin/*; do
      name=$(basename "$other")
      [[ -f "$other" && " ${helpers[*]} verify lib.sh harvest " != *" $name "* ]] || continue
      for helper in "${helpers[@]}"; do
        names "$helper" "$other" && { helpers+=("$name"); added=1; break; }
      done
    done
  done
  for feature in $(all_features); do
    for helper in "${helpers[@]}"; do
      names "$helper" "$skill/features/$feature.sh" && { echo "$feature"; break; }
    done
  done
}

select_affected() {
  local file feature helper hit features=() untouched=()
  mapfile -t features < <(all_features)
  : > "$work/affected"
  : > "$work/new"
  changed_files > "$work/changed" || return 1
  while IFS= read -r file; do
    hit=""
    case $file in
      "$skill_rel"/features/*.sh)
        feature=$(basename "$file" .sh)
        [[ -f "$skill/features/$feature.sh" ]] && { echo "$feature	its recipe changed" >> "$work/affected"; hit=1; } ;;
      "$skill_rel"/bin/verify | "$skill_rel"/bin/lib.sh | "$skill_rel"/bin/harvest | "$skill_rel"/bin/areas) continue ;;
      "$skill_rel"/bin/*)
        helper=$(basename "$file")
        for feature in $(features_using "$helper"); do
          echo "$feature	uses $helper" >> "$work/affected"; hit=1
        done ;;
      .agents/* | .claude/* | "$skill_rel"/*) continue ;;
      *)
        for feature in "${features[@]}"; do
          touches_of "$feature" | grep -q -x -F "$file" && { echo "$feature	$file" >> "$work/affected"; hit=1; }
        done ;;
    esac
    [[ -n "$hit" ]] || untouched+=("$file")
  done < "$work/changed"
  if [[ -s "$work/affected" ]]; then
    echo "Selected:"
    sort -u "$work/affected" | awk -F '\t' '{ print "  " $1 ": " $2 }'
  else
    echo "Selected: none"
  fi
  if ((${#untouched[@]})); then
    echo "Changed files no feature names (if one changes behavior, drive that feature by name and add the file to its touches):"
    printf '  %s\n' "${untouched[@]}"
  fi
  [[ -x "$skill/bin/entrypoints.sh" ]] || return 0
  uncovered_items | awk -F '\t' 'FILENAME == ARGV[1] { changed[$0]; next } $1 != "expectation" && ($3 in changed)' "$work/changed" - > "$work/new"
  if [[ -s "$work/new" ]]; then
    echo "In changed files, covered by no recipe (give each a step and an '# expects:' line, or an '# expects:' line marked not driven):"
    awk -F '\t' '{ print "  " $1 ": " $2 " (" $3 ")" }' "$work/new"
  fi
}

lint() {
  local feature file path problems=0 other names
  mapfile -t names < <(all_features)
  for feature in "$@"; do
    file=$skill/features/$feature.sh
    [[ -f "$file" ]] || { echo "$feature: no features/$feature.sh"; problems=1; continue; }
    report() { echo "$feature: $1"; problems=1; }
    [[ "$(head -n 1 "$file")" == "# "?* ]] || report "line 1 is not a '# <summary>' comment"
    awk '!/^#/ { bad = /[^[:space:]]/; exit } END { exit bad }' "$file" || report "the '#' header lines must end with a blank line"
    case $feature in up | down | list | lint | uncovered | affected | all | help) report "'$feature' is a verify command; rename the feature" ;; esac
    for other in "${names[@]}"; do
      [[ "$other" == "$feature"-* ]] && report "its name starts '$other': cleanup by 'verify-$feature-' would delete that feature's data; rename one"
    done
    grep -q -E '^# touches:[[:space:]]*[^[:space:]]' "$file" || report "no '# touches:' line naming the feature's source files"
    while IFS= read -r path; do
      [[ "$path" == */ || "$path" == *[*?]* ]] && { report "touches '$path': name files, not folders or globs"; continue; }
      [[ -e "$(resolve "$path")" ]] || report "touches '$path', which does not exist"
    done < <(touches_of "$feature")
    grep -q -E '^# alone[[:space:]]*$' "$file" && report "'# alone' needs its reason: '# alone: <the shared state it changes>'"
    grep -q '^step ' "$file" || report "no step"
    grep -n '^step ' "$file" | grep -v -E '^[0-9]+:step "[^"]*" "[^"]+"' | sed "s/^\([0-9]*\):.*/$feature: step on line \1 has no sentence of what it proves (step \"<label>\" \"<action and expected result>\")/" | grep . && problems=1
    if [[ -f "$cache/expect/$feature.txt" ]]; then
      while IFS= read -r source; do
        grep -q -F -- "$source" <(grep '^# expects:' "$file") || report "expects no line citing ($source) from .cache/expect/$feature.txt"
      done < <(sed -n 's/^- \([^ ][^:]*: [^ ].*\)$/\1/p' "$cache/expect/$feature.txt")
    fi
    while IFS= read -r problem; do report "$problem"; done < <(check_expects "$file")
    grep -n -E '(^|[^A-Za-z0-9_./-])sleep([[:space:]]|$)' "$file" | sed "s/^/$feature: bare sleep, use wait_for: line /" | grep . && problems=1
    grep -n 'waitForTimeout(' "$file" | sed "s/^/$feature: waitForTimeout, wait for the state instead: line /" | grep . && problems=1
    awk -v f="$feature" '/(#|\/\/) slow: *[^ ]/ { next }
      { line = $0; while (match(line, /wait_for[ \t]+[0-9]+|timeout: *[0-9]+/)) { n = substr(line, RSTART, RLENGTH); gsub(/[^0-9]/, "", n); n += 0
          if ((n > 10 && n < 1000) || n > 10000) { print f ": line " NR " waits over 10 s; a simple action that takes longer is a finding, a slow job says why with \"# slow: <reason>\" or \"// slow: <reason>\" on that line"; break }
          line = substr(line, RSTART + RLENGTH) } }' "$file" | grep . && problems=1
    grep -n -E '^step "[^"]*, ' "$file" | sed "s/^/$feature: a step label with ', ' breaks '# expects:' lines: line /" | grep . && problems=1
    bash -n "$file" 2> /dev/null || report "not valid bash: $(bash -n "$file" 2>&1 | head -n 1)"
  done
  return $problems
}

check_expects() {
  awk '
    /^step "/ { label = $0; sub(/^step "/, "", label); sub(/".*$/, "", label); steps[label] }
    /^# expects:/ { line = substr($0, 12); expects[++n] = line }
    END {
      for (i = 1; i <= n; i++) {
        line = expects[i]; at = index(line, " -> ")
        if (!at) { print "expects line has no \" -> \": " line; continue }
        target = substr(line, at + 4)
        if (target ~ /^not driven:[[:space:]]*[^[:space:]]/) continue
        if (target ~ /^not driven/) { print "expects line says not driven without a reason: " line; continue }
        k = split(target, labels, /, /)
        for (j = 1; j <= k; j++) if (!(labels[j] in steps)) print "expects line names step \"" labels[j] "\", which the recipe does not have"
      }
    }
  ' "$1"
}

covers_of() { sed -n 's/^# covers:[[:space:]]*//p' "$skill/features/$1.sh" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d'; }

doctor() {
  [[ -x "$skill/bin/doctor.sh" ]] || return 0
  "$skill/bin/doctor.sh" > "$1" 2>&1 < /dev/null && return
  sleep 5
  "$skill/bin/doctor.sh" > "$1" 2>&1 < /dev/null
}

header() { sed -n "s/^# $2:[[:space:]]*//p" "$skill/features/$1.sh"; }

uncovered_items() {
  local feature list name source
  "$skill/bin/entrypoints.sh" | sort -u > "$work/entrypoints"
  if grep -q $'\t' "$work/entrypoints"; then
    for feature in $(all_features); do covers_of "$feature"; done | sort -u > "$work/covered"
    awk -F '\t' 'FILENAME == ARGV[1] { covered[$0]; next } !($1 in covered) { print "entry point\t" $1 "\t" $2 }' "$work/covered" "$work/entrypoints"
  else
    for feature in $(all_features); do touches_of "$feature"; done | sort -u > "$work/covered"
    comm -23 "$work/entrypoints" "$work/covered" | awk '{ print "entry point\t" $0 "\t" $0 }'
  fi
  if [[ -x "$skill/bin/actions.sh" ]]; then
    for feature in $(all_features); do header "$feature" expects; done > "$work/cited"
    "$skill/bin/actions.sh" | sort -u | awk -F '\t' '
      FILENAME == ARGV[1] { cited[++n] = $0; next }
      {
        base = $2; sub(/.*\//, "", base); word = "(^|[^A-Za-z0-9_$])" $1 "([^A-Za-z0-9_$]|$)"
        for (i = 1; i <= n; i++) if (index(cited[i], base) && cited[i] ~ word) next
        print "action\t" $1 "\t" $2
      }' "$work/cited" -
  fi
  for list in "$cache"/expect/*.txt; do
    [[ -f "$list" ]] || continue
    name=$(basename "$list" .txt)
    [[ -f "$skill/features/$name.sh" ]] && continue
    cat "$skill/features/$name"-*.sh 2> /dev/null | grep '^# expects:' > "$work/cited"
    sed -n 's/^- \([^ ][^:]*: [^ ].*\)$/\1/p' "$list" | while IFS= read -r source; do
      grep -q -F -- "$source" "$work/cited" || printf 'expectation\t%s\t%s\n' "$source" "$name"
    done
  done
}

area_files() { sed -n "s/^\(split: \)\{0,1\}$1: .*; files: //p" "$cache/areas.txt" 2> /dev/null | tr ' ' '\n'; }

lane_count() { cat "$cache/lanes" 2> /dev/null || echo 0; }
lane_id() { if (($1 == 0)); then cat "$cache/run-id"; else echo "$(cat "$cache/run-id")-l$1"; fi; }

# Next.js and others refuse a second dev server in one checkout, so only the main copy runs one.
app_mode() { if (($1 == 0)); then cat "$cache/app-mode" 2> /dev/null || echo dev; else echo build; fi; }

on_lane() {
  local lane=$1
  shift
  VERIFY_LANE=$lane VERIFY_RUN_ID=$(lane_id "$lane") VERIFY_APP=$(app_mode "$lane") "$@"
}

held() { [[ -d "$cache/drive/.lock-$1" ]] && kill -0 "$(cat "$cache/drive/.lock-$1/pid" 2> /dev/null)" 2> /dev/null; }

room_pool=${XDG_RUNTIME_DIR:-/tmp/verify-$UID}/verify-room
browser_mb=500

reserve_percent() {
  local percent=${VERIFY_RESERVE:-$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/verify/reserve" 2> /dev/null)}
  [[ "$percent" =~ ^[0-9]+$ ]] && ((percent < 100)) && echo "$percent" || echo 20
}

meminfo() { awk -v key="$1:" '$1 == key { print int($2 / 1024) }' /proc/meminfo; }

can_queue() { [[ -r /proc/meminfo ]] && command -v flock > /dev/null; }

reserve_mb() { echo $(($(meminfo MemTotal) * $(reserve_percent) / 100)); }

# Runs under the pool's lock. A slot started in the last 20 s has not shown up in MemAvailable yet, so each counts a browser's worth.
admit() {
  local holder=$1 entry started pid recent=0 running=0
  for entry in "$room_pool"/wait-*; do
    [[ -f "$entry" ]] && ! kill -0 "${entry##*/wait-}" 2> /dev/null && rm -f "$entry"
  done
  for entry in "$room_pool"/slot-*; do
    read -r started pid 2> /dev/null < "$entry" || continue
    if kill -0 "$pid" 2> /dev/null; then
      running=$((running + 1))
    elif ((started < EPOCHSECONDS - 20)); then
      rm -f "$entry"
      continue
    fi
    ((started >= EPOCHSECONDS - 20)) && recent=$((recent + 1))
  done
  if ((running + recent)); then
    (($(meminfo MemAvailable) - (recent + 1) * browser_mb >= $(reserve_mb))) || return 1
  fi
  echo "$EPOCHSECONDS $holder" > "$room_pool/slot-$holder"
}

# Every verify on the machine shares this copy's lock: an '# alone' feature holds it alone; other features and doctor share it.
hold_copy() {
  command -v flock > /dev/null || return 0
  local wanted=$cache/drive/.copy-$VERIFY_RUN_ID.wanted
  exec 7> "$cache/drive/.copy-$VERIFY_RUN_ID"
  if [[ "$1" == alone ]]; then
    echo "$BASHPID" > "$wanted"
    flock -x 7
    rm -f "$wanted"
  else
    while [[ -f "$wanted" ]] && kill -0 "$(cat "$wanted" 2> /dev/null)" 2> /dev/null; do sleep 1; done
    flock -s 7
  fi
}

take_room() {
  local holder=$1
  can_queue || return 0
  mkdir -p "$room_pool"
  : > "$room_pool/wait-$holder"
  until (flock 9 && admit "$holder") 9> "$room_pool/.lock"; do sleep 1; done
  rm -f "$room_pool/wait-$holder"
}

others_running() {
  local lock
  for lock in "$cache"/drive/.lock-*; do
    [[ "$lock" == "$cache/drive/.lock-$1" ]] && continue
    held "${lock##*/.lock-}" && return 0
  done
  return 1
}

take_lock() {
  local lock=$cache/drive/.lock-$1 until=$((SECONDS + 2 * deadline))
  until mkdir "$lock" 2> /dev/null; do
    if ! held "$1"; then rm -rf "$lock"; continue; fi
    ((SECONDS < until)) || return 1
    sleep 1
  done
  echo "$BASHPID" > "$lock/pid"
}

run_feature() {
  local lane=$2
  export VERIFY_LANE=$lane VERIFY_RUN_ID=$(lane_id "$lane") VERIFY_APP=$(app_mode "$lane")
  local feature=$1 dir=$cache/drive/$1 start=$SECONDS status limit
  limit=$(header "$feature" deadline)
  limit=${limit:-$deadline}
  mkdir -p "$cache/drive"
  take_lock "$feature" || { mkdir -p "$dir"; echo "another verify kept $feature busy too long" > "$dir/error"; echo 1 > "$dir/status"; echo 0 > "$dir/seconds"; echo 1 > "$dir/deadline"; return; }
  start=$SECONDS
  hold_copy "$(grep -q '^# alone' "$skill/features/$feature.sh" && echo alone)"
  take_room "$BASHPID"
  local waited=$((SECONDS - start))
  start=$SECONDS
  rm -rf "$dir" "$cache/evidence/$feature"
  mkdir -p "$dir" "$cache/evidence/$feature"
  echo "$limit" > "$dir/deadline"
  echo "$waited" > "$dir/waited"
  VERIFY_RUNNER=$$ VERIFY_FEATURE=$feature VERIFY_SESSION=$feature VERIFY_DIR=$dir EVIDENCE=$cache/evidence/$feature \
    timeout -k 30 "$limit" bash "$skill/bin/lib.sh" "$skill/features/$feature.sh" > "$dir/log" 2>&1 < /dev/null 7>&-
  status=$?
  rm -f "$room_pool/slot-$BASHPID"
  echo $((SECONDS - start)) > "$dir/seconds"
  echo "$status" > "$dir/status"
  line_of "$feature" > "$run/line-$feature"
  echo $? > "$run/rc-$feature"
  rm -rf "$cache/drive/.lock-$feature"
  if ((status)) && [[ ! -e "$run/stop" ]] && ! doctor "$run/doctor.log"; then
    echo "$feature" > "$run/stop"
    cp "$run/doctor.log" "$cache/doctor-failed.log"
  fi
  exec 7>&-
}

line_of() {
  local feature=$1 dir=$cache/drive/$1 step="" result="" status seconds known
  status=$(cat "$dir/status") seconds=$(cat "$dir/seconds")
  [[ -e "$dir/step" ]] && step=$(cat "$dir/step")
  [[ -e "$dir/result" ]] && result=$(head -n 1 "$dir/result")
  local tail="" intent=""
  grep -q -x cleanup-failed "$dir/result" 2> /dev/null && tail="; clean up failed"
  [[ -s "$dir/intent" ]] && intent=" ($(head -c 160 "$dir/intent"))"
  if ((status == 0)) && [[ "$result" == pass ]]; then
    local slow="" step_slow
    ((seconds > budget)) && slow=", slow: over ${budget}s, split or speed it up"
    step_slow=$(awk '/^== / && match($0, /\(([0-9]+)s\)$/) { t = substr($0, RSTART + 1, RLENGTH - 3) + 0; if (label != "" && t - start > 10) { out = out sep "\"" label "\" " (t - start) "s"; sep = ", " }; label = ($0 ~ /^== Clean up/) ? "" : substr($0, 4, index($0, ":") - 4); start = t } END { printf "%s", out }' "$dir/log" 2> /dev/null)
    [[ -n "$step_slow" ]] && slow+=", steps over 10 s: $step_slow"
    echo "$feature: pass (${seconds}s$slow)$tail"
    [[ -z "$tail" ]]
    return
  elif ((status == 124 || status == 137)) && ((seconds >= $(cat "$dir/deadline"))); then
    echo "$feature: timeout after ${seconds}s at \"$step\" ($dir/log)$tail"
  else
    known=""
    header "$feature" "known failure" | grep -q -x -F "$step" && known=" (known failure)"
    local command said
    command=$(head -n 1 "$dir/error" 2> /dev/null | cut -c 1-120)
    said=$(sed '/^== Clean up/,$d' "$dir/log" | grep -v -e '^== ' -e '^[[:space:]]*$' | tail -n 1 | cut -c 1-200)
    echo "$feature: fail at \"$step\"$intent$known: ${command:-?} -> ${said:-no output} (${seconds}s, $dir/log)$tail"
  fi
  return 1
}

drive() {
  local feature together=() alone=() pids=() started=$SECONDS result=0 lane count
  (($#)) || { echo "verify: no features to drive" >&2; return 2; }
  [[ -f "$cache/run-id" ]] || { echo "verify: no environment; run 'bin/verify up' first" >&2; return 2; }
  export VERIFY_RUN_ID=$(cat "$cache/run-id") VERIFY_LANE=0 VERIFY_APP=$(app_mode 0)
  count=$(lane_count)
  run=$cache/drive/.run-$$
  mkdir -p "$run"
  lint "$@" > "$run/lint.txt" || { cat "$run/lint.txt" >&2; echo "verify: fix the recipes above first" >&2; rm -rf "$run"; return 2; }
  hold_copy shared
  doctor "$run/doctor.log" || { exec 7>&-; cp "$run/doctor.log" "$cache/doctor-failed.log"; echo "verify: doctor.sh failed, see $cache/doctor-failed.log" >&2; return 2; }
  exec 7>&-
  for feature in "$@"; do
    if grep -q '^# alone' "$skill/features/$feature.sh"; then alone+=("$feature"); else together+=("$feature"); fi
  done
  local alone_seconds=0 lane_jobs=0
  if ((${#alone[@]})); then
    mapfile -t alone < <(for feature in "${alone[@]}"; do echo "$(cat "$cache/drive/$feature/seconds" 2> /dev/null || echo 30) $feature"; done | sort -rn | tee "$run/alone" | cut -d' ' -f2)
    alone_seconds=$(awk '{ total += $1 } END { print total }' "$run/alone")
  fi
  for feature in "$@"; do held "$feature" || rm -rf "${cache:?}/drive/$feature"; done
  trap 'for pid in "${pids[@]}"; do pkill -TERM -P "$pid"; done; wait; exit 130' INT TERM
  run_lane() {
    local lane=$1 feature
    for feature in "${alone[@]}"; do
      [[ -e "$run/stop" ]] && break
      mkdir "$run/claim-$feature" 2> /dev/null || continue
      run_feature "$feature" "$lane"
    done
  }
  start_lane() {
    local lane=$1 began=$SECONDS
    if on_lane "$lane" "$skill/bin/launch.sh" > "$cache/launch-$lane.log" 2>&1 < /dev/null && on_lane "$lane" doctor "$cache/doctor-$lane.log"; then
      echo $((SECONDS - began)) > "$cache/lane-seconds"
      run_lane "$lane"
    else
      echo "$lane" > "$run/lane-failed-$lane"
      on_lane "$lane" "$skill/bin/cleanup.sh" > /dev/null 2>&1 < /dev/null
      (flock 8 && (($(lane_count) == lane)) && echo $((lane - 1)) > "$cache/lanes") 8> "$cache/.lanes-lock"
    fi
  }
  # A lane pays off only when the '# alone' work is well over the time a copy takes to start, and only while the copy fits beside the reserve.
  add_lanes() {
    local most launch stack want lane
    can_queue && stack=$(cat "$cache/stack-mb" 2> /dev/null) || return 0
    most=$(cat "$skill/lanes" 2> /dev/null || echo 0)
    launch=$(cat "$cache/lane-seconds" 2> /dev/null || echo 120)
    ((launch > 0)) || launch=1
    want=$((alone_seconds / (2 * launch)))
    ((want > most)) && want=$most
    ((want > ${#alone[@]} - 1)) && want=$((${#alone[@]} - 1))
    for ((lane = count + 1; lane <= want; lane++)); do
      (($(meminfo MemAvailable) - (lane - count) * stack >= $(reserve_mb))) || break
      (flock 8 && (($(lane_count) == lane - 1)) && echo "$lane" > "$cache/lanes") 8> "$cache/.lanes-lock" || break
      start_lane "$lane" &
      pids+=($!)
      lane_jobs=$((lane_jobs + 1))
    done
  }
  for ((lane = 1; lane <= count; lane++)); do run_lane "$lane" & pids+=($!); done
  add_lanes
  local together_pids=()
  for feature in "${together[@]}"; do
    while (($(jobs -rp | wc -l) >= max_jobs + count + lane_jobs)); do wait -n; done
    [[ -e "$run/stop" ]] && break
    run_feature "$feature" 0 &
    pids+=($!) together_pids+=($!)
  done
  for pid in "${together_pids[@]}"; do wait "$pid"; done
  run_lane 0 &
  pids+=($!)
  wait
  trap - INT TERM
  local waited=0
  for feature in "$@"; do waited=$((waited + $(cat "$cache/drive/$feature/waited" 2> /dev/null || echo 0))); done
  echo
  echo "Summary ($((SECONDS - started))s, $# features$( ((waited)) && echo ", ${waited}s of feature runs waiting for room on the machine"))"
  for lane in "$run"/lane-failed-*; do
    [[ -f "$lane" ]] && echo "lane $(cat "$lane") did not start; its features ran on the main copy (see $cache/launch-$(cat "$lane").log)"
  done
  for feature in "$@"; do
    if [[ -f "$run/line-$feature" ]]; then
      cat "$run/line-$feature"
      (($(cat "$run/rc-$feature") == 0)) || grep -q '(known failure)' "$run/line-$feature" || result=1
    elif [[ -s "$run/stop" ]]; then
      echo "$feature: not run (doctor.sh failed after $(cat "$run/stop"), see $cache/doctor-failed.log)"
      result=1
    else
      echo "$feature: not run"
      result=1
    fi
  done
  local driven=0 skipped=0
  for feature in "$@"; do
    driven=$((driven + $(grep -c '^# expects:' "$skill/features/$feature.sh")))
    skipped=$((skipped + $(grep -c -E '^# expects:.* -> not driven' "$skill/features/$feature.sh")))
  done
  echo "Expectations: $((driven - skipped)) checked by a step, $skipped not driven"
  echo "Evidence: $cache/evidence/<feature>/"
  [[ -e "$run/stop" ]] || rm -rf "$run"
  return $result
}

cd "$root"
mkdir -p "$cache"
work=$(mktemp -d "$cache/work.XXXXXX")
trap 'rm -rf "$work"' EXIT
export VERIFY_SKILL=$skill VERIFY_ROOT=$root
export_apps || exit 2
command=${1:-}
[[ $# -gt 0 ]] && shift

case $command in
  up)
    [[ -f "$cache/run-id" ]] || { echo "verify-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')" > "$cache/run-id"; : > "$cache/run-id.unmeasured"; echo "${VERIFY_APP:-dev}" > "$cache/app-mode"; }
    previous=$(lane_count)
    echo "${lanes:-$previous}" > "$cache/lanes"
    for ((lane = previous; lane > $(lane_count); lane--)); do
      on_lane "$lane" "$skill/bin/cleanup.sh" || { echo "verify: cleanup.sh failed for lane $lane" >&2; exit 1; }
    done
    count=$(lane_count) failed=0
    [[ -r /proc/meminfo ]] && before=$(meminfo MemAvailable)
    began=$SECONDS
    if ((count == 0)); then
      on_lane 0 "$skill/bin/launch.sh" "$@" || failed=1
    else
      for ((lane = 0; lane <= count; lane++)); do
        on_lane "$lane" "$skill/bin/launch.sh" "$@" > "$cache/launch-$lane.log" 2>&1 &
      done
      for ((lane = 0; lane <= count; lane++)); do wait -n || failed=1; done
      ((failed == 0)) || tail -n 20 "$cache"/launch-*.log >&2
    fi
    ((failed == 0)) || { echo "verify: launch.sh failed; run 'bin/verify down' to remove what it started" >&2; exit 1; }
    for ((lane = 0; lane <= count; lane++)); do
      on_lane "$lane" doctor "$cache/doctor-$lane.log" || { echo "verify: doctor.sh failed after launch on lane $lane, see $cache/doctor-$lane.log" >&2; exit 1; }
    done
    if [[ -f "$cache/run-id.unmeasured" && -n "${before:-}" ]]; then
      used=$(((before - $(meminfo MemAvailable)) / (count + 1)))
      ((used > 0)) && echo "$used" > "$cache/stack-mb"
      echo $((SECONDS - began)) > "$cache/lane-seconds"
      rm -f "$cache/run-id.unmeasured"
    fi
    echo "up: $(cat "$cache/run-id")$( ((count)) && echo " and $count lanes")" ;;
  down)
    if others_running ""; then
      echo "verify: features are still running ($(for lock in "$cache"/drive/.lock-*; do held "${lock##*/.lock-}" && printf '%s ' "${lock##*/.lock-}"; done)); run 'down' again once they finish" >&2
      exit 2
    fi
    count=$(lane_count) failed=0
    if [[ -f "$cache/run-id" ]]; then
      for ((lane = count; lane >= 0; lane--)); do on_lane "$lane" "$skill/bin/cleanup.sh" "$@" || failed=1; done
    else
      "$skill/bin/cleanup.sh" "$@" || failed=1
    fi
    ((failed == 0)) || { echo "verify: cleanup.sh failed; the run's record stays in $cache" >&2; exit 1; }
    rm -f "$cache/run-id" "$cache/run-id.unmeasured" "$cache/lanes" "$cache/app-mode"
    echo "down" ;;
  room)
    take_room "$$" ;;
  list)
    for feature in $(all_features); do printf '%s: %s\n' "$feature" "$(summary_of "$feature")"; done ;;
  lint)
    (($#)) || set -- $(all_features)
    lint "$@" && echo "lint: ok" ;;
  uncovered)
    [[ -x "$skill/bin/entrypoints.sh" ]] || { echo "verify: no bin/entrypoints.sh" >&2; exit 2; }
    uncovered_items > "$work/uncovered"
    if (($#)); then
      area_files "$1" > "$work/area-files"
      [[ -s "$work/area-files" ]] || { echo "verify: no area '$1' with files in .cache/areas.txt" >&2; exit 2; }
      awk -F '\t' -v area="$1" 'FILENAME == ARGV[1] { mine[$0]; next } ($1 == "expectation" ? $3 == area : $3 in mine)' "$work/area-files" "$work/uncovered" > "$work/uncovered-area"
      mv "$work/uncovered-area" "$work/uncovered"
      total=$(awk -F '\t' 'FILENAME == ARGV[1] { mine[$0]; next } ($NF in mine)' "$work/area-files" "$work/entrypoints" | wc -l)
    else
      total=$(wc -l < "$work/entrypoints")
    fi
    missing=$(grep -c '^entry point' "$work/uncovered")
    echo "Entry points covered: $((total - missing)) of $total"
    [[ -s "$work/uncovered" ]] && {
      echo "Not covered (give each a step and an '# expects:' line, or an '# expects:' line marked not driven):"
      awk -F '\t' '{ print "  " $1 ": " $2 " (" $3 ")" }' "$work/uncovered"
    }
    exit 0 ;;
  affected)
    while (($#)); do
      case $1 in
        --dry) dry=1; shift ;;
        --base) base=${2:?--base needs a ref}; shift 2 ;;
        *) echo "verify: affected takes --dry and --base <ref>" >&2; exit 2 ;;
      esac
    done
    select_affected || exit 2
    result=0
    [[ -s "$work/affected" && -z "$dry" ]] && { drive $(cut -f1 "$work/affected" | sort -u); result=$?; }
    [[ -s "$work/new" ]] && { echo "verify: the change adds entry points or actions no recipe covers (listed above)" >&2; ((result)) || result=1; }
    exit $result ;;
  all)
    drive $(all_features) ;;
  "" | -h | help)
    sed -n '2,13s/^# \{0,1\}//p' "$0" ;;
  *)
    for feature in "$command" "$@"; do
      [[ -f "$skill/features/$feature.sh" ]] || { echo "verify: no features/$feature.sh (verify list shows the features)" >&2; exit 2; }
    done
    drive "$command" "$@" ;;
esac
