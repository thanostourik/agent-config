#!/usr/bin/env bash
# verify: drive this project's feature recipes. Shipped by create-project-verification-skill; never edit it in the project.
# verify up [--lanes N]     start or reuse the run's environment (launch.sh, then doctor.sh), plus N extra copies for '# alone' features
# verify down               remove the run's environment and its lanes (cleanup.sh)
# verify affected [--dry]   drive the features a change against the default branch touches; --base <ref> picks another base
# verify all                drive every feature
# verify <feature>...       drive those features
# verify list | lint [feature...] | uncovered
# Options: --jobs N (default 8), --deadline SECONDS per feature (default 180).
set -uo pipefail

skill=$(cd "$(dirname "$0")/.." && pwd)
root=$(cd "$skill/../../.." && pwd)
cache=$skill/.cache
max_jobs=8 deadline=180 base="" dry="" lanes=""

args=()
while (($#)); do
  case $1 in
    --jobs) max_jobs=${2:?--jobs needs a number}; shift 2 ;;
    --deadline) deadline=${2:?--deadline needs seconds}; shift 2 ;;
    --lanes) lanes=${2:?--lanes needs a number}; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
[[ "$max_jobs$deadline" =~ ^[0-9]+$ && $max_jobs -gt 0 && $deadline -gt 0 ]] || { echo "verify: --jobs and --deadline take positive numbers" >&2; exit 2; }
command -v timeout > /dev/null || { echo "verify: needs GNU timeout (coreutils)" >&2; exit 2; }

app_variable() { echo "APP_$(tr 'a-z-' 'A-Z_' <<< "$1")"; }

export_apps() {
  local name path variable
  [[ -f "$skill/apps" ]] || return 0
  export GIT_OPTIONAL_LOCKS=0
  while read -r name path; do
    [[ -n "$name" ]] || continue
    variable=$(app_variable "$name")
    [[ -n "${!variable:-}" ]] || printf -v "$variable" '%s' "$(cd "$root" && cd "$path" 2> /dev/null && pwd)"
    [[ -n "${!variable}" ]] || { echo "verify: no checkout of $name at $path; set $variable to it" >&2; return 1; }
    export "${variable?}"
  done < "$skill/apps"
}

all_features() {
  local file
  for file in "$skill"/features/*.sh; do [[ -f "$file" ]] && basename "$file" .sh; done
}

summary_of() { sed -n '1s/^# *//p' "$skill/features/$1.sh"; }
touches_of() { sed -n 's/^# touches:[[:space:]]*//p' "$skill/features/$1.sh" | tr -s ' \t' '\n' | sed '/^$/d'; }

resolve() {
  local name=${1%%/*} variable
  if [[ -f "$skill/apps" ]] && grep -q "^$name[[:space:]]" "$skill/apps"; then
    variable=$(app_variable "$name")
    echo "${!variable}/${1#*/}"
  else
    echo "$root/$1"
  fi
}

default_branch() {
  local ref
  ref=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD) && { echo "$ref"; return; }
  for ref in main master; do
    git -C "$1" rev-parse -q --verify "$ref^{commit}" > /dev/null && { echo "$ref"; return; }
  done
  return 1
}

changed_in() {
  local dir=$1 ref merge
  ref=${base:-$(default_branch "$dir")} || { echo "verify: no default branch in $dir; pass --base <ref>" >&2; return 1; }
  merge=$(git -C "$dir" merge-base "$ref" HEAD 2> /dev/null) || { echo "verify: no merge base of $ref in $dir; pass --base <ref>" >&2; return 1; }
  { git -C "$dir" diff --name-only "$merge"; git -C "$dir" ls-files -o --exclude-standard; } | sort -u
}

changed_files() {
  local name path variable
  if [[ -f "$skill/apps" ]]; then
    while read -r name path; do
      [[ -n "$name" ]] || continue
      variable=$(app_variable "$name")
      changed_in "${!variable}" | sed "s|^|$name/|" || return 1
    done < "$skill/apps"
  fi
  changed_in "$root" || return 1
}

skill_rel=${skill#"$root"/}

names() { grep -q -E "(^|[^A-Za-z0-9_.-])$(sed 's/[.]/[.]/g' <<< "$1")([^A-Za-z0-9_.-]|$)" "${@:2}"; }

features_using() {
  local helpers=("$1") added=1 other name feature
  while ((added)); do
    added=0
    for other in "$skill"/bin/*; do
      name=$(basename "$other")
      [[ -f "$other" && " ${helpers[*]} verify lib.sh " != *" $name "* ]] || continue
      for helper in "${helpers[@]}"; do
        names "$helper" "$other" && { helpers+=("$name"); added=1; break; }
      done
    done
  done
  for feature in $(all_features); do
    for helper in "${helpers[@]}"; do
      names "$helper" "$skill/features/$feature.sh" && { echo "$feature"; break; }
    done
  done
}

select_affected() {
  local file feature helper hit features=() untouched=()
  mapfile -t features < <(all_features)
  : > "$cache/affected"
  changed_files > "$cache/changed" || return 1
  while IFS= read -r file; do
    hit=""
    case $file in
      "$skill_rel"/features/*.sh)
        feature=$(basename "$file" .sh)
        [[ -f "$skill/features/$feature.sh" ]] && { echo "$feature	its recipe changed" >> "$cache/affected"; hit=1; } ;;
      "$skill_rel"/bin/verify | "$skill_rel"/bin/lib.sh) continue ;;
      "$skill_rel"/bin/*)
        helper=$(basename "$file")
        for feature in $(features_using "$helper"); do
          echo "$feature	uses $helper" >> "$cache/affected"; hit=1
        done ;;
      .agents/* | .claude/* | "$skill_rel"/*) continue ;;
      *)
        for feature in "${features[@]}"; do
          touches_of "$feature" | grep -q -x -F "$file" && { echo "$feature	$file" >> "$cache/affected"; hit=1; }
        done ;;
    esac
    [[ -n "$hit" ]] || untouched+=("$file")
  done < "$cache/changed"
  if [[ -s "$cache/affected" ]]; then
    echo "Selected:"
    sort -u "$cache/affected" | awk -F '\t' '{ print "  " $1 ": " $2 }'
  else
    echo "Selected: none"
  fi
  if ((${#untouched[@]})); then
    echo "Changed files no feature names (if one changes behavior, drive that feature by name and add the file to its touches):"
    printf '  %s\n' "${untouched[@]}"
  fi
}

lint() {
  local feature file path problems=0
  for feature in "$@"; do
    file=$skill/features/$feature.sh
    [[ -f "$file" ]] || { echo "$feature: no features/$feature.sh"; problems=1; continue; }
    report() { echo "$feature: $1"; problems=1; }
    [[ "$(head -n 1 "$file")" == "# "?* ]] || report "line 1 is not a '# <summary>' comment"
    awk '!/^#/ { bad = /[^[:space:]]/; exit } END { exit bad }' "$file" || report "the '#' header lines must end with a blank line"
    case $feature in up | down | list | lint | uncovered | affected | all | help) report "'$feature' is a verify command; rename the feature" ;; esac
    grep -q -E '^# touches:[[:space:]]*[^[:space:]]' "$file" || report "no '# touches:' line naming the feature's source files"
    while IFS= read -r path; do
      [[ "$path" == */ || "$path" == *[*?]* ]] && { report "touches '$path': name files, not folders or globs"; continue; }
      [[ -e "$(resolve "$path")" ]] || report "touches '$path', which does not exist"
    done < <(touches_of "$feature")
    grep -q '^step ' "$file" || report "no step"
    while IFS= read -r problem; do report "$problem"; done < <(check_expects "$file")
    grep -n -E '(^|[^A-Za-z0-9_./-])sleep([[:space:]]|$)' "$file" | sed "s/^/$feature: bare sleep, use wait_for: line /" | grep . && problems=1
    grep -n 'waitForTimeout(' "$file" | sed "s/^/$feature: waitForTimeout, wait for the state instead: line /" | grep . && problems=1
    bash -n "$file" 2> /dev/null || report "not valid bash: $(bash -n "$file" 2>&1 | head -n 1)"
  done
  return $problems
}

check_expects() {
  awk '
    /^step "/ { label = $0; sub(/^step "/, "", label); sub(/".*$/, "", label); steps[label] }
    /^# expects:/ { line = substr($0, 12); expects[++n] = line }
    END {
      for (i = 1; i <= n; i++) {
        line = expects[i]; at = index(line, " -> ")
        if (!at) { print "expects line has no \" -> \": " line; continue }
        target = substr(line, at + 4)
        if (target ~ /^not driven:[[:space:]]*[^[:space:]]/) continue
        if (target ~ /^not driven/) { print "expects line says not driven without a reason: " line; continue }
        k = split(target, labels, /, /)
        for (j = 1; j <= k; j++) if (!(labels[j] in steps)) print "expects line names step \"" labels[j] "\", which the recipe does not have"
      }
    }
  ' "$1"
}

covers_of() { sed -n 's/^# covers:[[:space:]]*//p' "$skill/features/$1.sh" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d'; }

doctor() {
  [[ -x "$skill/bin/doctor.sh" ]] || return 0
  "$skill/bin/doctor.sh" > "$1" 2>&1 < /dev/null
}

header() { sed -n "s/^# $2:[[:space:]]*//p" "$skill/features/$1.sh"; }

lane_count() { cat "$cache/lanes" 2> /dev/null || echo 0; }
lane_id() { if (($1 == 0)); then cat "$cache/run-id"; else echo "$(cat "$cache/run-id")-l$1"; fi; }

on_lane() {
  local lane=$1
  shift
  VERIFY_LANE=$lane VERIFY_RUN_ID=$(lane_id "$lane") "$@"
}

run_feature() {
  local lane=$2
  export VERIFY_LANE=$lane VERIFY_RUN_ID=$(lane_id "$lane")
  local feature=$1 dir=$cache/drive/$1 start=$SECONDS status limit
  limit=$(header "$feature" deadline)
  limit=${limit:-$deadline}
  rm -rf "$dir" "$cache/evidence/$feature"
  mkdir -p "$dir" "$cache/evidence/$feature"
  echo "$limit" > "$dir/deadline"
  VERIFY_FEATURE=$feature VERIFY_SESSION=$feature VERIFY_DIR=$dir EVIDENCE=$cache/evidence/$feature \
    timeout -k 30 "$limit" bash "$skill/bin/lib.sh" "$skill/features/$feature.sh" > "$dir/log" 2>&1 < /dev/null
  status=$?
  echo $((SECONDS - start)) > "$dir/seconds"
  echo "$status" > "$dir/status"
  if ((status)) && [[ ! -e "$run/stop" ]] && ! doctor "$run/doctor.log"; then
    echo "$feature" > "$run/stop"
  fi
}

line_of() {
  local feature=$1 dir=$cache/drive/$1 step="" result="" status seconds known
  [[ -e "$dir/status" ]] || { echo "$feature: not run (doctor.sh failed after $(cat "$run/stop"), see $run/doctor.log)"; return 1; }
  status=$(cat "$dir/status") seconds=$(cat "$dir/seconds")
  [[ -e "$dir/step" ]] && step=$(cat "$dir/step")
  [[ -e "$dir/result" ]] && result=$(head -n 1 "$dir/result")
  local tail=""
  grep -q -x cleanup-failed "$dir/result" 2> /dev/null && tail="; clean up failed"
  if ((status == 0)) && [[ "$result" == pass ]]; then
    echo "$feature: pass (${seconds}s)$tail"
    [[ -z "$tail" ]]
    return
  elif ((status == 124 || status == 137)) && ((seconds >= $(cat "$dir/deadline"))); then
    echo "$feature: timeout after ${seconds}s at \"$step\" ($dir/log)$tail"
  else
    known=""
    header "$feature" "known failure" | grep -q -x -F "$step" && known=" (known failure)"
    local command said
    command=$(head -n 1 "$dir/error" 2> /dev/null | cut -c 1-120)
    said=$(sed '/^== Clean up/,$d' "$dir/log" | grep -v -e '^== ' -e '^[[:space:]]*$' | tail -n 1 | cut -c 1-200)
    echo "$feature: fail at \"$step\"$known: ${command:-?} -> ${said:-no output} (${seconds}s, $dir/log)$tail"
  fi
  return 1
}

drive() {
  local feature together=() alone=() pids=() started=$SECONDS result=0 lane count
  (($#)) || { echo "verify: no features to drive" >&2; return 2; }
  [[ -f "$cache/run-id" ]] || { echo "verify: no environment; run 'bin/verify up' first" >&2; return 2; }
  export VERIFY_RUN_ID=$(cat "$cache/run-id") VERIFY_LANE=0
  count=$(lane_count)
  run=$cache/drive/.run-$$
  mkdir -p "$run"
  lint "$@" > "$run/lint.txt" || { cat "$run/lint.txt" >&2; echo "verify: fix the recipes above first" >&2; rm -rf "$run"; return 2; }
  doctor "$run/doctor.log" || { echo "verify: doctor.sh failed, see $run/doctor.log" >&2; return 2; }
  for feature in "$@"; do
    rm -rf "${cache:?}/drive/$feature"
    if grep -q '^# alone' "$skill/features/$feature.sh"; then alone+=("$feature"); else together+=("$feature"); fi
  done
  trap 'for pid in "${pids[@]}"; do pkill -TERM -P "$pid"; done; wait; exit 130' INT TERM
  run_lane() {
    local lane=$1 index=0 feature
    for feature in "${alone[@]}"; do
      ((index++ % count + 1 == lane)) || continue
      [[ -e "$run/stop" ]] && break
      run_feature "$feature" "$lane"
    done
  }
  if ((count > 0)); then
    for ((lane = 1; lane <= count; lane++)); do run_lane "$lane" & pids+=($!); done
  fi
  for feature in "${together[@]}"; do
    while (($(jobs -rp | wc -l) >= max_jobs + count)); do wait -n; done
    [[ -e "$run/stop" ]] && break
    run_feature "$feature" 0 &
    pids+=($!)
  done
  wait
  if ((count == 0)); then
    for feature in "${alone[@]}"; do
      [[ -e "$run/stop" ]] && break
      run_feature "$feature" 0 &
      pids+=($!)
      wait
    done
  fi
  trap - INT TERM
  echo
  echo "Summary ($((SECONDS - started))s, $# features)"
  for feature in "$@"; do line_of "$feature" || result=1; done
  local driven=0 skipped=0
  for feature in "$@"; do
    driven=$((driven + $(grep -c '^# expects:' "$skill/features/$feature.sh")))
    skipped=$((skipped + $(grep -c -E '^# expects:.* -> not driven' "$skill/features/$feature.sh")))
  done
  echo "Expectations: $((driven - skipped)) checked by a step, $skipped not driven"
  echo "Evidence: $cache/evidence/<feature>/"
  [[ -e "$run/stop" ]] || rm -rf "$run"
  return $result
}

cd "$root"
mkdir -p "$cache"
export VERIFY_SKILL=$skill VERIFY_ROOT=$root
export_apps || exit 2
command=${1:-}
[[ $# -gt 0 ]] && shift

case $command in
  up)
    [[ -f "$cache/run-id" ]] || echo "verify-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')" > "$cache/run-id"
    [[ -z "$lanes" ]] || echo "$lanes" > "$cache/lanes"
    count=$(lane_count) failed=0
    if ((count == 0)); then
      on_lane 0 "$skill/bin/launch.sh" "$@" || failed=1
    else
      for ((lane = 0; lane <= count; lane++)); do
        on_lane "$lane" "$skill/bin/launch.sh" "$@" > "$cache/launch-$lane.log" 2>&1 &
      done
      for ((lane = 0; lane <= count; lane++)); do wait -n || failed=1; done
      ((failed == 0)) || tail -n 20 "$cache"/launch-*.log >&2
    fi
    ((failed == 0)) || { echo "verify: launch.sh failed; run 'bin/verify down' to remove what it started" >&2; exit 1; }
    for ((lane = 0; lane <= count; lane++)); do
      on_lane "$lane" doctor "$cache/doctor-$lane.log" || { echo "verify: doctor.sh failed after launch on lane $lane, see $cache/doctor-$lane.log" >&2; exit 1; }
    done
    echo "up: $(cat "$cache/run-id")$( ((count)) && echo " and $count lanes")" ;;
  down)
    count=$(lane_count) failed=0
    if [[ -f "$cache/run-id" ]]; then
      for ((lane = count; lane >= 0; lane--)); do on_lane "$lane" "$skill/bin/cleanup.sh" "$@" || failed=1; done
    else
      "$skill/bin/cleanup.sh" "$@" || failed=1
    fi
    ((failed == 0)) || { echo "verify: cleanup.sh failed; the run's record stays in $cache" >&2; exit 1; }
    rm -f "$cache/run-id" "$cache/lanes"
    echo "down" ;;
  list)
    for feature in $(all_features); do printf '%s: %s\n' "$feature" "$(summary_of "$feature")"; done ;;
  lint)
    (($#)) || set -- $(all_features)
    lint "$@" && echo "lint: ok" ;;
  uncovered)
    [[ -x "$skill/bin/entrypoints.sh" ]] || { echo "verify: no bin/entrypoints.sh" >&2; exit 2; }
    "$skill/bin/entrypoints.sh" | sort -u > "$cache/entrypoints"
    if grep -q $'\t' "$cache/entrypoints"; then
      for feature in $(all_features); do covers_of "$feature"; done | sort -u > "$cache/covered"
      awk -F '\t' 'NR == FNR { covered[$0]; next } !($1 in covered)' "$cache/covered" "$cache/entrypoints" > "$cache/uncovered"
    else
      for feature in $(all_features); do touches_of "$feature"; done | sort -u > "$cache/covered"
      comm -23 "$cache/entrypoints" "$cache/covered" > "$cache/uncovered"
    fi
    total=$(wc -l < "$cache/entrypoints") missing=$(wc -l < "$cache/uncovered")
    echo "Entry points covered: $((total - missing)) of $total"
    [[ -s "$cache/uncovered" ]] && { echo "Not covered by any feature:"; sed 's/^/  /' "$cache/uncovered"; }
    exit 0 ;;
  affected)
    while (($#)); do
      case $1 in
        --dry) dry=1; shift ;;
        --base) base=${2:?--base needs a ref}; shift 2 ;;
        *) echo "verify: affected takes --dry and --base <ref>" >&2; exit 2 ;;
      esac
    done
    select_affected || exit 2
    [[ -s "$cache/affected" && -z "$dry" ]] || exit 0
    drive $(cut -f1 "$cache/affected" | sort -u) ;;
  all)
    drive $(all_features) ;;
  "" | -h | help)
    sed -n '2,9s/^# \{0,1\}//p' "$0" ;;
  *)
    for feature in "$command" "$@"; do
      [[ -f "$skill/features/$feature.sh" ]] || { echo "verify: no features/$feature.sh (verify list shows the features)" >&2; exit 2; }
    done
    drive "$command" "$@" ;;
esac
