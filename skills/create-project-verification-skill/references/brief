def app_roots():
    roots = {'': root}
    apps = os.path.join(skill, 'apps')
    if os.path.isfile(apps):
        for line in read(apps).splitlines():
            parts = line.split()
            if parts:
                name = parts[0]
                env_val = os.environ.get('APP_' + name.upper().replace('-', '_'))
                if env_val:
                    roots[name + '/'] = os.path.abspath(env_val)
    return roots


def read(path):
    with open(path, errors='replace') as handle:
        return handle.read()


ROOTS = app_roots()
FILE_CACHE = {}


def resolve_path(rel):
    for prefix in sorted(ROOTS, key=len, reverse=True):
        if prefix and rel.startswith(prefix):
            p = os.path.join(ROOTS[prefix], rel[len(prefix):])
            if os.path.isfile(p):
                return p
    p = os.path.join(root, rel)
    return p if os.path.isfile(p) else None


def read_lines(rel):
    if rel not in FILE_CACHE:
        p = resolve_path(rel)
        FILE_CACHE[rel] = read(p).splitlines(keepends=True) if p else []
    return FILE_CACHE[rel]


def indent(line):
    expanded = line.expandtabs(4)
    return len(expanded) - len(expanded.lstrip())


def strip_strings(text):
    text = re.sub(r'""".*?"""|\'\'\'.*?\'\'\'', '""', text)
    text = re.sub(r'"(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\'|`(?:[^`\\]|\\.)*`', '""', text)
    text = re.sub(r'#.*$|//.*$', '', text)
    return text


def leading_decorators(lines, index):
    """Walk up from `index` to include contiguous decorators/annotations (@...)."""
    base = indent(lines[index])
    start = index
    i = index - 1
    while i >= 0:
        s = lines[i].strip()
        if not s:
            break
        if s.startswith('@') and indent(lines[i]) == base:
            start = i
            i -= 1
            continue
        if s.endswith(')') and indent(lines[i]) >= base:
            j = i
            depth = 0
            found_at = None
            while j >= 0 and i - j < 15:
                cleaned = strip_strings(lines[j])
                depth += cleaned.count(')') - cleaned.count('(')
                if lines[j].strip().startswith('@') and indent(lines[j]) == base and depth <= 0:
                    found_at = j
                    break
                j -= 1
            if found_at is not None:
                start = found_at
                i = found_at - 1
                continue
        break
    return start


def find_block_end(lines, index):
    """Find the end line (0-based inclusive) of a definition starting at `index`, handling multi-line signatures."""
    base = indent(lines[index])
    sig_end = index
    paren = 0
    bracket = 0
    for j in range(index, min(len(lines), index + 40)):
        cleaned = strip_strings(lines[j])
        paren += cleaned.count('(') - cleaned.count(')')
        bracket += cleaned.count('[') - cleaned.count(']')
        sig_end = j
        stripped = cleaned.rstrip()
        if paren <= 0 and bracket <= 0:
            if stripped.endswith(('\\', '->', '=')) and j + 1 < len(lines):
                continue
            break

    sig_text = ''.join(strip_strings(lines[k]) for k in range(index, sig_end + 1)).strip()
    next_nonblank = None
    for k in range(sig_end + 1, len(lines)):
        if lines[k].strip():
            next_nonblank = k
            break
    if next_nonblank is None or indent(lines[next_nonblank]) <= base:
        if next_nonblank is not None and lines[next_nonblank].strip().startswith('{') and indent(lines[next_nonblank]) == base:
            sig_end = next_nonblank
        elif sig_text.endswith(';') or (sig_text.count('{') > 0 and sig_text.count('{') == sig_text.count('}')):
            return sig_end
        elif next_nonblank is None or indent(lines[next_nonblank]) <= base:
            return sig_end

    last = sig_end
    in_triple = None
    for later in range(sig_end + 1, len(lines)):
        raw = lines[later]
        stripped = raw.strip()
        if in_triple:
            if in_triple in raw:
                if raw.count(in_triple) % 2 == 1:
                    in_triple = None
            last = later
            continue
        if not stripped:
            continue
        if indent(raw) <= base:
            if stripped[0] in '})]':
                last = later
            break
        for q in ('"""', "'''"):
            if raw.count(q) % 2 == 1:
                in_triple = q
                break
        last = later
    return last


def function(lines, name):
    """The (1-based first, 1-based last) line numbers of the block that defines `name`, or None."""
    esc = re.escape(name)
    defines = re.compile(
        r'^\s*(?:(?:export\s+(?:default\s+)?|public|private|protected|static|async|final|override|abstract|readonly)\s+)*'
        r'(?:def|function|func|fn|fun|class|interface|type|record|sub|const|let|var|val|[\w<>\[\],.?*&]+)?\s*\*?'
        + esc + r'\s*(?:[(=:<{]|$)'
    )
    bad_start = ('#', '//', '*', '/*', 'return ', 'if ', 'elif ', 'while ', 'for ', 'await ', 'throw ', 'raise ', 'else', 'catch')
    best = None
    for index, line in enumerate(lines):
        s = line.lstrip()
        if not defines.match(line) or s.startswith(bad_start):
            continue
        # Reject bare function calls like `_import_table(\n  arg1,\n)` that have no declaration keyword or block opener.
        before = line[:line.find(name)].strip()
        after = line[line.find(name) + len(name):].strip()
        if not before and after.startswith('('):
            sig_end = index
            paren = 0
            for j in range(index, min(len(lines), index + 25)):
                cleaned = strip_strings(lines[j])
                paren += cleaned.count('(') - cleaned.count(')')
                sig_end = j
                if paren <= 0:
                    break
            tail = strip_strings(lines[sig_end]).rstrip()
            if not (tail.endswith('{') or tail.endswith(':') or (sig_end + 1 < len(lines) and lines[sig_end + 1].strip().startswith('{'))):
                continue
        start = leading_decorators(lines, index)
        end = find_block_end(lines, index)
        if end > index:
            return start + 1, end + 1
        if best is None:
            best = (start + 1, end + 1)
    return best


def test_body(lines, name):
    """The first and last line number of the test whose title or function name is `name`, or None."""
    words = re.findall(r'\w+', name)
    if not words:
        return None
    title = re.compile(r'[\W_]+'.join(map(re.escape, words)), re.I)
    for index, line in enumerate(lines):
        if not title.search(line) or not re.search(r'\b(def|test|it|func|fn|fun|void|describe)\b', line):
            continue
        start = leading_decorators(lines, index)
        end = find_block_end(lines, index)
        return start + 1, end + 1
    return None


INV_PATTERNS = (
    re.compile(r'^\s*(?:async\s+)?def\s+([A-Za-z_]\w*)\s*\('),
    re.compile(r'^\s*(?:export\s+(?:default\s+)?)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)\s*[<(]'),
    re.compile(r'^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*(?::[^=]+)?=\s*(?:async\s+)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>'),
    re.compile(r'^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:useCallback|useMemo|memo)\s*\('),
    re.compile(r'^\s*(?:(?:public|private|protected|static|async|final|override|abstract)\s+)+[\w<>\[\],.?*&]+\s+([A-Za-z_]\w*)\s*\('),
    re.compile(r'^\s*func\s+(?:\([^)]*\)\s+)?([A-Za-z_]\w*)\s*\('),
    re.compile(r'^\s*(?:pub\s+)?(?:async\s+)?fn\s+([A-Za-z_]\w*)\s*[<(]'),
)


def extract_inventory_functions(rel):
    """Deterministically list functions/methods in `rel` with line range, line count, branch count, and signature."""
    lines = read_lines(rel)
    if not lines:
        return []
    found = []
    seen_ranges = set()
    for index, line in enumerate(lines):
        ind = indent(line)
        if ind > 8:
            continue
        s = line.lstrip()
        if s.startswith(('#', '//', '*', '/*')):
            continue
        name = None
        for pat in INV_PATTERNS:
            m = pat.match(line)
            if m:
                name = m.group(1)
                break
        if not name or name in SKIP_INV_NAMES:
            continue
        start = leading_decorators(lines, index)
        end = find_block_end(lines, index)
        if (start, end) in seen_ranges:
            continue
        seen_ranges.add((start, end))
        block = lines[start:end + 1]
        body_text = ''.join(block)
        branches = len(BRANCH_RE.findall(body_text))
        sig_parts = [l.strip() for l in lines[start:index + 1] if l.strip()]
        sig = ' '.join(sig_parts)
        if len(sig) > 120:
            sig = sig[:117] + '...'
        found.append({
            'file': rel,
            'base': os.path.basename(rel),
            'name': name,
            'start': start + 1,
            'end': end + 1,
            'lines': end - start + 1,
            'branches': branches,
            'sig': sig,
            'text': body_text,
        })
    return found


def parse_areas():
    """Return list of dicts: {name, line, entrypoints, files} from .cache/areas.txt."""
    path = os.path.join(skill, '.cache', 'areas.txt')
    if not os.path.isfile(path):
        return []
    result = []
    for line in read(path).splitlines():
        raw = line.strip()
        if not raw or ':' not in raw:
            continue
        clean = raw[len('split: '):] if raw.startswith('split: ') else raw
        name = clean.partition(':')[0].strip()
        ep_part = clean.partition('entry points:')[2].partition('; files:')[0].strip()
        eps = [e.strip() for e in ep_part.split(',') if e.strip()]
        files = clean.partition('files:')[2].split()
        result.append({'name': name, 'line': raw, 'entrypoints': eps, 'files': files})
    return result


def area_file_counts(areas):
    counts = defaultdict(set)
    for a in areas:
        for f in a['files']:
            counts[f].add(a['name'])
    return counts


def classify_files(area_info, file_owners):
    """Split an area's files into primary vs shared."""
    name = area_info['name']
    primary, shared = [], []
    for f in area_info['files']:
        owners = file_owners[f]
        stem = os.path.splitext(os.path.basename(f))[0].lower()
        if len(owners) == 1 or (len(owners) <= 2 and (stem == name.lower() or name.lower() in stem.split('_') or name.lower() in stem.split('-'))):
            primary.append(f)
        else:
            shared.append(f)
    return primary, shared


def load_expectations(area_name):
    path = os.path.join(skill, '.cache', 'expect', area_name + '.txt')
    if not os.path.isfile(path):
        return []
    items = []
    for line in read(path).splitlines():
        s = line.strip()
        if not s:
            continue
        items.append(s[2:].strip() if s.startswith('- ') else s)
    return items


def uncovered_for(area_name):
    """Run `verify uncovered <area>` and parse entry points and actions."""
    proc = subprocess.run([os.path.join(skill, 'bin', 'verify'), 'uncovered', area_name], capture_output=True, text=True)
    eps, actions = [], []
    for kind, name, file in re.findall(r'^\s+(entry point|action): (.+?)(?: \(([^()]*)\))?$', proc.stdout, re.M):
        if kind == 'entry point':
            eps.append((name.strip(), file.strip()))
        else:
            actions.append((name.strip(), file.strip()))
    return eps, actions


def write_plan_brief(area_name, areas, file_owners):
    info = next((a for a in areas if a['name'] == area_name), None)
    if not info:
        sys.exit(f'brief: no area {area_name!r} in .cache/areas.txt')
    primary, shared = classify_files(info, file_owners)
    expectations = load_expectations(area_name)
    unc_eps, unc_actions = uncovered_for(area_name)
    own_actions = [(n, f) for n, f in unc_actions if f in primary or len(file_owners[f]) <= 1]

    steps = read(os.path.join(skill, 'RECORDERS.md'))
    plan_sec = re.search(r'^## Plan an area\n.*?(?=^## Record a group)', steps, re.S | re.M)

    parts = [
        f'# Plan brief for area `{area_name}`\n',
        (plan_sec.group(0).strip() if plan_sec else steps) + '\n',
        f'## Area line\n\n{info["line"]}\n',
    ]

    if info['entrypoints']:
        parts.append('## Entry points (assign every one to a feature `covers:`)\n\n' +
                     '\n'.join(f'- EP{i}: `{ep}`' for i, ep in enumerate(info['entrypoints'], 1)) + '\n')
    else:
        parts.append('## Entry points\n\nNone (behavior is triggered via UI/background/client code in the files below).\n')

    if own_actions:
        parts.append('## Own actions (cite every one as `<file>: <action>` in a feature `functions:`)\n\n' +
                     '\n'.join(f'- A{i}: `{f}: {n}`' for i, (n, f) in enumerate(own_actions, 1)) + '\n')

    if expectations:
        parts.append('## Expectations from `.cache/expect/' + area_name + '.txt` (assign every `E#` to exactly one feature)\n\n' +
                     '\n'.join(f'- E{i}: {e}' for i, e in enumerate(expectations, 1)) + '\n')
    else:
        parts.append('## Expectations\n\nNone.\n')

    inv_lines = ['## Deterministic code inventory\n']
    primary_symbols = set()
    primary_text_parts = []
    for f in primary:
        funcs = extract_inventory_functions(f)
        primary_text_parts.append(''.join(read_lines(f)))
        inv_lines.append(f'### Primary file: `{f}` ({len(read_lines(f))} lines — assign every non-trivial function to a feature or `ignored:`)')
        if not funcs:
            inv_lines.append('  (no top-level functions detected; inspect file if needed)')
        for fn in funcs:
            primary_symbols.add(fn['name'])
            req = '' if (fn['lines'] >= 8 or fn['branches'] >= 2) else ' [small]'
            inv_lines.append(f'- `{fn["base"]}: {fn["name"]}` (lines {fn["start"]}-{fn["end"]}, {fn["lines"]}L, {fn["branches"]} branches){req} — `{fn["sig"]}`')
        inv_lines.append('')

    primary_blob = '\n'.join(primary_text_parts)
    primary_call_syms = {s for s in primary_symbols if len(s) >= 4 and s.lower() not in GENERIC_LINK_SYMS}
    ep_paths = [re.sub(r'^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+', '', ep) for ep in info['entrypoints']]

    for f in shared:
        funcs = extract_inventory_functions(f)
        owners = sorted(file_owners[f] - {area_name})
        inv_lines.append(f'### Shared file: `{f}` (also in: {", ".join(owners)})')
        linked_map = {}
        for fn in funcs:
            text = fn['text']
            fname = fn['name']
            hits = [s for s in primary_call_syms if re.search(r'\b' + re.escape(s) + r'\b', text)]
            called_by_primary = (
                len(fname) >= 4 and fname.lower() not in GENERIC_LINK_SYMS
                and fname != 'as_dict'
                and bool(re.search(r'\b' + re.escape(fname) + r'\b', primary_blob))
            )
            ep_hit = any(p and p in text for p in ep_paths)
            name_hit = area_name.lower() in fname.lower() or (area_name.lower().rstrip('s') in fname.lower() and len(area_name) >= 4)
            if hits or called_by_primary or ep_hit or name_hit:
                reasons = []
                if hits:
                    reasons.append('uses ' + ', '.join(sorted(hits)[:3]))
                if called_by_primary:
                    reasons.append('called by primary')
                if ep_hit:
                    reasons.append('entry point')
                if name_hit and not (hits or called_by_primary or ep_hit):
                    reasons.append('name')
                linked_map[(fn['name'], fn['start'])] = (fn, '; '.join(reasons))

        hop1_syms = {
            fn['name'] for fn, _ in linked_map.values()
            if len(fn['name']) >= 4 and fn['name'].lower() not in GENERIC_LINK_SYMS and fn['lines'] < 250
        }
        if hop1_syms:
            for fn in funcs:
                key = (fn['name'], fn['start'])
                if key in linked_map or fn['lines'] >= 250:
                    continue
                h2 = [s for s in hop1_syms if s != fn['name'] and re.search(r'\b' + re.escape(s) + r'\b', fn['text'])]
                if h2:
                    linked_map[key] = (fn, 'calls ' + ', '.join(sorted(h2)[:3]))

        linked = [linked_map[(fn['name'], fn['start'])] for fn in funcs if (fn['name'], fn['start']) in linked_map]
        other = [fn for fn in funcs if (fn['name'], fn['start']) not in linked_map]
        if linked:
            inv_lines.append('Linked to this area (inspect & assign the ones behind your area):')
            for fn, why in linked:
                inv_lines.append(f'- `{fn["base"]}: {fn["name"]}` (lines {fn["start"]}-{fn["end"]}, {fn["lines"]}L, {fn["branches"]} branches; {why}) — `{fn["sig"]}`')
        large_enclosing = [fn for fn in funcs if fn['lines'] >= 250]
        if large_enclosing:
            flines = read_lines(f)
            cue_words = sorted(hop1_syms | primary_call_syms | {area_name.lower(), 'offline', 'reconnect', 'session', 'unsent', 'retry', 'sync'})
            cue_re = re.compile(r'\b(?:' + '|'.join(re.escape(w) for w in cue_words if len(w) >= 4) + r')\b', re.I)
            inner_ranges = [(fn['start'], fn['end']) for fn in funcs if fn['lines'] < 250]
            snippets = []
            for enc in large_enclosing:
                for lno in range(enc['start'], enc['end'] + 1):
                    if any(a <= lno <= b for a, b in inner_ranges):
                        continue
                    txt = flines[lno - 1].strip()
                    if not txt or txt.startswith(('//', '/*', '*', 'import ')):
                        continue
                    if cue_re.search(txt) and (any(q in txt for q in ('"', "'", '`', '<', 'toast', 'banner', 'addEventListener')) or 'useEffect' in txt):
                        snippets.append(f'  L{lno}: {txt[:130]}')
                        if len(snippets) >= 35:
                            break
            if snippets:
                inv_lines.append(f'Relevant top-level/JSX lines in `{os.path.basename(f)}` (outside inner helpers — cite `{os.path.basename(f)}: {large_enclosing[0]["name"]}` with a `notes:` hint if your area owns these banners/handlers):')
                inv_lines.extend(snippets)
        if other:
            summary = ', '.join(f'{fn["name"]}({fn["start"]})' for fn in other[:40])
            more = f' (+{len(other) - 40} more)' if len(other) > 40 else ''
            inv_lines.append(f'Other functions in `{os.path.basename(f)}` (likely other areas): {summary}{more}')
        inv_lines.append('')

    parts.append('\n'.join(inv_lines))
    dest = os.path.join(out, f'{area_name}.plan.md')
    with open(dest, 'w') as handle:
        handle.write('\n'.join(parts))
    return dest


def parse_exp_ids(text, max_id):
    ids = set()
    for a, b in re.findall(r'\bE?(\d+)(?:\s*-\s*E?(\d+))?\b', text):
        lo, hi = int(a), int(b or a)
        for n in range(lo, hi + 1):
            if 1 <= n <= max_id:
                ids.add(n)
    return sorted(ids)


def parse_file_funcs(text):
    """Parse `file.py: fn1, fn2; other.ts: fn3` into ordered list of (file, func)."""
    out_list = []
    cur_file = None
    for chunk in re.split(r'[;\n]+', text):
        chunk = chunk.strip().lstrip('- ').strip()
        if not chunk or chunk.lower() == 'none':
            continue
        chunk = re.sub(r'\([^()]*\)\s*$', '', chunk).strip()
        if ':' in chunk:
            file_part, rest = chunk.split(':', 1)
            if re.search(r'\.\w+$', file_part.strip()):
                cur_file = file_part.strip()
                chunk = rest
        if not cur_file:
            continue
        for fn in re.split(r'\s*,\s*', chunk):
            fn = re.sub(r'\(\)$', '', fn.strip())
            if fn and fn.lower() != 'none':
                pair = (cur_file, fn)
                if pair not in out_list:
                    out_list.append(pair)
    return out_list


def parse_map(area_name, max_exp):
    """Parse .cache/plan/<area>.map.txt into (features, ignored)."""
    path = os.path.join(skill, '.cache', 'plan', area_name + '.map.txt')
    if not os.path.isfile(path):
        return None, None
    features = []
    ignored = []
    cur = None
    in_ignored = False
    for raw in read(path).splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        m_feat = re.match(r'^feature\s+([A-Za-z0-9_-]+)\s*:?$', line, re.I)
        if m_feat:
            in_ignored = False
            cur = {'name': m_feat.group(1), 'covers': [], 'functions': [], 'expectations': [], 'notes': []}
            features.append(cur)
            continue
        if re.match(r'^ignored\s*:', line, re.I):
            in_ignored = True
            cur = None
            rest = line.partition(':')[2].strip()
            if rest and rest.lower() != 'none':
                ignored.extend(parse_file_funcs(rest))
            continue
        if in_ignored:
            ignored.extend(parse_file_funcs(line))
            continue
        if cur is None:
            continue
        key, sep, val = line.partition(':')
        if not sep:
            continue
        k = key.strip().lower()
        v = val.strip()
        if k == 'covers':
            if v and v.lower() != 'none':
                cur['covers'].extend(x.strip() for x in v.split(',') if x.strip())
        elif k in ('functions', 'funcs', 'actions'):
            cur['functions'].extend(parse_file_funcs(v))
        elif k in ('expectations', 'expects'):
            cur['expectations'].extend(parse_exp_ids(v, max_exp))
        elif k in ('notes', 'note'):
            if v and v.lower() != 'none':
                cur['notes'].append(v)
    for f in features:
        f['expectations'] = sorted(set(f['expectations']))
    return features, ignored


def resolve_area_file(file_ref, area_files):
    matches = [f for f in area_files if f == file_ref or f.endswith('/' + file_ref)]
    if matches:
        return matches[0]
    if resolve_path(file_ref):
        return file_ref
    return None


def validate_map(area_name, areas, file_owners):
    info = next((a for a in areas if a['name'] == area_name), None)
    if not info:
        sys.exit(f'brief: no area {area_name!r} in .cache/areas.txt')
    expectations = load_expectations(area_name)
    features, ignored = parse_map(area_name, len(expectations))
    if features is None:
        return None, None, None
    primary, shared = classify_files(info, file_owners)
    area_files = info['files']
    problems = []

    names = [f['name'] for f in features]
    if not names:
        problems.append('no `feature <area>-<goal>` blocks found in map')
    seen_names = set()
    for n in names:
        if n in seen_names:
            problems.append(f'duplicate feature name: {n}')
        seen_names.add(n)
        if not n.startswith(area_name + '-') and not os.path.isfile(os.path.join(skill, 'features', n + '.sh')):
            problems.append(f'feature name `{n}` does not start with `{area_name}-`')
        for other in names:
            if other != n and other.startswith(n + '-'):
                problems.append(f'feature `{n}` is a prefix of `{other}` (verify lint refuses this; rename one)')

    unc_eps, unc_actions = uncovered_for(area_name)
    covered_eps = {ep.lower() for f in features for ep in f['covers']}
    for ep, fpath in unc_eps:
        if ep.lower() not in covered_eps:
            problems.append(f'entry point not in any feature covers: `{ep}` ({fpath})')

    existing_expects = ''
    for rpath in glob.glob(os.path.join(skill, 'features', '*.sh')):
        existing_expects += '\n'.join(l for l in read(rpath).splitlines() if l.startswith('# expects:')) + '\n'
    assigned_exps = defaultdict(list)
    for f in features:
        for eid in f['expectations']:
            assigned_exps[eid].append(f['name'])
    for eid, text in enumerate(expectations, 1):
        if eid not in assigned_exps:
            if text not in existing_expects:
                problems.append(f'expectation not assigned: E{eid}: {text}')
        elif len(assigned_exps[eid]) > 1:
            problems.append(f'expectation E{eid} assigned to multiple features: {", ".join(assigned_exps[eid])}')

    cited_pairs = [(os.path.basename(fp), fn.rpartition('.')[2]) for f in features for fp, fn in f['functions']]
    cited_notes = ' '.join(n for f in features for n in f['notes'])
    for act, fpath in unc_actions:
        if fpath not in primary and len(file_owners[fpath]) > 1:
            continue
        base = os.path.basename(fpath)
        in_funcs = any(b == base and fn == act for b, fn in cited_pairs)
        in_notes = base in cited_notes and re.search(r'(?<![A-Za-z0-9_$])' + re.escape(act) + r'(?![A-Za-z0-9_$])', cited_notes)
        if not in_funcs and not in_notes:
            problems.append(f'action not cited: `{base}: {act}` ({fpath})')

    ignored_pairs = {(os.path.basename(fp), fn.rpartition('.')[2]) for fp, fn in ignored}
    cited_set = set(cited_pairs)
    for fpath in primary:
        for fn in extract_inventory_functions(fpath):
            if fn['lines'] < 8 and fn['branches'] < 2:
                continue
            key = (fn['base'], fn['name'])
            if key not in cited_set and key not in ignored_pairs:
                problems.append(f'primary function not mapped or ignored: `{fn["base"]}: {fn["name"]}` ({fn["lines"]}L, {fn["branches"]} branches)')

    checked = set()
    for feat in features:
        for fp, fn in feat['functions']:
            if (fp, fn) in checked:
                continue
            checked.add((fp, fn))
            resolved = resolve_area_file(fp, area_files)
            if not resolved:
                problems.append(f'cited file not found in `{feat["name"]}`: `{fp}: {fn}`')
                continue
            lines = read_lines(resolved)
            short = fn.rpartition('.')[2]
            if not function(lines, short):
                if not any(re.search(r'(?<![A-Za-z0-9_$])' + re.escape(short) + r'(?![A-Za-z0-9_$])', l) for l in lines):
                    problems.append(f'cited symbol not found in `{resolved}` (feature `{feat["name"]}`): `{fn}`')

    return features, ignored, problems


def helpers():
    """The source of the project's own helpers in bin/: whole when small, else its first lines."""
    parts = []
    for name in sorted(os.listdir(os.path.join(skill, 'bin'))):
        path = os.path.join(skill, 'bin', name)
        if name in SHIPPED or not os.path.isfile(path) or os.path.getsize(path) > 40000:
            continue
        try:
            lines = open(path).read().splitlines(keepends=True)
        except UnicodeDecodeError:
            continue
        shown = lines if len(lines) <= HELPER_LINES else lines[:15]
        note = '' if len(lines) <= HELPER_LINES else f' (the first 15 of {len(lines)} lines)'
        parts.append(f'## bin/{name}{note}\n\n```\n' + ''.join(shown) + ('' if shown and shown[-1].endswith('\n') else '\n') + '```\n')
    return parts


def write_common(example):
    manual = read(os.path.join(skill, 'SKILL.md'))
    sections = re.search(r'^## Recipes\n.*?(?=^## Isolation)', manual, re.S | re.M)
    steps = read(os.path.join(skill, 'RECORDERS.md'))
    rec_part = re.search(r'^## Record a group\n.*?(?=^## Repair features)', steps, re.S | re.M)
    rules_part = re.search(r'^## Rules\n.*', steps, re.S | re.M)
    recorder_text = (rec_part.group(0).strip() + '\n\n' + rules_part.group(0).strip()) if (rec_part and rules_part) else steps

    proj = read(os.path.join(skill, 'PROJECT.md'))
    proj = re.sub(r'^## Focused checks\n.*?(?=^## |\Z)', '', proj, flags=re.S | re.M)

    common = [
        '# RECORDERS.md (Record a group & Rules)\n\n' + recorder_text + '\n',
        '# SKILL.md (Recipes & When a drive fails)\n\n' + (sections.group(0).strip() if sections else manual) + '\n',
        '# PROJECT.md\n\n' + proj.strip() + '\n',
        f'# Example recipe: features/{example}.sh\n\n```bash\n' + read(os.path.join(skill, 'features', example + '.sh')).rstrip() + '\n```\n',
