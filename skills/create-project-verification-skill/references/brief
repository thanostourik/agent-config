def feature_weight(feat, area_files, cite_counts):
    """Deterministic complexity weight of a feature: prorated branches + 2*expectations + covers."""
    branches = 0
    seen = set()
    for fp, fn in feat['functions']:
        resolved = resolve_area_file(fp, area_files)
        if not resolved:
            continue
        short = fn.rpartition('.')[2]
        if (resolved, short) in seen:
            continue
        seen.add((resolved, short))
        lines = read_lines(resolved)
        loc = function(lines, short)
        if loc:
            txt = ''.join(lines[loc[0] - 1:loc[1]])
            raw_b = min(25, len(BRANCH_RE.findall(txt)))
            share = max(1, cite_counts[(resolved, short)])
            branches += max(1, raw_b // share) if raw_b else 0
    return max(4, branches + 2 * len(feat['expectations']) + len(feat['covers']))


def pack_groups(features, area_files):
    """Deterministically LPT-pack features into balanced groups (<= GROUP_MAX_FEATURES, soft weight cap), preferring shared files."""
    if not features:
        return []
    cite_counts = defaultdict(int)
    for feat in features:
        seen = set()
        for fp, fn in feat['functions']:
            resolved = resolve_area_file(fp, area_files)
            if resolved:
                key = (resolved, fn.rpartition('.')[2])
                if key not in seen:
                    seen.add(key)
                    cite_counts[key] += 1

    scored = []
    for feat in features:
        w = feature_weight(feat, area_files, cite_counts)
        files = sorted({resolve_area_file(fp, area_files) or fp for fp, _ in feat['functions']})
        scored.append((-w, feat['name'], w, set(files), feat))
    scored.sort(key=lambda x: (x[0], x[1]))

    total_w = sum(x[2] for x in scored)
    n_groups = max(
        math.ceil(len(scored) / GROUP_MAX_FEATURES),
        math.ceil(total_w / GROUP_WEIGHT_CAP),
    )
    groups = [{'weight': 0, 'files': set(), 'items': []} for _ in range(n_groups)]
    for _, _, w, fset, feat in scored:
        eligible = [g for g in groups if len(g['items']) < GROUP_MAX_FEATURES]
        best = min(eligible, key=lambda g: (g['weight'] - (6 if (g['files'] & fset) else 0), len(g['items'])))
        best['items'].append((feat, w))
        best['weight'] += w
        best['files'] |= fset

    groups = [g for g in groups if g['items']]
    groups.sort(key=lambda g: (-g['weight'], g['items'][0][0]['name']))
    return groups


def extract_referenced_defs(shown_texts, area_files, already_shown_keys):
    """Find referenced UPPER_CASE constants and CamelCase schemas/types in area_files."""
    combined = '\n'.join(shown_texts)
    want_consts = sorted({m for m in UPPER_IDENT.findall(combined) if m not in already_shown_keys})
    want_types = sorted({m for m in TYPE_IDENT.findall(combined) if m not in SKIP_TYPES and m not in already_shown_keys})
    extras = []
    total_lines = 0
    seen = set()
    for name in want_consts + want_types:
        if total_lines >= MAX_EXTRA_LINES:
            break
        for rel in area_files:
            if (rel, name) in seen:
                continue
            lines = read_lines(rel)
            if not lines:
                continue
            if not any(name in l for l in lines):
                continue
            loc = function(lines, name)
            if not loc:
                continue
            if (rel, loc) in seen:
                continue
            seen.add((rel, name))
            seen.add((rel, loc))
            span = min(loc[1] - loc[0] + 1, CONST_LINES)
            if total_lines + span > MAX_EXTRA_LINES:
                continue
            first, last = loc[0], loc[0] + span - 1
            cut = '' if last == loc[1] else f' (first {span} of {loc[1] - loc[0] + 1} lines)'
            extras.append(f'### Context, {rel}: {name}, lines {first} to {last}{cut}\n\n'
                          + ''.join(f'{first + i}\t{l}' for i, l in enumerate(lines[first - 1:last])))
            total_lines += span
            break
    return extras


def build_group_briefs_from_map(area_name, info, features):
    area_files = info['files']
    expectations = load_expectations(area_name)
    plan_dir = os.path.join(skill, '.cache', 'plan')
    os.makedirs(plan_dir, exist_ok=True)
    for old in glob.glob(os.path.join(plan_dir, f'{area_name}.*.txt')):
        if not old.endswith('.map.txt'):
            os.remove(old)
    for old in glob.glob(os.path.join(out, f'{area_name}.*.md')):
        if not old.endswith('.plan.md'):
            os.remove(old)

    groups = pack_groups(features, area_files)
    summary = []
    for idx, g in enumerate(groups, 1):
        plan_path = os.path.join(plan_dir, f'{area_name}.{idx}.txt')
        plan_lines = []
        for feat, w in g['items']:
            funcs_str = '; '.join(f'{fp}: {fn}' for fp, fn in feat['functions'])
            exps_str = ', '.join(f'E{e}' for e in feat['expectations'])
            cov_str = ', '.join(feat['covers'])
            plan_lines.append(f'{feat["name"]}: weight={w}; covers: {cov_str or "none"}; expectations: {exps_str or "none"}; functions: {funcs_str}')
        with open(plan_path, 'w') as handle:
            handle.write('\n'.join(plan_lines) + '\n')

        parts = [f'# Your group: {area_name}.{idx} (weight={g["weight"]}, {len(g["items"])} features)\n']
        cited = []
        exp_lines = []
        for feat, w in g['items']:
            parts.append(f'## Feature `{feat["name"]}` (weight={w})')
            if feat['covers']:
                parts.append(f'- `# covers:` {", ".join(feat["covers"])}')
            touched = sorted({resolve_area_file(fp, area_files) or fp for fp, _ in feat['functions']})
            if touched:
                parts.append(f'- `# touches:` {" ".join(touched)}')
            if feat['functions']:
                parts.append(f'- Functions: {"; ".join(f"{fp}: {fn}" for fp, fn in feat["functions"])}')
            if feat['notes']:
                parts.append(f'- Notes: {" | ".join(feat["notes"])}')
            if feat['expectations']:
                parts.append('- Assigned expectations (every one needs an `# expects:` line citing it):')
                for eid in feat['expectations']:
                    if 1 <= eid <= len(expectations):
                        etext = expectations[eid - 1]
                        parts.append(f'  - E{eid}: {etext}')
                        exp_lines.append(etext)
            parts.append('')
            for pair in feat['functions']:
                if pair not in cited:
                    cited.append(pair)

        shown = []
        shown_texts = []
        shown_names = set()
        omitted = []
        total_src_lines = 0
        for fp, fn in cited:
            resolved = resolve_area_file(fp, area_files)
            if not resolved:
                omitted.append(f'{fp}: {fn} (file not found)')
                continue
            lines = read_lines(resolved)
            short = fn.rpartition('.')[2]
            loc = function(lines, short)
            if not loc:
                omitted.append(f'{resolved}: {fn} (definition not extracted; grep in file)')
                continue
            if (resolved, loc) in shown:
                continue
            span = min(loc[1] - loc[0] + 1, MOST_LINES)
            if total_src_lines + span > MAX_SOURCE_LINES and shown:
                omitted.append(f'{resolved}: {fn} (lines {loc[0]}-{loc[1]}, omitted for brief budget)')
                continue
            shown.append((resolved, loc))
            shown_names.add(short)
            total_fn_lines = loc[1] - loc[0] + 1
            if total_fn_lines > MOST_LINES:
                head_n = MOST_LINES // 2
                tail_n = MOST_LINES - head_n
                h_first, h_last = loc[0], loc[0] + head_n - 1
                t_first, t_last = loc[1] - tail_n + 1, loc[1]
                chunk = (''.join(f'{h_first + i}\t{l}' for i, l in enumerate(lines[h_first - 1:h_last]))
                         + f'\n... (omitted lines {h_last + 1} to {t_first - 1} of {total_fn_lines}) ...\n\n'
                         + ''.join(f'{t_first + i}\t{l}' for i, l in enumerate(lines[t_first - 1:t_last])))
                shown_texts.append(''.join(lines[h_first - 1:h_last]) + ''.join(lines[t_first - 1:t_last]))
                parts.append(f'# Source, {resolved}: {fn}, lines {h_first}-{h_last} and {t_first}-{t_last} (of {total_fn_lines} lines)\n\n{chunk}')
            else:
                first, last = loc[0], loc[1]
                chunk = ''.join(f'{first + i}\t{l}' for i, l in enumerate(lines[first - 1:last]))
                shown_texts.append(''.join(lines[first - 1:last]))
                parts.append(f'# Source, {resolved}: {fn}, lines {first} to {last}\n\n{chunk}')
            total_src_lines += span

        extras = extract_referenced_defs(shown_texts, area_files, shown_names)
        if extras:
            parts.append('# Referenced constants and schemas\n\n' + '\n'.join(extras))

        tests = []
        for eline in exp_lines:
            for m_file, m_name in re.findall(r'([\w./-]*(?:tests?/|test_|\.test\.|\.spec\.)[\w./-]*\.\w+):\s*([^();]+)', eline):
                pair = (m_file.strip(), m_name.strip())
                if pair not in tests:
                    tests.append(pair)
        for tfile, tname in tests[:MOST_TESTS]:
            tlines = read_lines(tfile)
            if not tlines:
                continue
            loc = test_body(tlines, tname)
            if not loc:
                continue
            first, last = loc[0], min(loc[1], loc[0] + TEST_LINES - 1)
            parts.append(f'# Test, {tfile}: {tname}, lines {first} to {last}\n\n'
                         + ''.join(f'{first + i}\t{l}' for i, l in enumerate(tlines[first - 1:last])))

        snap_dir = os.path.join(skill, '.cache', 'snapshots', area_name)
        if os.path.isdir(snap_dir):
            snaps = sorted(os.listdir(snap_dir))
            if snaps:
                parts.append('# Existing snapshots (read before probing again)\n\n' +
                             '\n'.join(f'- .cache/snapshots/{area_name}/{s}' for s in snaps) + '\n')

        if omitted:
            parts.append('# Omitted or unfound citations\n\n' + '\n'.join(f'- {o}' for o in omitted) + '\n')

        with open(os.path.join(out, f'{area_name}.{idx}.md'), 'w') as handle:
            handle.write('\n'.join(parts))
        feat_names = ', '.join(f['name'] for f, _ in g['items'])
        summary.append((g['weight'], f'{area_name}.{idx} (weight={g["weight"]}, {len(g["items"])} features: {feat_names})'))
    return summary


def legacy_uncited(area_name, areas):
    """Fallback for legacy .cache/behaviors/<area>.txt format."""
    planned = read(os.path.join(skill, '.cache', 'behaviors', area_name + '.txt')).lower()
    shared = {f for a in areas if a['name'] != area_name for f in a['files']}
    own = []
    for line in load_expectations(area_name):
        name = line.partition(': ')[2].strip()
        if name and name.lower() not in planned:
            own.append('expectation: ' + line)
    unc_eps, unc_actions = uncovered_for(area_name)
    for ep, fpath in unc_eps:
        if ep.lower() not in planned:
            own.append(f'entry point: {ep} ({fpath})')
    for act, fpath in unc_actions:
        if fpath in shared:
            continue
        base = os.path.basename(fpath).lower()
        if base not in planned or not re.search(r'(?<![a-z0-9_$])' + re.escape(act.lower()) + r'(?![a-z0-9_$])', planned):
            own.append(f'action: {act} ({fpath})')
    return own


TEST_FILE_RE = re.compile(r'(^|/)(tests?|__tests__|spec)/|[._-](test|spec)\.|Tests?\.[a-z]+$')
SKIP_HARVEST_RE = re.compile(
    r'(^|/)(node_modules|dist|build|target|vendor|\.next|\.git|\.agents|\.claude|\.plans|local-stack|deployment-logs|review-evidence)(/|$)'
)
SKIP_DOC_RE = re.compile(
    r'(?:^|/)(?:agents|claude|changelog|license|contributing|code_of_conduct)\.md$|'
    r'(?:^|[_/-])(?:plan|plans|proposal|assessment|review|incident|handoff|runbook|report|comparison|deployment|release|adr|bootstrap|brief|status)(?:[_.-]|$)',
    re.I,
)
GENERIC_STEMS = {
    'index', 'main', 'app', 'server', 'client', 'model', 'models', 'types', 'utils', 'helpers',
    'common', 'base', 'config', 'init', '__init__', 'test', 'tests', 'spec', 'store', 'db', 'database',
}


def tracked_files():
    result = []
    for prefix, checkout in ROOTS.items():
        proc = subprocess.run(['git', '-C', checkout, 'ls-files', '-co', '--exclude-standard'], capture_output=True, text=True)
        for rel in proc.stdout.splitlines():
            if not rel or SKIP_HARVEST_RE.search(rel):
                continue
            full = os.path.join(checkout, rel)
            if os.path.isfile(full):
                result.append((prefix + rel, full))
    return result


def clean_stem(path):
    base = os.path.splitext(os.path.basename(path))[0].lower()
    base = re.sub(r'^(test_|spec_)|(_test|_spec|\.test|\.spec|tests?)$', '', base)
    return base


def harvest_file(words_regex, full_path, display_path):
    proc = subprocess.run([os.path.join(skill, 'bin', 'harvest'), words_regex, full_path], capture_output=True, text=True)
    lines = []
    for line in proc.stdout.splitlines():
        if line.startswith('- ' + full_path + ': '):
            lines.append('- ' + display_path + ': ' + line[len('- ' + full_path + ': '):])
        elif line.strip():
            lines.append(line)
    return lines


def auto_harvest(areas, file_owners, force=False):
    expect_dir = os.path.join(skill, '.cache', 'expect')
    os.makedirs(expect_dir, exist_ok=True)
    files = tracked_files()
    test_files = [(rel, full) for rel, full in files if TEST_FILE_RE.search(rel)]
    doc_files = [
        (rel, full) for rel, full in files
        if os.path.splitext(rel)[1].lower() in ('.md', '.markdown', '.rst')
        and not SKIP_DOC_RE.search(rel)
    ]

    area_meta = {}
    for a in areas:
        primary, shared_files = classify_files(a, file_owners)
        p_stems = {clean_stem(f) for f in primary if clean_stem(f) and clean_stem(f) not in GENERIC_STEMS}
        s_stems = {clean_stem(f) for f in shared_files if clean_stem(f) and clean_stem(f) not in GENERIC_STEMS}
        a_words = {w.lower() for w in re.split(r'[^a-zA-Z0-9]+', a['name']) if len(w) >= 3}
        a_words |= {w[:-1] for w in list(a_words) if len(w) >= 4 and w.endswith('s')}
        ep_paths = [re.sub(r'^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|mutation|query|dialog|screen|view|cli|ipc|tray|hotkey)\s+', '', ep, flags=re.I).strip()
                    for ep in a['entrypoints']]
        ep_paths = [p for p in ep_paths if len(p) >= 3]
        p_syms = set()
        for f in primary:
            for fn in extract_inventory_functions(f):
                if len(fn['name']) >= 4 and fn['name'].lower() not in GENERIC_LINK_SYMS:
                    p_syms.add(fn['name'])
        area_meta[a['name']] = {
            'primary': primary,
            'p_stems': p_stems,
            's_stems': s_stems,
            'stems': p_stems | a_words,
            'words': a_words | p_stems,
            'ep_paths': ep_paths,
            'syms': p_syms,
        }

    area_tests = defaultdict(list)
    for rel, full in test_files:
        t_stem = clean_stem(rel)
        t_text = read(full)
        scores = {}
        for a in areas:
            aname = a['name']
            meta = area_meta[aname]
            score = 0
            if t_stem and (t_stem in meta['stems'] or any(
                t_stem == s or t_stem.endswith('_' + s) or t_stem.startswith(s + '_') or t_stem.endswith('-' + s) or t_stem.startswith(s + '-')
                for s in meta['stems'] if len(s) >= 4
            )):
                score += 10
            elif t_stem and t_stem in meta['s_stems']:
                score += 8
            for stem in meta['p_stems']:
                if len(stem) >= 4 and re.search(r'(?:from|import|require|/)[\w./-]*\b' + re.escape(stem) + r'\b', t_text, re.I):
                    score += 5
                    break
            if any(ep in t_text for ep in meta['ep_paths']):
                score += 5
            if score > 0:
                scores[aname] = score
        if not scores:
            continue
        top = max(scores.values())
        strong = [aname for aname, sc in scores.items() if sc >= max(6, top - 2)]
        harvested = harvest_file('tests', full, rel)
        if not harvested:
            continue
        if len(strong) == 1 and top >= 10:
            area_tests[strong[0]].extend(harvested)
        else:
            tlines = t_text.splitlines(keepends=True)
            for hline in harvested:
                tname = hline.partition(': ')[2].strip()
                loc = test_body(tlines, tname)
                snippet = (tname + '\n' + ''.join(tlines[loc[0] - 1:loc[1]])) if loc else tname
                best_area, best_hits = None, 0
                for aname in scores:
                    meta = area_meta[aname]
                    hits = sum(4 for ep in meta['ep_paths'] if ep in snippet)
                    hits += sum(2 for s in meta['syms'] if re.search(r'\b' + re.escape(s) + r'\b', snippet))
                    hits += sum(2 for w in meta['words'] if re.search(r'\b' + re.escape(w) + r'\b', tname, re.I))
                    if hits > best_hits:
                        best_hits = hits
                        best_area = aname
                if best_area:
                    area_tests[best_area].append(hline)
                elif len(strong) == 1:
                    area_tests[strong[0]].append(hline)

    area_docs = defaultdict(list)
    doc_heading_areas = defaultdict(set)
    raw_doc_lines = {}
    for a in areas:
        aname = a['name']
        meta = area_meta[aname]
        kw = sorted({w for w in meta['words'] if len(w) >= 3 and w not in GENERIC_STEMS})
        if not kw or not doc_files:
            raw_doc_lines[aname] = []
            continue
        pattern = '|'.join(re.escape(w) for w in kw)
        collected = []
        cur_heading = None
        for rel, full in doc_files:
            for line in harvest_file(pattern, full, rel):
                if ': ## ' in line:
                    cur_heading = line
                    doc_heading_areas[cur_heading].add(aname)
                collected.append((cur_heading, line))
        raw_doc_lines[aname] = collected

    max_shared_areas = max(2, len(areas) // 2)
    for a in areas:
        aname = a['name']
        for heading, line in raw_doc_lines[aname]:
            if heading and len(doc_heading_areas[heading]) > max_shared_areas:
                continue
            area_docs[aname].append(line)

    written = []
    for a in areas:
        aname = a['name']
        dest = os.path.join(expect_dir, aname + '.txt')
        if not force and os.path.isfile(dest) and os.path.getsize(dest) > 0:
            written.append(f'{aname}: kept existing')
            continue
        lines = list(dict.fromkeys(area_tests[aname] + area_docs[aname]))
        with open(dest, 'w') as handle:
            handle.write(('\n'.join(lines) + '\n') if lines else '')
        written.append(f'{aname}: {len(area_tests[aname])} tests, {len(area_docs[aname])} doc lines')
    return written


def write_repair_brief(group_id, feature_names, areas):
    steps = read(os.path.join(skill, 'RECORDERS.md'))
    rep_part = re.search(r'^## Repair features\n.*?(?=^## Rules)', steps, re.S | re.M)
    rules_part = re.search(r'^## Rules\n.*', steps, re.S | re.M)
    manual = read(os.path.join(skill, 'SKILL.md'))
    fail_part = re.search(r'^## When a drive fails\n.*?(?=^## Isolation)', manual, re.S | re.M)

    proj = read(os.path.join(skill, 'PROJECT.md'))
    kept_sections = []
    for sec in re.split(r'(?=^## )', proj, flags=re.M):
        hdr = sec.splitlines()[0].lower() if sec.strip() else ''
        if any(k in hdr for k in ('sign-in', 'timer', 'stub', 'helper', 'gotcha', 'isolation')):
            kept_sections.append(sec.strip())

    parts = [
        f'# Repair brief: {group_id}\n',
        (rep_part.group(0).strip() + '\n\n' + rules_part.group(0).strip()) if (rep_part and rules_part) else steps,
        '\n' + (fail_part.group(0).strip() if fail_part else ''),
        '\n# PROJECT.md (key sections)\n\n' + ('\n\n'.join(kept_sections) if kept_sections else proj.strip()),
    ]
    traps = os.path.join(skill, '.cache', 'traps.txt')
    if os.path.isfile(traps) and os.path.getsize(traps) > 0:
        parts.append('\n# Shared traps (.cache/traps.txt)\n\n' + read(traps).strip())

    all_area_files = [f for a in areas for f in a['files']]
    for feat in feature_names:
        rpath = os.path.join(skill, 'features', feat + '.sh')
        parts.append(f'\n# Feature `{feat}`\n')
        if os.path.isfile(rpath):
            rlines = read(rpath).splitlines(keepends=True)
            parts.append('## Recipe `features/' + feat + '.sh`\n\n```bash\n'
                         + ''.join(f'{i + 1}\t{l}' for i, l in enumerate(rlines)) + '```')
        else:
            rlines = []
            parts.append('(recipe file does not exist yet)')

        ddir = os.path.join(skill, '.cache', 'drive', feat)
        step_file = os.path.join(ddir, 'step')
        failed_step = read(step_file).strip() if os.path.isfile(step_file) else ''
        log_file = os.path.join(ddir, 'log')
        if os.path.isfile(log_file):
            tail = [l[:300] for l in read(log_file).splitlines()[-60:]]
            parts.append(f'## Last drive log (failed step: `{failed_step or "?"}`)\n\n```\n' + '\n'.join(tail) + '\n```')

        edir = os.path.join(skill, '.cache', 'evidence', feat)
        if os.path.isdir(edir):
            ev_files = sorted(os.listdir(edir))
            if ev_files:
                parts.append('Evidence files: ' + ', '.join(ev_files[:20]))
            for ename, limit in (('failure.txt', 60), ('server-errors.txt', 40)):
                ep = os.path.join(edir, ename)
                if os.path.isfile(ep) and os.path.getsize(ep) > 0:
                    el = [l[:260] for l in read(ep).splitlines()[:limit]]
                    parts.append(f'## Evidence `{ename}`\n\n```\n' + '\n'.join(el) + '\n```')

        if failed_step and rlines:
            cited = []
            for rl in rlines:
                if rl.startswith('# expects:') and failed_step in rl:
                    for fp, names in re.findall(r'([\w./-]+\.\w+):\s*([\w.$]+(?:\s*,\s*[\w.$]+)*)', rl):
                        for fn in re.split(r'\s*,\s*', names):
                            if (fp, fn) not in cited:
                                cited.append((fp, fn))
            for fp, fn in cited[:4]:
                resolved = resolve_area_file(fp, all_area_files)
                if not resolved:
                    continue
                slines = read_lines(resolved)
                loc = function(slines, fn.rpartition('.')[2])
                if not loc:
                    continue
                first, last = loc[0], min(loc[1], loc[0] + 150)
                parts.append(f'## Source for failing step, {resolved}: {fn} (lines {first}-{last})\n\n'
                             + ''.join(f'{first + i}\t{l}' for i, l in enumerate(slines[first - 1:last])))

    dest = os.path.join(out, f'{group_id}.md')
    with open(dest, 'w') as handle:
        handle.write('\n\n'.join(parts) + '\n')
    return dest


def feature_area_of(feature, areas):
    best = ''
    for a in areas:
        name = a['name']
        if (feature == name or feature.startswith(name + '-')) and len(name) > len(best):
            best = name
    return best or 'misc'


def failure_summary(feature):
    ddir = os.path.join(skill, '.cache', 'drive', feature)
    step = read(os.path.join(ddir, 'step')).strip() if os.path.isfile(os.path.join(ddir, 'step')) else '?'
    err = read(os.path.join(ddir, 'error')).splitlines()[0][:120] if os.path.isfile(os.path.join(ddir, 'error')) and os.path.getsize(os.path.join(ddir, 'error')) else ''
    return f'{feature} (step "{step}"{": " + err if err else ""})'


def repair_all(explicit_features, areas):
    if explicit_features:
        features = list(dict.fromkeys(explicit_features))
    else:
        failed_file = os.path.join(skill, '.cache', 'all', 'failed')
        if not os.path.isfile(failed_file):
            print('no .cache/all/failed file and no features passed')
            return
        features = [l.strip() for l in read(failed_file).splitlines() if l.strip()]
    if not features:
        print('no failing features to repair')
        return
    by_area = defaultdict(list)
    for f in features:
        by_area[feature_area_of(f, areas)].append(f)
    batches = []
    for area_name in sorted(by_area):
        items = sorted(by_area[area_name])
        for i in range(0, len(items), GROUP_MAX_FEATURES):
            batches.append(items[i:i + GROUP_MAX_FEATURES])
    results_dir = os.path.join(skill, '.cache', 'results')
    os.makedirs(results_dir, exist_ok=True)
    for old in glob.glob(os.path.join(out, 'repair.*.md')):
        os.remove(old)
    print(f'{len(batches)} repair briefs written in {out} (stale result files cleared):')
    for idx, batch in enumerate(batches, 1):
        gid = f'repair.{idx}'
        stale = os.path.join(results_dir, f'{gid}.txt')
        if os.path.isfile(stale):
            os.remove(stale)
        write_repair_brief(gid, batch, areas)
        details = '; '.join(failure_summary(f) for f in batch)
        print(f'  {gid}: {details}')


def collect_results(filter_areas, areas):
    plan_dir = os.path.join(skill, '.cache', 'plan')
    results_dir = os.path.join(skill, '.cache', 'results')
    area_names = filter_areas or [a['name'] for a in areas]
    expected_groups = defaultdict(list)
    for area_name in area_names:
        for p in sorted(glob.glob(os.path.join(plan_dir, f'{area_name}.*.txt'))):
            if p.endswith('.map.txt'):
                continue
            expected_groups[area_name].append(os.path.basename(p)[:-4])

    done_ids, pending_ids, completed_areas = [], [], []
    for area_name in area_names:
        gids = expected_groups[area_name]
        if not gids:
            continue
        area_done = True
        for gid in gids:
            if os.path.isfile(os.path.join(results_dir, f'{gid}.txt')):
                done_ids.append(gid)
            else:
                pending_ids.append(gid)
                area_done = False
        if area_done:
            completed_areas.append(area_name)

    repair_results = sorted(
        os.path.basename(p)[:-4]
        for p in glob.glob(os.path.join(results_dir, 'repair.*.txt'))
    )
    print(f'== progress: {len(done_ids)}/{len(done_ids) + len(pending_ids)} recorder groups finished; {len(repair_results)} repair results')
    if pending_ids:
        print('still running: ' + ', '.join(pending_ids))

    traps, defects, dead_code, timers = [], [], [], []
    all_result_ids = done_ids + repair_results
    if all_result_ids:
        print('\n== results')
        for gid in all_result_ids:
            rpath = os.path.join(results_dir, f'{gid}.txt')
            lines = [l.strip() for l in read(rpath).splitlines() if l.strip()]
            print(f'[{gid}]')
            for l in lines:
                print('  ' + l)
                low = l.lower()
                if low.startswith('trap:'):
                    traps.append(l)
                elif 'product defect:' in low:
                    defects.append(f'{gid}: {l}')
                elif low.startswith('dead code:'):
                    dead_code.append(l)
                elif low.startswith('timer:'):
                    timers.append(l)

    if completed_areas:
        print('\n== uncovered (completed areas only)')
        for area_name in completed_areas:
            proc = subprocess.run([os.path.join(skill, 'bin', 'verify'), 'uncovered', area_name], capture_output=True, text=True)
            out_lines = [l for l in proc.stdout.splitlines() if l.strip()]
            has_issue = any(l.startswith(('Not covered', 'Marked not driven')) for l in out_lines)
            if not has_issue:
                head = out_lines[0] if out_lines else 'clean'
                print(f'  {area_name}: clean ({head})')
            else:
                print(f'  {area_name}:')
                for l in out_lines:
                    print('    ' + l)

    for label, items in (('traps', traps), ('product defects', defects), ('dead code', dead_code), ('timers', timers)):
        uniq = list(dict.fromkeys(items))
        if uniq:
            print(f'\n== {label} ({len(uniq)})')
            for item in uniq:
                print('  ' + item)


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit('usage: brief --harvest [--force] | brief --plan [<area>...] | brief <area> [<example>] | brief --all <example> | brief --repair <id> <feature>... | brief --repair-all [<feature>...] | brief --collect [<area>...]')
    areas = parse_areas()
    file_owners = area_file_counts(areas)

    if args[0] == '--harvest':
        force = '--force' in args[1:]
        summary = auto_harvest(areas, file_owners, force=force)
        print(f'harvested expectations for {len(summary)} areas:')
        for line in summary:
            print(f'  {line}')
        return

    if args[0] == '--repair':
        if len(args) < 3:
            sys.exit('usage: brief --repair <group-id> <feature>...')
        dest = write_repair_brief(args[1], args[2:], areas)
        print(f'repair brief written: {dest}')
        return

    if args[0] == '--repair-all':
        repair_all(args[1:], areas)
        return

    if args[0] == '--collect':
        collect_results(args[1:], areas)
        return

    if args[0] == '--plan':
        targets = args[1:] or [a['name'] for a in areas]
        written = [write_plan_brief(a, areas, file_owners) for a in targets]
        print(f'{len(written)} plan briefs written in {out}: ' + ', '.join(os.path.basename(p) for p in written))
        return

    if args[0] == '--all':
        if len(args) != 2:
            sys.exit('usage: brief --all <example>')
        example = args[1]
        write_common(example)
        all_groups = []
        for a in areas:
            map_path = os.path.join(skill, '.cache', 'plan', a['name'] + '.map.txt')
            if not os.path.isfile(map_path):
                continue
            features, _, problems = validate_map(a['name'], areas, file_owners)
            if problems:
                print(f'area {a["name"]} has {len(problems)} plan issues:')
                for p in problems:
                    print(f'  {p}')
            all_groups.extend(build_group_briefs_from_map(a['name'], a, features))
        all_groups.sort(key=lambda x: -x[0])
        print(f'{len(all_groups)} briefs and common.md in {out} (heaviest first):')
        for _, line in all_groups:
            print(f'  {line}')
        return

    if len(args) not in (1, 2):
        sys.exit('usage: brief <area> [<example>]')
    area_name = args[0]
    example = args[1] if len(args) == 2 else ''
    info = next((a for a in areas if a['name'] == area_name), None)
    if not info:
        sys.exit(f'brief: no area {area_name!r} in .cache/areas.txt')

    features, _, problems = validate_map(area_name, areas, file_owners)
    if features is not None:
        if problems:
            print(f'The feature map of {area_name} has {len(problems)} issues to fix:')
            for p in problems:
                print(f'  {p}')
        else:
            print(f'The feature map of {area_name} is complete ({len(features)} features).')
        if not example:
            sys.exit(1 if problems else 0)
        write_common(example)
        groups = build_group_briefs_from_map(area_name, info, features)
        print(f'{len(groups)} briefs and common.md in {out} (heaviest first):')
        for _, line in groups:
            print(f'  {line}')
        return

    if not os.path.isfile(os.path.join(skill, '.cache', 'behaviors', area_name + '.txt')):
        sys.exit(f'brief: write .cache/plan/{area_name}.map.txt first (run `brief --plan {area_name}` for the inventory)')
    own = legacy_uncited(area_name, areas)
    if own:
        print(f'The behaviors file of {area_name} does not cite these {len(own)} items:')
        for item in own:
            print(f'  {item}')
    else:
        print(f'The behaviors file of {area_name} cites every expectation line, entry point and action of its own.')


if __name__ == '__main__':
    main()
