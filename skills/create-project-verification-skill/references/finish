#!/usr/bin/env bash
# finish <feature> ...: a recorder's closing checks in one call. It lints the features, drives them once together
# with three features other recorders have reported passed, and lists what each feature's area still leaves
# uncovered. It exits 1 when one of the named features does not pass. Shipped by create-project-verification-skill.
set -uo pipefail
skill=$(cd "$(dirname "$0")/.." && pwd)
(($#)) || { echo "usage: finish <feature> ..." >&2; exit 2; }
cache=$skill/.cache

echo "== lint"
"$skill/bin/verify" lint "$@" 2>&1 | tail -n 20

others=()
while read -r feature; do
  [[ " $* " == *" $feature "* || ! -f "$skill/features/$feature.sh" ]] && continue
  others+=("$feature")
  ((${#others[@]} == 3)) && break
done < <(sed -n 's/^\([a-z0-9-]*\): passed.*/\1/p' "$cache"/results/*.txt 2> /dev/null | shuf)

echo "== drive with ${others[*]:-no other feature yet}"
out=$("$skill/bin/verify" "$@" "${others[@]}" 2>&1)
status=0
summary=$(sed -n '/^Summary/,$p' <<< "$out")
[[ -n "$summary" ]] || summary=$(tail -n 15 <<< "$out")
while IFS= read -r line; do
  feature=${line%%:*}
  if [[ " $* " == *" $feature "* ]]; then
    echo "$line"
    [[ "$line" == "$feature: pass"* || "$line" == "$feature: known failure"* ]] || status=1
  elif [[ " ${others[*]} " == *" $feature "* ]]; then
    [[ "$line" == "$feature: pass"* ]] || echo "(another recorder's) $line"
  elif [[ "$line" != Evidence:* ]]; then
    echo "$line"
  fi
done <<< "$summary"

areas=()
for feature in "$@"; do
  area=$(cut -d: -f1 "$cache/areas.txt" | awk -v f="$feature" 'index(f, $0 "-") == 1 && length($0) > length(best) { best = $0 } END { print best }')
  [[ -n "$area" && " ${areas[*]} " != *" $area "* ]] && areas+=("$area")
done
# An action in a file another area lists too is shown apart: it is the recorder's only behind its own entry points.
for area in "${areas[@]}"; do
  echo "== uncovered $area"
  shared=$(grep -v "^$area:" "$cache/areas.txt" | sed 's/.*files://' | tr ' ' '\n' | sort -u)
  theirs=()
  while IFS= read -r line; do
    file=$(sed -n 's/^  action: .* (\(.*\))$/\1/p' <<< "$line")
    if [[ -n "$file" ]] && grep -qxF "$file" <<< "$shared"; then
      theirs+=("$(sed 's/^  action: \(.*\) (.*)$/\1/' <<< "$line")")
    else
      echo "$line"
    fi
  done < <("$skill/bin/verify" uncovered "$area" 2>&1)
  ((${#theirs[@]})) && echo "  In files another area lists too, yours only behind your own entry points: $(IFS=,; echo "${theirs[*]}")"
done
exit $status
