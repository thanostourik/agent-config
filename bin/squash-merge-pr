#!/bin/bash
# squash-merge-pr [PR number or URL]: squash merge the PR for the current branch into
# its base branch, update the local base branch, point open PRs based on the PR's branch
# at that base, and delete the PR's local and remote branches. In a linked worktree it
# also removes that worktree. Stops at the first failed command or unmet
# check, and says which step it was and whether the PR was already merged.

set -euo pipefail

# gh colors --json output when CLICOLOR_FORCE is set, even if NO_COLOR is set and
# stdout is a pipe. jq then rejects the escape codes. A caller such as Grok exports
# CLICOLOR_FORCE, so turn color off for every gh call this script makes.
unset GH_FORCE_TTY
export CLICOLOR_FORCE=0
export NO_COLOR=1

current_step=starting
merged=no
body_file=$(mktemp)

step() {
  current_step=$1
  echo "==> $1"
}

die() {
  echo "squash-merge-pr: $*" >&2
  exit 1
}

finish() {
  status=$?
  rm -f "$body_file"
  if [ "$status" -ne 0 ]; then
    echo "squash-merge-pr: stopped while: $current_step (PR merged: $merged)" >&2
  fi
}
trap finish EXIT

field() {
  jq -r ".$1" <<< "$pr"
}

step "checking the working tree"
[ -z "$(git status --porcelain)" ] || die "there is uncommitted work"
worktree=$(git rev-parse --show-toplevel)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
linked=no
[ "$(git rev-parse --path-format=absolute --git-dir)" = "$common_dir" ] || linked=yes

step "reading the PR"
repo=$(gh repo view "$(git remote get-url origin)" --json nameWithOwner --jq .nameWithOwner)
fields=url,number,title,body,state,baseRefName,headRefName,headRefOid,isCrossRepository,isDraft,mergeable,mergeStateStatus,statusCheckRollup
selector=${1:-$(git branch --show-current)}
[ -n "$selector" ] || die "no PR given and HEAD is not on a branch"
# GitHub reports UNKNOWN while it is still computing mergeability, e.g. right after a push.
for _ in 1 2 3 4 5; do
  pr=$(gh pr view "$selector" --repo "$repo" --json "$fields")
  # Outside a conditional, so a payload jq cannot parse stops this step.
  mergeable=$(jq -er .mergeable <<< "$pr")
  [ "$mergeable" != UNKNOWN ] && break
  sleep 2
done

step "checking the PR"
url=$(field url)
number=$(field number)
branch=$(field headRefName)
head=$(field headRefOid)
base=$(field baseRefName)
stack=$(gh api "repos/$repo/pulls/$number" --jq '.stack // empty')
[ "$(field state)" = OPEN ] || die "$url is not open"
if [ -n "$stack" ]; then
  [ "$base" = "$(jq -r .base.ref <<< "$stack")" ] || die "$url is stacked on $base; merge the PRs below it first: ${url%/pull/*}/stack/$(jq -r .number <<< "$stack")"
fi
[ "$(field isCrossRepository)" = false ] || die "$url is from a fork"
[ "$(field isDraft)" = false ] || die "$url is a draft"
[[ $url == */"$repo"/pull/* ]] || die "$url does not belong to origin ($repo)"
[ "$branch" != main ] || die "the PR's head branch is main"
base_worktree=$(git worktree list --porcelain | awk -v ref="branch refs/heads/$base" '/^worktree /{path = substr($0, 10)} $0 == ref {print path; exit}')
[ "$linked" = yes ] || [ -z "$base_worktree" ] || die "$base is checked out in $base_worktree, so this checkout cannot switch to it"
[ "$(git branch --show-current)" = "$branch" ] || die "the current branch is not the PR's head branch ($branch)"
[ "$(git rev-parse HEAD)" = "$head" ] || die "the local branch is not at the PR's head commit $head"
[ "$(field mergeable)" = MERGEABLE ] || die "$url is not mergeable (mergeable: $(field mergeable))"
unfinished=$(field statusCheckRollup | jq -r '(. // [])[]
  | select((.status // "COMPLETED") != "COMPLETED" or ((.conclusion // .state) | IN("SUCCESS", "NEUTRAL", "SKIPPED") | not))
  | "\(.name // .context): \(.conclusion // .state // .status)"')
[ -z "$unfinished" ] || die $'checks are pending or failing:\n'"$unfinished"
case $(field mergeStateStatus) in
  CLEAN | HAS_HOOKS) ;;
  *) die "$url cannot be merged yet (merge state: $(field mergeStateStatus))" ;;
esac

# The Verification section is a snapshot of the PR and goes stale on main. It runs from
# its heading to the next heading (headings inside code fences do not count). A final
# "Filed by " paragraph stays.
step "preparing the commit message"
subject="$(field title) (#$number)"
field body | awk '
  /^```/ { fence = !fence }
  !fence && /^#/ { skip = /^## Verification[ \t\r]*$/ }
  skip && /^Filed by / { skip = 0; if (last != "") print "" }
  !skip { print; last = $0 }
' > "$body_file"

step "merging the PR"
merged="unknown, check the PR"
if [ -z "$stack" ]; then
  gh pr merge "$url" --repo "$repo" --squash --match-head-commit "$head" --subject "$subject" --body-file "$body_file"
else
  # GitHub merges a stacked PR only through its asynchronous merge API.
  result=$(jq -n --arg sha "$head" --arg title "$subject" --rawfile body "$body_file" \
    '{merge_method: "squash", sha: $sha, commit_title: $title, commit_message: ($body | sub("\n+$"; ""))}' \
    | gh api --method PUT "repos/$repo/pulls/$number/merge-async" --input -)
  uuid=$(jq -r .details.uuid <<< "$result")
  for _ in $(seq 150); do
    [ "$(jq -r .status <<< "$result")" = pending ] || break
    sleep 2
    result=$(gh api "repos/$repo/pulls/$number/merge-async/$uuid")
  done
  [ "$(jq -r .status <<< "$result")" = merged ] || die "GitHub did not merge the PR ($(jq -r '.status + ": " + .details.message' <<< "$result"))"
fi

step "confirming the merge"
pr=$(gh pr view "$url" --repo "$repo" --json state,mergeCommit)
if [ "$(field state)" != MERGED ]; then
  merged=no
  die "GitHub has not finished the merge (state: $(field state)); main and the branches are untouched"
fi
merged=yes
merge_commit=$(field mergeCommit.oid)

step "updating $base"
if [ -n "$base_worktree" ]; then
  git -C "$base_worktree" pull --ff-only origin "$base"
else
  git fetch origin "$base:$base"
fi
[ "$linked" = yes ] || git switch "$base"
[ "$(git rev-parse "refs/heads/$base")" = "$(git rev-parse "refs/remotes/origin/$base")" ] || die "local $base differs from origin/$base"
git merge-base --is-ancestor "$merge_commit" "refs/heads/$base" || die "$base does not contain the merge commit $merge_commit"

# GitHub closes an open PR whose base branch is deleted.
step "pointing the PRs based on $branch at $base"
retargeted=$(gh pr list --repo "$repo" --base "$branch" --state open --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"')
for dependent in $(cut -d ' ' -f 1 <<< "$retargeted"); do
  gh pr edit "$dependent" --repo "$repo" --base "$base"
done

step "deleting the PR branches"
remote_sha=$(git ls-remote --heads origin "refs/heads/$branch" | cut -f1)
local_sha=$(git rev-parse --verify --quiet "refs/heads/$branch" || true)
for sha in "$remote_sha" "$local_sha"; do
  [ -z "$sha" ] || [ "$sha" = "$head" ] || die "$branch no longer points to the PR's head commit $head; not deleting it"
done
[ -z "$remote_sha" ] || git push origin --delete "$branch"
if [ "$linked" = yes ]; then
  # Leave the worktree first: it is about to be deleted, and it holds the branch checked out.
  cd "$common_dir/.."
  git worktree remove "$worktree"
fi
# -D because squash merging leaves the branch's commits out of main's history.
[ -z "$local_sha" ] || git branch -D "$branch"

step "verifying the result"
[ -z "$(git ls-remote --heads origin "refs/heads/$branch")" ] || die "the remote branch $branch still exists"
git rev-parse --verify --quiet "refs/heads/$branch" > /dev/null && die "the local branch $branch still exists"
if [ "$linked" = yes ]; then
  [ ! -e "$worktree" ] || die "the worktree $worktree still exists"
else
  [ "$(git branch --show-current)" = "$base" ] || die "the current branch is not $base"
  [ -z "$(git status --porcelain)" ] || die "the working tree is not clean"
fi

removed=
[ "$linked" = no ] || removed=" The worktree $worktree is removed."
echo "Merged $url as $merge_commit. Local $base is up to date; $branch is deleted locally and on origin.$removed"
if [ -n "$stack" ] && [ "$(jq '.size > .position' <<< "$stack")" = true ]; then
  echo "GitHub rebased the stacked PRs above it. In a checkout of one of them, update their local branches with: gh stack sync"
fi
while read -r dependent dependent_branch; do
  [ -n "$dependent" ] || continue
  echo "PR #$dependent now targets $base. In the checkout of $dependent_branch, drop $branch's commits from it with: git fetch origin && git rebase --onto origin/$base $head && git push --force-with-lease"
done <<< "$retargeted"
