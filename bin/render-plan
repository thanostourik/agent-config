#!/bin/bash
# render-plan: turn a .plans/*.md file into a styled .html next to it, upload it
# to Postplan, and print both links.
#
#   render-plan <plan.md>   render and publish one plan
#   render-plan --hook      read an agent hook event (JSON) on stdin and render
#                           every .plans/*.md path in it; always exits 0
#
# Needs npx. Log in once with `npx postplan auth login`. Uploading the same
# file again updates the same draft, so the URL does not change.
set -u

render() {
  local md=$1 html=${1%.md}.html title body
  title=$(sed -n 's/^# //p;T;q' "$md")
  body=$(npx -y marked --gfm < "$md") || return
  cat > "$html" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${title:-$(basename "$md" .md)}</title>
<style>
:root { color-scheme: light dark; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6; max-width: 52rem; margin: 0 auto; padding: 2rem 1.5rem 6rem;
  color: #1f2328; background: #ffffff;
}
h1, h2, h3, h4 { line-height: 1.25; margin-top: 2em; }
h1 { font-size: 1.9rem; border-bottom: 1px solid #d1d9e0; padding-bottom: .4rem; margin-top: .5em; }
h2 { font-size: 1.4rem; border-bottom: 1px solid #d1d9e0; padding-bottom: .3rem; }
h3 { font-size: 1.15rem; }
a { color: #0969da; }
code, pre {
  font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, monospace;
  font-size: .875em;
}
code { background: #eff1f3; padding: .15em .35em; border-radius: 4px; }
pre { background: #f6f8fa; padding: 1rem; border-radius: 8px; overflow-x: auto; }
pre code { background: none; padding: 0; }
blockquote { border-left: 4px solid #d1d9e0; margin-left: 0; padding-left: 1rem; color: #59636e; }
table { border-collapse: collapse; margin: 1rem 0; display: block; overflow-x: auto; }
th, td { border: 1px solid #d1d9e0; padding: .4rem .8rem; text-align: left; }
th { background: #f6f8fa; }
tr:nth-child(2n) { background: #f6f8fa; }
li { margin: .25em 0; }
input[type=checkbox] { margin-right: .5em; }
hr { border: none; border-top: 1px solid #d1d9e0; margin: 2rem 0; }
@media (prefers-color-scheme: dark) {
  body { color: #e6edf3; background: #0d1117; }
  h1, h2 { border-color: #30363d; }
  a { color: #4493f8; }
  code { background: #22272e; }
  pre { background: #161b22; }
  blockquote { border-color: #30363d; color: #9198a1; }
  th, td { border-color: #30363d; }
  th, tr:nth-child(2n) { background: #161b22; }
  hr { border-color: #30363d; }
}
</style>
</head>
<body>
${body}
</body>
</html>
HTML
  echo "Plan rendered: file://$(readlink -f "$html")"
  local url
  url=$(npx -y postplan upload "$html" 2>/dev/null | sed -n 's/^URL: //p')
  if [ -z "$url" ]; then
    echo "Postplan upload failed. Run: npx postplan auth login" >&2
    return
  fi
  echo "Plan published: $url"
}

if [ "${1:-}" != "--hook" ]; then
  [ -f "${1:-}" ] || { echo "usage: render-plan <plan.md> | render-plan --hook" >&2; exit 1; }
  render "$1"
  exit
fi

event=$(cat)
# Hook events differ per tool, so take every .plans/*.md path in the JSON and
# resolve relative ones against the session directory.
cwd=$(jq -r '.cwd // .workspace_roots[0] // empty' <<< "$event" 2>/dev/null)
paths=$(sed 's/\\\//\//g' <<< "$event" | grep -oE '[^"[:space:]]*\.plans/[^"[:space:]]*\.md' | sort -u)
output=$(for p in $paths; do
  [[ $p = /* ]] || p=${cwd:-$PWD}/$p
  [ -f "$p" ] && render "$p"
done)
[ -n "$output" ] || exit 0
# Claude Code and Codex put this JSON's additionalContext in front of the agent.
jq -n --arg text "$output" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $text}}'
exit 0
