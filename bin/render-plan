#!/bin/bash
# render-plan — render a .plans/*.md plan to a styled, self-contained .html next to it.
#
# Usage:
#   render-plan <plan.md>     render one file, print the file:// link
#   render-plan --hook        agent-hook mode: reads a PostToolUse JSON event on
#                             stdin (Claude Code / grok / codex — shape-agnostic),
#                             renders any .plans/**.md paths found in it.
#                             Always exits 0 so a miss never breaks the tool call.
#
# Rendering uses the `marked` CLI (npm i -g marked); CSS is embedded below so
# the .html is a single self-contained file.
set -u

find_marked() {
  command -v marked && return
  ls "$HOME"/.nvm/versions/node/*/bin/marked 2>/dev/null | sort -V | tail -1
}

render() {
  local md=$1
  [ -f "$md" ] || return 0
  local MARKED; MARKED=$(find_marked)
  if [ -z "$MARKED" ]; then echo "render-plan: marked not found (npm i -g marked)" >&2; return 1; fi
  local html="${md%.md}.html"
  local title
  title=$(grep -m1 '^# ' "$md" | sed 's/^# //') || true
  [ -n "$title" ] || title=$(basename "$md" .md)
  local body
  body=$("$MARKED" --gfm < "$md") || return 1
  cat > "$html" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${title}</title>
<style>
:root { color-scheme: light dark; }
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6; max-width: 52rem; margin: 0 auto; padding: 2rem 1.5rem 6rem;
  color: #1f2328; background: #ffffff;
}
h1, h2, h3, h4 { line-height: 1.25; margin-top: 2em; }
h1 { font-size: 1.9rem; border-bottom: 1px solid #d1d9e0; padding-bottom: .4rem; margin-top: .5em; }
h2 { font-size: 1.4rem; border-bottom: 1px solid #d1d9e0; padding-bottom: .3rem; }
h3 { font-size: 1.15rem; }
a { color: #0969da; }
code, pre {
  font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, monospace;
  font-size: .875em;
}
code { background: #eff1f3; padding: .15em .35em; border-radius: 4px; }
pre { background: #f6f8fa; padding: 1rem; border-radius: 8px; overflow-x: auto; }
pre code { background: none; padding: 0; }
blockquote { border-left: 4px solid #d1d9e0; margin-left: 0; padding-left: 1rem; color: #59636e; }
table { border-collapse: collapse; margin: 1rem 0; display: block; overflow-x: auto; }
th, td { border: 1px solid #d1d9e0; padding: .4rem .8rem; text-align: left; }
th { background: #f6f8fa; }
tr:nth-child(2n) { background: #f6f8fa; }
li { margin: .25em 0; }
input[type=checkbox] { margin-right: .5em; }
hr { border: none; border-top: 1px solid #d1d9e0; margin: 2rem 0; }
@media (prefers-color-scheme: dark) {
  body { color: #e6edf3; background: #0d1117; }
  h1, h2 { border-color: #30363d; }
  a { color: #4493f8; }
  code { background: #22272e; }
  pre { background: #161b22; }
  blockquote { border-color: #30363d; color: #9198a1; }
  th, td { border-color: #30363d; }
  th, tr:nth-child(2n) { background: #161b22; }
  hr { border-color: #30363d; }
}
</style>
</head>
<body>
${body}
</body>
</html>
EOF
  echo "Plan rendered: file://$(readlink -f "$html")"
}

if [ "${1:-}" = "--hook" ]; then
  input=$(cat)
  # cwd of the agent session, for resolving relative paths (field name varies by harness)
  cwd=$(printf '%s' "$input" | jq -r '.cwd // .workspaceRoot // empty' 2>/dev/null)
  [ -n "$cwd" ] || cwd=${CLAUDE_PROJECT_DIR:-${GROK_WORKSPACE_ROOT:-$PWD}}
  # Shape-agnostic: pull anything that looks like a .plans/**.md path out of the event
  printf '%s' "$input" | sed 's/\\\//\//g' \
    | grep -oE '[^"[:space:]]*\.plans/[^"[:space:]]*\.md' | sort -u \
    | while read -r p; do
        case "$p" in /*) render "$p" ;; *) render "$cwd/$p" ;; esac
      done
  exit 0
fi

if [ $# -eq 1 ] && [ -f "$1" ]; then
  render "$1"
else
  echo "usage: render-plan <plan.md> | render-plan --hook" >&2
  exit 1
fi
