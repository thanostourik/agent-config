#!/bin/sh
# Start mcp-atlassian for one Jira URL. Username and password come from the
# Bitwarden login whose URI is that URL. Sync writes this command into each
# tool's MCP config. The URL is the first argument, and --gate is optional.
# With --unlock instead of a URL it only starts and unlocks the agent, then
# exits. Sync installs a login
# autostart entry that runs it, so the first Jira thread finds the vault open.
#
# --gate is temporary. Apache in front of Jira keeps Authorization and deletes
# it, so Jira never sees a basic-auth login. The flag starts jira-gate-proxy
# and points mcp-atlassian at it. The Apache username and password are the
# Bitwarden login whose URI is the Jira URL plus /basic-auth-gate. Drop the
# flag to send the Jira password directly again.
#
# The unlocked vault lives in one `bw serve` agent, the systemd user unit
# bw-agent, on a socket in XDG_RUNTIME_DIR. Only the first start asks for the
# master password, and later lookups take milliseconds instead of bw's
# seconds-long startup. `systemctl --user stop bw-agent` locks it again.
set -eu

unlock_only=0
gate=0
url=""
if [ "${1:-}" = "--unlock" ]; then
  unlock_only=1
elif [ "${1:-}" = "" ]; then
  echo "usage: mcp-atlassian-start <jira-url> [--gate] | --unlock" >&2
  exit 1
else
  url=$1
  if [ "${2:-}" = "--gate" ]; then
    gate=1
  elif [ -n "${2:-}" ]; then
    echo "usage: mcp-atlassian-start <jira-url> [--gate] | --unlock" >&2
    exit 1
  fi
fi

uid=$(id -u)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$uid}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export DISPLAY="${DISPLAY:-:0}"
export PATH="${HOME}/.local/bin:/usr/bin:/bin:${PATH}"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "mcp-atlassian-start: $1 is not on PATH" >&2
    exit 1
  }
}
need bw
need zenity
need uvx
need python3
need flock
need systemd-run
need systemctl

sock="${XDG_RUNTIME_DIR}/bw-agent.sock"

# Client for the agent's HTTP API. Commands: status, unlock (password on
# stdin), login <url> (prints shell assignments for user and token).
client='
import http.client, json, shlex, socket, sys, urllib.parse

class Agent(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(sys.argv[1])

def call(method, path, body=None):
    # bw serve accepts only this Host header, even on a unix socket.
    conn = Agent("localhost:8087")
    conn.request(method, path, body, {"Content-Type": "application/json"})
    return json.loads(conn.getresponse().read())

def item(needle):
    return call("GET", "/object/item/" + urllib.parse.quote(needle, safe=""))

def uris_of(data):
    login = (data or {}).get("login") or {}
    found = []
    for entry in login.get("uris") or []:
        uri = entry.get("uri") if isinstance(entry, dict) else entry
        if uri:
            found.append(uri)
    return found

def norm(value):
    return value.strip().rstrip("/").lower()

def exact_uri(data, needle):
    want = norm(needle)
    return any(norm(uri) == want for uri in uris_of(data))

def host_only(data, host):
    for uri in uris_of(data):
        parsed = urllib.parse.urlsplit(uri if "://" in uri else "https://" + uri)
        if (parsed.hostname or "").lower() == host.lower() and (parsed.path or "").rstrip("/") == "":
            return True
    return False

def result_ids(res):
    data = res.get("data")
    if not isinstance(data, list):
        return []
    ids = []
    for entry in data:
        if isinstance(entry, str):
            ids.append(entry)
        elif isinstance(entry, dict) and entry.get("id"):
            ids.append(entry["id"])
    return ids

# Bitwarden treats the query as a substring of the URI, so the gate login also
# matches the Jira URL. Keep the item whose URI is the whole query.
def pick(res, needle, allow_host):
    if res.get("success") and exact_uri(res.get("data"), needle):
        return res["data"]
    candidates = [res["data"]] if res.get("success") else []
    for ident in result_ids(res):
        one = item(ident)
        if one.get("success"):
            candidates.append(one["data"])
    for data in candidates:
        if exact_uri(data, needle):
            return data
    if not allow_host:
        return None
    host = urllib.parse.urlsplit(needle).hostname or needle
    for data in candidates:
        if host_only(data, host):
            return data
    return None

def missed(res):
    message = res.get("message") or ""
    return res.get("success") or message == "Not found." or message.startswith("More than one result")

command = sys.argv[2]
if command == "status":
    print(call("GET", "/status")["data"]["template"]["status"])
elif command == "unlock":
    res = call("POST", "/unlock", json.dumps({"password": sys.stdin.read()}))
    sys.exit(0 if res.get("success") else 1)
elif command == "sync":
    res = call("POST", "/sync", "{}")
    if not res.get("success"):
        sys.exit(res.get("message") or "Bitwarden sync failed.")
elif command == "login":
    url = sys.argv[3]
    exact = len(sys.argv) > 4 and sys.argv[4] == "exact"
    res = item(url)
    data = pick(res, url, allow_host=not exact)
    host = urllib.parse.urlsplit(url).netloc
    if data is None and not exact and host and host != url and missed(res):
        res = item(host)
        data = pick(res, host, allow_host=True)
    if data is None:
        message = res.get("message") or "Bitwarden lookup failed."
        if missed(res):
            message = f"Bitwarden has no login for {url}. The login URI must match this URL."
        sys.exit(message)
    login = data.get("login") or {}
    user = login.get("username") or ""
    token = login.get("password") or ""
    if not user or not token:
        sys.exit("Bitwarden login for this URL has no username or password.")
    print("user=" + shlex.quote(user))
    print("token=" + shlex.quote(token))
'

agent() {
  python3 -c "$client" "$sock" "$@"
}

agent_status() {
  agent status 2>/dev/null || true
}

start_agent() {
  systemctl --user stop bw-agent.service >/dev/null 2>&1 || true
  rm -f "$sock"
  systemd-run --user --quiet --collect --unit=bw-agent --setenv=PATH="$PATH" \
    bw --nointeraction serve --hostname "unix://$sock"
  tries=0
  while [ "$tries" -lt 50 ]; do
    status=$(agent_status)
    [ -n "$status" ] && return
    sleep 0.2
    tries=$((tries + 1))
  done
  echo "Bitwarden agent did not start. See: journalctl --user -u bw-agent" >&2
  exit 1
}

unlock() {
  text='Same password that unlocks the Bitwarden app.
NOT Client ID. NOT Client Secret. NOT Jira.'
  while :; do
    pw=$(zenity --password --title='Bitwarden master password' --text="$text") || pw=""
    if [ -z "$pw" ]; then
      echo "Bitwarden unlock was cancelled." >&2
      exit 1
    fi
    if printf %s "$pw" | agent unlock; then
      unset pw
      return
    fi
    unset pw
    if [ "$(agent_status)" != locked ]; then
      echo "Bitwarden agent stopped while unlocking. Retry." >&2
      exit 1
    fi
    text='Wrong master password. Try again.'
  done
}

# The agent serves its last sync. A login added in the Bitwarden app is
# invisible until the next one, so a miss is tried again after a sync.
login_for() {
  err=$(mktemp)
  if creds=$("$@" 2>"$err"); then
    rm -f "$err"
    printf '%s\n' "$creds"
    return 0
  fi
  agent sync
  if creds=$("$@" 2>"$err"); then
    rm -f "$err"
    printf '%s\n' "$creds"
    return 0
  fi
  cat "$err" >&2
  rm -f "$err"
  return 1
}

start_gate() {
  gate_url=${url%/}/basic-auth-gate
  gate_creds=$(login_for agent login "$gate_url" exact)
  eval "$gate_creds"
  export JIRA_UPSTREAM=$url
  export JIRA_GATE_USERNAME=$user
  export JIRA_GATE_PASSWORD=$token
  unset user token
  portfile=$(mktemp)
  "$(dirname "$0")/jira-gate-proxy" "$portfile" &
  proxy_pid=$!
  tries=0
  while [ ! -s "$portfile" ]; do
    if ! kill -0 "$proxy_pid" 2>/dev/null; then
      wait "$proxy_pid" || true
      rm -f "$portfile"
      echo "jira-gate-proxy exited before it was ready." >&2
      exit 1
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 150 ]; then
      kill "$proxy_pid" 2>/dev/null || true
      rm -f "$portfile"
      echo "jira-gate-proxy did not become ready." >&2
      exit 1
    fi
    sleep 0.2
  done
  port=$(cat "$portfile")
  rm -f "$portfile"
  unset JIRA_UPSTREAM JIRA_GATE_USERNAME JIRA_GATE_PASSWORD
  export JIRA_URL="http://127.0.0.1:${port}"
}

# One start or unlock at a time, so parallel sessions show one password window.
exec 9>"${XDG_RUNTIME_DIR}/bw-agent.lock"
flock 9
status=$(agent_status)
[ -n "$status" ] || start_agent
case $status in
  unauthenticated)
    echo "Bitwarden CLI is not logged in. Run bw login in a normal terminal, then retry." >&2
    exit 1
    ;;
  locked)
    unlock
    ;;
esac
exec 9>&-
if [ "$unlock_only" = 1 ]; then
  exit 0
fi

creds=$(login_for agent login "$url")
eval "$creds"
jira_user=$user
jira_token=$token
unset user token

export JIRA_USERNAME=$jira_user
export JIRA_API_TOKEN=$jira_token
unset READ_ONLY_MODE jira_user jira_token

if [ "$gate" = 1 ]; then
  start_gate
else
  export JIRA_URL=$url
fi

exec uvx mcp-atlassian
