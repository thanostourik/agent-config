#!/usr/bin/env python3
"""Connect a coding tool over stdio to a persistent, sandboxed mcp-atlassian.

Credentials come from Bitwarden once per desktop session and are cached in RAM
by jira-cred-agent (systemd user unit) on a private 0600 Unix socket. Bitwarden
is locked again immediately after fetching only the configured Jira and gate
logins, so the rest of the vault is never exposed to agents.

Each configured Jira instance runs as one persistent systemd user unit
(jira-mcp-<hash>) hosting a version-pinned mcp-atlassian inside a bwrap sandbox
over Streamable HTTP on 127.0.0.1 with a random per-session secret path stored
in a 0600 state file. Normal thread starts bridge stdio to that warm daemon in
milliseconds instead of booting Python and FastMCP on every thread.

With --gate, jira-gate-proxy handles the Authentik gate and Jira session
cookies. mcp-atlassian receives only a random per-session token and never sees
the real Jira or Authentik passwords.
"""

import fcntl
import hashlib
import http.client
import json
import os
import secrets
import select
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

MCP_ATLASSIAN_SPEC = "mcp-atlassian==0.24.7"
SCRIPT_DIR = Path(__file__).resolve().parent


def die(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def setup_env():
    uid = os.getuid()
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{uid}"
    os.environ["XDG_RUNTIME_DIR"] = runtime
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    os.environ.setdefault("DISPLAY", ":0")
    home = os.environ.get("HOME") or str(Path.home())
    os.environ["HOME"] = home
    path_parts = os.environ.get("PATH", "").split(":")
    for prefix in (f"{home}/.local/bin", "/usr/bin", "/bin"):
        if prefix not in path_parts:
            path_parts.insert(0, prefix)
    os.environ["PATH"] = ":".join(p for p in path_parts if p)
    return Path(home), Path(runtime)


def need(*names):
    for name in names:
        if shutil.which(name) is None:
            die(f"mcp-atlassian-start: {name} is not on PATH")


def agent_call(sock_path, payload):
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(5.0)
    try:
        conn.connect(str(sock_path))
        conn.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        raw = b""
        while b"\n" not in raw and len(raw) < 65536:
            chunk = conn.recv(4096)
            if not chunk:
                break
            raw += chunk
        return json.loads(raw.split(b"\n", 1)[0].decode("utf-8"))
    finally:
        conn.close()


def agent_alive(sock_path):
    try:
        return bool(agent_call(sock_path, {"op": "ping"}).get("ok"))
    except (OSError, ValueError):
        return False


def cache_get(sock_path, url):
    try:
        res = agent_call(sock_path, {"op": "get", "url": url})
    except (OSError, ValueError):
        return None
    if res.get("ok"):
        return res["username"], res["password"]
    return None


def start_agent(sock_path):
    need("systemd-run", "systemctl")
    subprocess.run(
        ["systemctl", "--user", "stop", "jira-cred-agent.service"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    sock_path.unlink(missing_ok=True)
    subprocess.run(
        [
            "systemd-run",
            "--user",
            "--quiet",
            "--collect",
            "--unit=jira-cred-agent",
            f"--setenv=PATH={os.environ['PATH']}",
            str(SCRIPT_DIR / "jira-cred-agent"),
            str(sock_path),
        ],
        check=True,
    )
    for _ in range(50):
        if agent_alive(sock_path):
            return
        time.sleep(0.1)
    die("Jira credential agent did not start. See: journalctl --user -u jira-cred-agent")


def uris_of(item):
    login = (item or {}).get("login") or {}
    found = []
    for entry in login.get("uris") or []:
        uri = entry.get("uri") if isinstance(entry, dict) else entry
        if uri:
            found.append(uri)
    return found


def norm(value):
    return value.strip().rstrip("/").lower()


def exact_uri(item, needle):
    want = norm(needle)
    return any(norm(uri) == want for uri in uris_of(item))


def host_only(item, host):
    for uri in uris_of(item):
        parsed = urllib.parse.urlsplit(uri if "://" in uri else "https://" + uri)
        if (parsed.hostname or "").lower() == host.lower() and (parsed.path or "").rstrip("/") == "":
            return True
    return False


def pick_item(items, needle, allow_host):
    for item in items:
        if exact_uri(item, needle):
            return item
    if not allow_host:
        return None
    host = urllib.parse.urlsplit(needle).hostname or needle
    for item in items:
        if host_only(item, host):
            return item
    return None


def bw_status():
    res = subprocess.run(
        ["bw", "--nointeraction", "status"],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        return ""
    try:
        return json.loads(res.stdout).get("status", "")
    except json.JSONDecodeError:
        return ""


def bw_unlock():
    need("bw", "zenity", "setpriv")
    if bw_status() == "unauthenticated":
        die("Bitwarden CLI is not logged in. Run bw login in a normal terminal, then retry.")
    text = (
        "Same password that unlocks the Bitwarden app.\n"
        "NOT Client ID. NOT Client Secret. NOT Jira."
    )
    while True:
        # zenity --password ignores --text, and setpriv ensures the dialog closes if this script dies.
        prompt = subprocess.run(
            [
                "setpriv",
                "--pdeathsig",
                "TERM",
                "--",
                "zenity",
                "--entry",
                "--hide-text",
                "--title=Bitwarden master password",
                f"--text={text}",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        password = prompt.stdout.rstrip("\n")
        if prompt.returncode != 0 or not password:
            die("Bitwarden unlock was cancelled.")
        env = os.environ.copy()
        env["BW_PASSWORD"] = password
        unlock = subprocess.run(
            ["bw", "--nointeraction", "unlock", "--passwordenv", "BW_PASSWORD", "--raw"],
            capture_output=True,
            text=True,
            env=env,
            check=False,
        )
        del password, env
        session = unlock.stdout.strip()
        if unlock.returncode == 0 and session:
            return session
        if bw_status() == "unauthenticated":
            die("Bitwarden CLI is not logged in. Run bw login in a normal terminal, then retry.")
        text = "Wrong master password. Try again."


def bw_sync(session):
    env = os.environ.copy()
    env["BW_SESSION"] = session
    try:
        res = subprocess.run(
            ["bw", "--nointeraction", "sync"],
            capture_output=True,
            text=True,
            env=env,
            timeout=10,
            check=False,
        )
        return res.returncode == 0, res.stderr.strip()
    except subprocess.TimeoutExpired:
        return False, "Bitwarden sync timed out."


def bw_list_url(session, query):
    env = os.environ.copy()
    env["BW_SESSION"] = session
    res = subprocess.run(
        ["bw", "--nointeraction", "list", "items", "--url", query],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if res.returncode != 0:
        die(res.stderr.strip() or "Bitwarden lookup failed.")
    try:
        data = json.loads(res.stdout)
    except json.JSONDecodeError:
        die("Bitwarden returned invalid JSON.")
    return data if isinstance(data, list) else []


def bw_lookup_one(session, url, exact):
    items = bw_list_url(session, url)
    found = pick_item(items, url, allow_host=not exact)
    if found is None and not exact:
        host = urllib.parse.urlsplit(url).netloc
        if host and host != url:
            found = pick_item(bw_list_url(session, host), host, allow_host=True)
    if found is None:
        return None
    login = found.get("login") or {}
    user = login.get("username") or ""
    password = login.get("password") or ""
    if not user or not password:
        die(f"Bitwarden login for {url} has no username or password.")
    return user, password


def ensure_cached(sock_path, lock_path, targets, sync_first=False):
    missing = [(url, exact) for url, exact in targets if cache_get(sock_path, url) is None]
    if not missing:
        return {url: cache_get(sock_path, url) for url, _ in targets}

    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "w", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        if not agent_alive(sock_path):
            start_agent(sock_path)
        missing = [(url, exact) for url, exact in targets if cache_get(sock_path, url) is None]
        if missing:
            session = bw_unlock()
            synced = False
            sync_err = ""
            if sync_first:
                synced, sync_err = bw_sync(session)
            fetched = {}
            for url, exact in missing:
                creds = bw_lookup_one(session, url, exact)
                if creds is None and not synced:
                    synced, sync_err = bw_sync(session)
                    if synced:
                        creds = bw_lookup_one(session, url, exact)
                if creds is None:
                    if not synced and sync_err:
                        die(f"Bitwarden vault refresh failed.\n{sync_err}")
                    die(f"Bitwarden has no login for {url}. The login URI must match this URL.")
                fetched[url] = {"username": creds[0], "password": creds[1]}
            del session
            res = agent_call(sock_path, {"op": "put", "items": fetched})
            if not res.get("ok"):
                die(f"Failed to cache Jira credentials: {res.get('error', 'unknown error')}")

    return {url: cache_get(sock_path, url) for url, _ in targets}


def read_configured_urls(home):
    path = home / ".config/agent-config/jira-urls"
    if not path.is_file():
        return []
    return [line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def build_sandbox_cmd(home, extra_args, offline=True):
    need("uvx", "bwrap")
    uvx_which = shutil.which("uvx")
    uv_which = shutil.which("uv")
    uvx_real = os.path.realpath(uvx_which)
    uv_cache = Path(
        os.environ.get("UV_CACHE_DIR")
        or Path(os.environ.get("XDG_CACHE_HOME") or home / ".cache") / "uv"
    )
    uv_data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share") / "uv"
    uv_cache.mkdir(parents=True, exist_ok=True)
    uv_data.mkdir(parents=True, exist_ok=True)

    cmd = [
        "bwrap",
        "--die-with-parent",
        "--unshare-pid",
        "--unshare-ipc",
        "--unshare-uts",
        "--ro-bind", "/usr", "/usr",
        "--ro-bind", "/etc", "/etc",
        "--ro-bind-try", "/lib", "/lib",
        "--ro-bind-try", "/lib64", "/lib64",
        "--ro-bind-try", "/bin", "/bin",
        "--ro-bind-try", "/sbin", "/sbin",
        "--ro-bind-try", "/opt", "/opt",
        "--ro-bind-try", "/run/systemd/resolve", "/run/systemd/resolve",
        "--ro-bind-try", "/home/linuxbrew", "/home/linuxbrew",
        "--proc", "/proc",
        "--dev", "/dev",
        "--tmpfs", "/tmp",
        "--tmpfs", str(home),
        "--bind", str(uv_data), str(uv_data),
        "--bind", str(uv_cache), str(uv_cache),
    ]
    home_prefix = str(home) + os.sep
    bound = set()
    for candidate in (uvx_which, uvx_real, uv_which, os.path.realpath(uv_which) if uv_which else None):
        if candidate and candidate.startswith(home_prefix) and candidate not in bound:
            cmd.extend(["--ro-bind", candidate, candidate])
            bound.add(candidate)
    cmd.append(uvx_which)
    if offline:
        cmd.append("--offline")
    cmd.append(MCP_ATLASSIAN_SPEC)
    cmd.extend(extra_args)
    return cmd


def build_mcp_env(jira_url, jira_user, jira_token):
    env = {
        "PATH": os.environ["PATH"],
        "HOME": os.environ["HOME"],
        "JIRA_URL": jira_url,
        "JIRA_USERNAME": jira_user,
        "JIRA_API_TOKEN": jira_token,
        "ALLOW_GLOBAL_CRED_FALLBACK": "true",
    }
    for key in (
        "LANG",
        "LC_ALL",
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
        "UV_CACHE_DIR",
        "XDG_CACHE_HOME",
        "XDG_DATA_HOME",
    ):
        if key in os.environ:
            env[key] = os.environ[key]
    return env


def start_gate_proxy(url, jira_user, jira_password, gate_user, gate_password, proxy_token):
    read_fd, write_fd = os.pipe()
    os.set_inheritable(write_fd, True)
    proxy_env = os.environ.copy()
    proxy_env.update({
        "JIRA_UPSTREAM": url,
        "JIRA_GATE_USERNAME": gate_user,
        "JIRA_GATE_PASSWORD": gate_password,
        "JIRA_USERNAME": jira_user,
        "JIRA_API_TOKEN": jira_password,
        "JIRA_PROXY_TOKEN": proxy_token,
    })
    proc = subprocess.Popen(
        [str(SCRIPT_DIR / "jira-gate-proxy"), "--port-fd", str(write_fd)],
        env=proxy_env,
        pass_fds=(write_fd,),
    )
    os.close(write_fd)
    try:
        ready, _, _ = select.select([read_fd], [], [], 10.0)
        if not ready:
            proc.terminate()
            die("jira-gate-proxy did not become ready.")
        data = b""
        while b"\n" not in data:
            chunk = os.read(read_fd, 64)
            if not chunk:
                break
            data += chunk
        port = data.decode("ascii").strip()
        if not port.isdigit():
            proc.terminate()
            die("jira-gate-proxy exited before it was ready.")
        return proc, f"http://127.0.0.1:{port}"
    finally:
        os.close(read_fd)


def instance_key(url, gate):
    tag = f"{norm(url)}|{'gate' if gate else 'direct'}"
    return hashlib.sha256(tag.encode("utf-8")).hexdigest()[:12]


def free_port():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]
    finally:
        sock.close()


def tcp_ready(port):
    try:
        conn = socket.create_connection(("127.0.0.1", port), timeout=0.5)
        conn.close()
        return True
    except OSError:
        return False


def read_daemon_state(state_path):
    if not state_path.is_file():
        return None
    try:
        data = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if (not isinstance(data, dict)
            or data.get("spec") != MCP_ATLASSIAN_SPEC
            or not isinstance(data.get("port"), int)
            or not isinstance(data.get("path"), str)):
        return None
    if not tcp_ready(data["port"]):
        return None
    return data


def write_daemon_state(state_path, data):
    state_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = state_path.with_suffix(".tmp")
    old_umask = os.umask(0o177)
    try:
        tmp.write_text(json.dumps(data) + "\n", encoding="utf-8")
        tmp.replace(state_path)
    finally:
        os.umask(old_umask)


def launch_mcp_http(home, mcp_env, port, mcp_path):
    extra = [
        "--transport", "streamable-http",
        "--stateless",
        "--host", "127.0.0.1",
        "--port", str(port),
        "--path", mcp_path,
    ]
    for offline in (True, False):
        cmd = build_sandbox_cmd(home, extra, offline=offline)
        proc = subprocess.Popen(cmd, env=mcp_env, stdin=subprocess.DEVNULL)
        deadline = time.monotonic() + 30.0
        while time.monotonic() < deadline:
            if tcp_ready(port):
                return proc
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        if proc.poll() is None:
            proc.terminate()
            proc.wait(timeout=3)
        if not offline:
            die("mcp-atlassian HTTP daemon did not become ready.")
    die("mcp-atlassian HTTP daemon did not become ready.")


def serve_daemon(home, runtime, url, gate, state_path):
    sock_path = runtime / "jira-cred-agent.sock"
    lock_path = runtime / "jira-cred-agent.lock"
    gate_url = f"{url.rstrip('/')}/auth-gate"
    targets = [(url, False)]
    if gate:
        targets.append((gate_url, True))

    cached = ensure_cached(sock_path, lock_path, targets)
    jira_user, jira_password = cached[url]

    proxy = None
    proxy_url = ""
    if gate:
        gate_user, gate_password = cached[gate_url]
        proxy_token = secrets.token_urlsafe(32)
        proxy, proxy_url = start_gate_proxy(
            url, jira_user, jira_password, gate_user, gate_password, proxy_token
        )
        mcp_env = build_mcp_env(proxy_url, jira_user, proxy_token)
    else:
        mcp_env = build_mcp_env(url, jira_user, jira_password)

    port = free_port()
    mcp_path = "/mcp/" + secrets.token_urlsafe(32)
    mcp = launch_mcp_http(home, mcp_env, port, mcp_path)

    write_daemon_state(state_path, {
        "port": port,
        "path": mcp_path,
        "proxy_url": proxy_url,
        "url": url.rstrip("/"),
        "spec": MCP_ATLASSIAN_SPEC,
    })

    def stop(signum, _frame):
        for child in (mcp, proxy):
            if child is not None and child.poll() is None:
                child.send_signal(signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    try:
        code = mcp.wait()
    finally:
        state_path.unlink(missing_ok=True)
        if proxy is not None and proxy.poll() is None:
            proxy.terminate()
            try:
                proxy.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proxy.kill()
    raise SystemExit(code)


def ensure_daemon(runtime, url, gate):
    key = instance_key(url, gate)
    state_path = runtime / f"jira-mcp-{key}.json"
    state = read_daemon_state(state_path)
    if state is not None:
        return state

    need("systemd-run", "systemctl", "uvx", "bwrap")
    sock_path = runtime / "jira-cred-agent.sock"
    cred_lock = runtime / "jira-cred-agent.lock"
    gate_url = f"{url.rstrip('/')}/auth-gate"
    targets = [(url, False)]
    if gate:
        targets.append((gate_url, True))
    ensure_cached(sock_path, cred_lock, targets)

    lock_path = runtime / f"jira-mcp-{key}.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "w", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        state = read_daemon_state(state_path)
        if state is not None:
            return state
        unit = f"jira-mcp-{key}"
        subprocess.run(
            ["systemctl", "--user", "stop", f"{unit}.service"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        state_path.unlink(missing_ok=True)
        serve_args = [str(Path(__file__).resolve()), "--serve", url]
        if gate:
            serve_args.append("--gate")
        serve_args.extend(["--state-file", str(state_path)])
        subprocess.run(
            [
                "systemd-run",
                "--user",
                "--quiet",
                "--collect",
                f"--unit={unit}",
                f"--setenv=PATH={os.environ['PATH']}",
                *serve_args,
            ],
            check=True,
        )
        deadline = time.monotonic() + 30.0
        while time.monotonic() < deadline:
            state = read_daemon_state(state_path)
            if state is not None:
                return state
            time.sleep(0.05)
    die(f"Jira MCP daemon did not start. See: journalctl --user -u jira-mcp-{key}")


def extract_sse_payloads(body):
    payloads = []
    data_lines = []
    for raw_line in body.splitlines():
        line = raw_line.rstrip(b"\r")
        if line.startswith(b"data:"):
            part = line[5:]
            if part.startswith(b" "):
                part = part[1:]
            data_lines.append(part)
        elif not line and data_lines:
            payloads.append(b"\n".join(data_lines))
            data_lines = []
    if data_lines:
        payloads.append(b"\n".join(data_lines))
    return payloads


def bridge_stdio(runtime, url, gate):
    state = ensure_daemon(runtime, url, gate)
    conn = http.client.HTTPConnection("127.0.0.1", state["port"], timeout=120)
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
    }

    def post_once(payload):
        nonlocal state, conn
        for attempt in range(2):
            try:
                conn.request("POST", state["path"], body=payload, headers=headers)
                resp = conn.getresponse()
                return resp.status, resp.getheader("Content-Type") or "", resp.read()
            except (http.client.HTTPException, OSError):
                conn.close()
                if attempt == 1:
                    raise
                state = ensure_daemon(runtime, url, gate)
                conn = http.client.HTTPConnection("127.0.0.1", state["port"], timeout=120)

    try:
        for raw_line in sys.stdin.buffer:
            payload = raw_line.strip()
            if not payload:
                continue
            status, content_type, body = post_once(payload)
            if status == 202 or not body.strip():
                continue
            proxy_bytes = state.get("proxy_url", "").encode("utf-8")
            upstream_bytes = state.get("url", url.rstrip("/")).encode("utf-8")
            if "text/event-stream" in content_type.lower():
                messages = extract_sse_payloads(body)
            else:
                messages = [body.strip()]
            for msg in messages:
                if not msg:
                    continue
                if proxy_bytes:
                    msg = msg.replace(proxy_bytes, upstream_bytes)
                sys.stdout.buffer.write(msg + b"\n")
                sys.stdout.buffer.flush()
    finally:
        conn.close()


def main():
    args = sys.argv[1:]
    if not args:
        die("usage: mcp-atlassian-start <jira-url> [--gate] | --unlock [<url> ...]")

    home, runtime = setup_env()
    sock_path = runtime / "jira-cred-agent.sock"
    lock_path = runtime / "jira-cred-agent.lock"

    if args[0] == "--serve":
        rest = args[1:]
        if not rest:
            die("usage: mcp-atlassian-start --serve <jira-url> [--gate] --state-file <path>")
        url = rest[0]
        gate = False
        state_file = None
        i = 1
        while i < len(rest):
            if rest[i] == "--gate":
                gate = True
                i += 1
            elif rest[i] == "--state-file" and i + 1 < len(rest):
                state_file = Path(rest[i + 1])
                i += 2
            else:
                die("usage: mcp-atlassian-start --serve <jira-url> [--gate] --state-file <path>")
        if state_file is None:
            die("usage: mcp-atlassian-start --serve <jira-url> [--gate] --state-file <path>")
        serve_daemon(home, runtime, url, gate, state_file)
        return

    if args[0] == "--unlock":
        urls = args[1:] or read_configured_urls(home)
        if not urls:
            return
        targets = [(u, u.rstrip("/").endswith("/auth-gate")) for u in urls]
        ensure_cached(sock_path, lock_path, targets, sync_first=True)
        url_set = {u.rstrip("/") for u in urls}
        for u in urls:
            stripped = u.rstrip("/")
            if stripped.endswith("/auth-gate"):
                continue
            ensure_daemon(runtime, stripped, f"{stripped}/auth-gate" in url_set)
        return

    url = args[0]
    gate = False
    if len(args) == 2 and args[1] == "--gate":
        gate = True
    elif len(args) != 1:
        die("usage: mcp-atlassian-start <jira-url> [--gate] | --unlock [<url> ...]")

    bridge_stdio(runtime, url, gate)


if __name__ == "__main__":
    main()
