#!/usr/bin/env python3
"""In-memory cache for Jira MCP credentials on a private Unix socket.

Holds only the Jira and gate logins that mcp-atlassian-start fetches from
Bitwarden, never the rest of the vault. Stopping the systemd user unit
jira-cred-agent wipes the cache and removes the socket.
"""

import json
import os
import signal
import socket
import sys
from pathlib import Path


def handle(conn, cache):
    raw = b""
    while b"\n" not in raw and len(raw) < 65536:
        chunk = conn.recv(4096)
        if not chunk:
            break
        raw += chunk
    line = raw.split(b"\n", 1)[0]
    try:
        req = json.loads(line.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return {"ok": False, "error": "invalid_json"}
    if not isinstance(req, dict):
        return {"ok": False, "error": "invalid_request"}
    op = req.get("op")
    if op == "ping":
        return {"ok": True}
    if op == "get":
        url = req.get("url")
        if not isinstance(url, str) or not url:
            return {"ok": False, "error": "missing_url"}
        entry = cache.get(url)
        if entry is None:
            return {"ok": False, "error": "not_found"}
        return {"ok": True, "username": entry["username"], "password": entry["password"]}
    if op == "put":
        items = req.get("items")
        if not isinstance(items, dict):
            return {"ok": False, "error": "invalid_items"}
        for url, entry in items.items():
            if (not isinstance(url, str) or not isinstance(entry, dict)
                    or not isinstance(entry.get("username"), str)
                    or not isinstance(entry.get("password"), str)):
                return {"ok": False, "error": "invalid_items"}
        for url, entry in items.items():
            cache[url] = {"username": entry["username"], "password": entry["password"]}
        return {"ok": True}
    return {"ok": False, "error": "unknown_op"}


def main():
    if len(sys.argv) != 2:
        print("usage: jira-cred-agent <socket-path>", file=sys.stderr)
        raise SystemExit(1)
    sock_path = Path(sys.argv[1])
    sock_path.parent.mkdir(parents=True, exist_ok=True)
    sock_path.unlink(missing_ok=True)

    # Create the socket with 0600 permissions so only this user can connect.
    old_umask = os.umask(0o177)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(sock_path))
        server.listen(16)
    finally:
        os.umask(old_umask)

    running = True

    def stop(_signum, _frame):
        nonlocal running
        running = False
        server.close()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    cache = {}
    try:
        while running:
            try:
                conn, _ = server.accept()
            except OSError:
                break
            with conn:
                conn.settimeout(5.0)
                try:
                    reply = handle(conn, cache)
                    conn.sendall((json.dumps(reply) + "\n").encode("utf-8"))
                except OSError:
                    pass
    finally:
        cache.clear()
        sock_path.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
