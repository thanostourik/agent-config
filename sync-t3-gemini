#!/usr/bin/env python3
"""Symlink ~/.gemini/config items into T3 Code's Antigravity provider folders."""

import argparse
from pathlib import Path
import sys

ITEMS = ("AGENTS.md", "hooks.json", "mcp_config.json", "agents")


def link_item(source, target):
    if target.is_symlink():
        if target.resolve() == source.resolve():
            print(f"OK: {target} -> {source}")
            return True
        print(f"SKIP: {target} already links to {target.readlink()}", file=sys.stderr)
        return False
    if target.exists():
        # T3 Code creates an empty 0-byte mcp_config.json by default.
        if target.is_file() and target.stat().st_size == 0:
            target.unlink()
        else:
            print(f"SKIP: {target} already exists and is not empty", file=sys.stderr)
            return False
    target.symlink_to(source)
    print(f"LINK: {target} -> {source}")
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path, default=Path.home())
    args = parser.parse_args()

    source_dir = args.home / ".gemini/config"
    t3_root = args.home / ".t3/userdata/providers/antigravity"
    config_dirs = sorted(p for p in t3_root.glob("*/config") if p.is_dir())
    if not config_dirs:
        print(f"No T3 Code Antigravity config directories found under {t3_root}")
        return 0

    sources = [source_dir / name for name in ITEMS if (source_dir / name).exists()]
    if not sources:
        print(f"No sync-managed items found under {source_dir}")
        return 0

    ok = True
    for config_dir in config_dirs:
        for source in sources:
            if not link_item(source, config_dir / source.name):
                ok = False
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
