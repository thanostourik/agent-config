#!/usr/bin/env python3
"""Preview configuration changes; use --apply to install them.

Examples:
  ./sync
  ./sync --apply
  ./sync --apply --replace-existing
  ./sync --check
  ./sync --clean-backups
  ./sync --home /tmp/agent-config-test --apply

Empty Markdown placeholders are skipped. Existing files are replaced only
with --replace-existing and are backed up alongside the destination first.
Cursor rules are installed in ~/.cursor/rules/agent-config.mdc and always
apply. Cursor IDE discovers these for projects under the home directory.
config.json (gitignored) can disable skills, agents, hooks, and MCP servers.
Missing entries stay enabled. Copy config.example.json to start.
Disabled items are removed from the destinations sync installed.
Jira MCP URLs live only in config.json; sync merges server entries into each
tool's MCP config and does not put secrets in those files.
"""

import argparse
import json
import os
import re
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parent
# Per-tool destinations relative to the home directory. Source layout:
#   instructions/<tool>.md  -> instructions (common.md is prepended)
#   skills/<tool>/<name>/   -> skills
#   agents/<tool>/<name>.*  -> agent definitions
#   hooks/<tool>.json       -> hook configuration (copied as is; for Claude Code
#                              it is the "hooks" value merged into settings.json)
# skills/shared/ installs to ~/.agents/skills, which several tools read.
# bin/ installs to ~/.local/bin; hooks and skills call those scripts by name.
TOOLS = {
    "claude-code": {"instructions": ".claude/CLAUDE.md", "hooks": ".claude/settings.json",
                    "skills": ".claude/skills", "agents": ".claude/agents"},
    "codex": {"instructions": ".codex/AGENTS.md", "hooks": ".codex/hooks.json",
              "skills": ".codex/skills", "agents": ".codex/agents"},
    "grok": {"instructions": ".grok/AGENTS.md",
             "skills": ".grok/skills", "agents": ".grok/agents"},
    "opencode": {"instructions": ".config/opencode/AGENTS.md",
                 "skills": ".config/opencode/skill", "agents": ".config/opencode/agent"},
    "cursor": {"instructions": ".cursor/rules/agent-config.mdc", "hooks": ".cursor/hooks.json",
               "skills": ".cursor/skills", "agents": ".cursor/agents"},
    "shared": {"skills": ".agents/skills"},
}
CURSOR_HEADER = "---\ndescription: Personal agent configuration\nglobs: \nalwaysApply: true\n---\n\n"
INSTANCE_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*$")
MANAGED_MCP = ".config/agent-config/managed-mcp.json"
MCP_JSON = (
    (".cursor/mcp.json", "mcpServers", "stdio"),
    (".claude.json", "mcpServers", "stdio"),
    (".config/opencode/opencode.json", "mcp", "opencode"),
)
MCP_TOML = (".codex/config.toml", ".grok/config.toml")


def load_config():
    """Read config.json. Missing file means everything stays enabled."""
    path = ROOT / "config.json"
    if not path.is_file():
        return {}
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError("config.json must be a JSON object")
    for section in ("skills", "agents", "hooks"):
        items = data.get(section)
        if items is None:
            continue
        if not isinstance(items, dict):
            raise ValueError(f"config.json {section} must be an object")
        for name, entry in items.items():
            if not isinstance(entry, dict):
                raise ValueError(f"config.json {section}.{name} must be an object")
            if "enabled" in entry and not isinstance(entry["enabled"], bool):
                raise ValueError(
                    f"config.json {section}.{name}.enabled must be true or false")
    mcp = data.get("mcp")
    if mcp is not None:
        if not isinstance(mcp, dict):
            raise ValueError("config.json mcp must be an object")
        for name, entry in mcp.items():
            if not isinstance(entry, dict):
                raise ValueError(f"config.json mcp.{name} must be an object")
            if "enabled" in entry and not isinstance(entry["enabled"], bool):
                raise ValueError(f"config.json mcp.{name}.enabled must be true or false")
    jira_servers(data)
    return data


def is_enabled(config, section, name):
    """Missing section or name is on. enabled: true is the same as missing."""
    items = config.get(section)
    if items is None:
        return True
    if not isinstance(items, dict):
        raise ValueError(f"config.json {section} must be an object")
    entry = items.get(name)
    if entry is None:
        return True
    if not isinstance(entry, dict):
        raise ValueError(f"config.json {section}.{name} must be an object")
    if "enabled" not in entry:
        return True
    return entry["enabled"]


def jira_servers(config):
    """Return (mcp name, url) pairs. One instance is installed as server jira."""
    if not is_enabled(config, "mcp", "jira"):
        return []
    mcp = config.get("mcp")
    if mcp is None:
        return []
    if not isinstance(mcp, dict):
        raise ValueError("config.json mcp must be an object")
    jira = mcp.get("jira")
    if jira is None:
        return []
    if not isinstance(jira, dict):
        raise ValueError("config.json mcp.jira must be an object")
    instances = jira.get("instances")
    if instances is None:
        return []
    if not isinstance(instances, dict):
        raise ValueError("config.json mcp.jira.instances must be an object")
    items = []
    for name, entry in instances.items():
        if not INSTANCE_NAME.fullmatch(name):
            raise ValueError(
                f"config.json mcp.jira.instances key {name!r} must start with a "
                "letter and use only letters, digits, _ or -")
        if not isinstance(entry, dict):
            raise ValueError(f"config.json mcp.jira.instances.{name} must be an object")
        url = entry.get("url")
        if not isinstance(url, str) or not url.strip():
            raise ValueError(
                f"config.json mcp.jira.instances.{name}.url must be a non-empty string")
        items.append((name, url.strip()))
    if len(items) == 1:
        return [("jira", items[0][1])]
    return items


def mcp_gui_env():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return {
        "DISPLAY": os.environ.get("DISPLAY") or ":0",
        "DBUS_SESSION_BUS_ADDRESS": (
            os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime}/bus"),
        "XDG_RUNTIME_DIR": runtime,
    }


def stdio_server(helper, url, env):
    return {"command": str(helper), "args": [url], "env": env}


def opencode_server(helper, url, env):
    return {
        "type": "local",
        "command": [str(helper), url],
        "enabled": True,
        "environment": env,
        "timeout": 180000,
    }


def merge_json_mcp(path, bucket_key, flavor, helper, servers, previous):
    data = json.loads(path.read_text()) if path.is_file() else {}
    if not isinstance(data, dict):
        raise ValueError(f"{path} must be a JSON object")
    bucket = data.get(bucket_key)
    if not isinstance(bucket, dict):
        bucket = {}
    desired = {name for name, _url in servers}
    for name in previous:
        if name not in desired:
            bucket.pop(name, None)
    env = mcp_gui_env()
    for name, url in servers:
        if flavor == "opencode":
            bucket[name] = opencode_server(helper, url, env)
        else:
            bucket[name] = stdio_server(helper, url, env)
    if bucket:
        data[bucket_key] = bucket
    else:
        data.pop(bucket_key, None)
    return (json.dumps(data, indent=2) + "\n").encode()


def toml_scalar(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_scalar(item) for item in value) + "]"
    if not isinstance(value, str):
        raise ValueError(f"unsupported TOML value {value!r}")
    return json.dumps(value)


def render_toml_mcp(name, helper, url, env):
    lines = [
        f"[mcp_servers.{name}]",
        f"command = {toml_scalar(str(helper))}",
        f"args = {toml_scalar([url])}",
        "startup_timeout_sec = 180",
        "enabled = true",
        "",
        f"[mcp_servers.{name}.env]",
    ]
    for key, value in env.items():
        lines.append(f"{key} = {toml_scalar(value)}")
    return "\n".join(lines) + "\n"


def strip_toml_mcp(text, names):
    names = set(names)
    out = []
    skipping = False
    for line in text.splitlines(True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            header = stripped[1:-1].strip()
            skipping = False
            for name in names:
                key = f"mcp_servers.{name}"
                if header == key or header.startswith(key + "."):
                    skipping = True
                    break
        if not skipping:
            out.append(line)
    return "".join(out)


def merge_toml_mcp(path, helper, servers, previous):
    text = path.read_text() if path.is_file() else ""
    text = strip_toml_mcp(text, set(previous) | {name for name, _url in servers})
    chunks = []
    if text.strip():
        chunks.append(text.rstrip() + "\n")
    env = mcp_gui_env()
    for name, url in servers:
        chunks.append(render_toml_mcp(name, helper, url, env))
    if not chunks:
        return b""
    return "".join(chunks).encode()


def read_managed_jira(home):
    path = home / MANAGED_MCP
    if not path.is_file():
        return []
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError(f"{path} must be a JSON object")
    names = data.get("jira")
    if names is None:
        return []
    if not isinstance(names, list) or not all(isinstance(name, str) for name in names):
        raise ValueError(f"{path} jira must be a list of names")
    return names


def remove_backup(backup):
    if backup.is_dir() and not backup.is_symlink():
        shutil.rmtree(backup)
    else:
        backup.unlink()


def backup_path(target, stamp):
    return target.with_name(f"{target.name}.backup-{stamp}")


def skill_harnesses(entry, default):
    """Read our single-line metadata.harness string, not general YAML."""
    lines = entry.read_text().splitlines()
    if not lines or lines[0] != "---":
        return [default]
    try:
        end = lines.index("---", 1)
    except ValueError:
        raise ValueError(f"{entry}: frontmatter must end with ---") from None
    in_metadata = False
    harnesses = None
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            in_metadata = line.rstrip() == "metadata:"
            if line.startswith("metadata:") and not in_metadata:
                raise ValueError(f"{entry}: metadata must be a block starting with metadata:")
            continue
        if not in_metadata or not line.lstrip().startswith("harness:"):
            continue
        match = re.fullmatch(r'  harness: "([a-z, -]+)"\s*', line)
        if not match:
            raise ValueError(f'{entry}: use exactly two spaces then harness: "grok, opencode"')
        if harnesses is not None:
            raise ValueError(f"{entry}: duplicate metadata.harness")
        harnesses = [name.strip() for name in match[1].split(",")]
        if any(name not in TOOLS for name in harnesses):
            raise ValueError(f"{entry}: harness names must be one of {', '.join(TOOLS)}")
        if len(set(harnesses)) != len(harnesses):
            raise ValueError(f"{entry}: duplicate harness names")
    return harnesses if harnesses is not None else [default]


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true", help="write the previewed changes")
    mode.add_argument("--check", action="store_true", help="exit nonzero when changes are needed")
    mode.add_argument("--clean-backups", action="store_true",
                      help="delete backups next to installed files, then exit")
    parser.add_argument("--replace-existing", action="store_true",
                        help="allow replacement of existing destinations, keeping backups")
    parser.add_argument("--home", type=Path, default=Path.home(),
                        help="destination home directory (useful for testing)")
    args = parser.parse_args()
    home = args.home.expanduser().resolve()
    files = {}
    executable_files = set()
    skill_sources = {}
    deletes = []
    backup_roots = set()
    config = load_config()
    common = (ROOT / "instructions/common.md").read_text().strip()

    for tool, destinations in TOOLS.items():
        if "instructions" in destinations:
            specific = (ROOT / f"instructions/{tool}.md").read_text().strip()
            contents = "\n\n".join(part for part in [common, specific] if part)
            if contents:
                if tool == "cursor":
                    contents = CURSOR_HEADER + contents
                files[home / destinations["instructions"]] = (contents + "\n").encode()

        skills_dir = ROOT / "skills" / tool
        if "skills" in destinations and skills_dir.is_dir():
            for skill in sorted(skills_dir.iterdir()):
                entry = skill / "SKILL.md"
                if not entry.is_file() or not entry.read_text().strip():
                    continue
                enabled = is_enabled(config, "skills", skill.name)
                for harness in skill_harnesses(entry, tool):
                    destination = home / TOOLS[harness]["skills"] / skill.name
                    if destination in skill_sources:
                        raise ValueError(f"Duplicate skill destination {destination}: "
                                         f"{skill_sources[destination]} and {skill}")
                    skill_sources[destination] = skill
                    backup_roots.add(destination)
                    if not enabled:
                        if destination.exists() or destination.is_symlink():
                            deletes.append((destination, True))
                        continue
                    for file in sorted(skill.rglob("*")):
                        if file.is_file():
                            target = destination / file.relative_to(skill)
                            files[target] = file.read_bytes()
                            if file.stat().st_mode & 0o111:
                                executable_files.add(target)

        agents_dir = ROOT / "agents" / tool
        if "agents" in destinations and agents_dir.is_dir():
            for agent in sorted(agents_dir.iterdir()):
                if not (agent.is_file() and agent.read_text().strip()):
                    continue
                target = home / destinations["agents"] / agent.name
                backup_roots.add(target)
                if not is_enabled(config, "agents", agent.stem):
                    if target.exists() or target.is_symlink():
                        deletes.append((target, False))
                    continue
                files[target] = agent.read_bytes()

        hooks_file = ROOT / "hooks" / f"{tool}.json"
        if "hooks" in destinations and hooks_file.is_file():
            target = home / destinations["hooks"]
            backup_roots.add(target)
            if not is_enabled(config, "hooks", tool):
                if tool == "claude-code":
                    if target.is_file():
                        settings = json.loads(target.read_text())
                        if "hooks" in settings:
                            del settings["hooks"]
                            files[target] = (json.dumps(settings, indent=2) + "\n").encode()
                elif target.exists() or target.is_symlink():
                    deletes.append((target, False))
                continue
            if tool == "claude-code":
                # Claude Code keeps hooks inside settings.json next to unrelated
                # settings, so replace only the "hooks" key and keep the rest.
                settings = json.loads(target.read_text()) if target.is_file() else {}
                settings["hooks"] = json.loads(hooks_file.read_text())
                files[target] = (json.dumps(settings, indent=2) + "\n").encode()
            else:
                files[target] = hooks_file.read_bytes()

    for script in sorted((ROOT / "bin").glob("*")):
        if script.is_file():
            target = home / ".local/bin" / script.name
            files[target] = script.read_bytes()
            executable_files.add(target)

    helper = home / ".local/bin/mcp-atlassian-start"
    previous_jira = read_managed_jira(home)
    servers = jira_servers(config)
    if servers or previous_jira:
        for relative, bucket, flavor in MCP_JSON:
            target = home / relative
            if servers or target.is_file():
                files[target] = merge_json_mcp(
                    target, bucket, flavor, helper, servers, previous_jira)
        for relative in MCP_TOML:
            target = home / relative
            if servers or target.is_file():
                files[target] = merge_toml_mcp(target, helper, servers, previous_jira)
        files[home / MANAGED_MCP] = (
            json.dumps({"jira": [name for name, _url in servers]}, indent=2) + "\n"
        ).encode()

    backup_roots.update(files)
    if args.clean_backups:
        backups = [b for target in backup_roots for b in target.parent.glob(f"{target.name}.backup-*")]
        for backup in backups:
            remove_backup(backup)
            print(f"DELETED: {backup}")
        print(f"Deleted {len(backups)} backup(s).")
        return 0

    changes = []
    blocked = False
    for target, contents in files.items():
        exists = target.exists() or target.is_symlink()
        if (target.is_file() and target.read_bytes() == contents
                and (target not in executable_files or target.stat().st_mode & 0o111)):
            continue
        if exists and not (target.is_file() or target.is_symlink()):
            print(f"BLOCKED (destination is not a file): {target}")
            blocked = True
            continue
        if exists and not args.replace_existing:
            print(f"BLOCKED (requires --replace-existing): {target}")
            blocked = True
        else:
            print(f"{'REPLACE + BACKUP' if exists else 'CREATE'}: {target}")
        changes.append((target, contents, exists))

    removals = []
    for target, directory in deletes:
        if target.is_symlink() or (not directory and target.is_file()) or (
                directory and target.is_dir()):
            print(f"DELETE: {target}")
            removals.append((target, directory))
            continue
        print(f"BLOCKED (destination is not a sync-owned {'directory' if directory else 'file'}): {target}")
        blocked = True

    if blocked:
        print("No files written. Review destinations before using --replace-existing.")
        return 2
    if not changes and not removals:
        print("No changes needed." if files or deletes else
              "No populated sources; empty placeholders skipped.")
        return 0
    if args.check:
        return 1
    if not args.apply:
        print("Preview only. Use --apply to write these changes.")
        return 0

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    for target, contents, exists in changes:
        target.parent.mkdir(parents=True, exist_ok=True)
        if exists:
            backup = backup_path(target, stamp)
            shutil.copy2(target, backup, follow_symlinks=False)
            print(f"BACKUP: {backup}")
        # Replace the directory entry, never write through an existing symlink.
        temporary = target.with_name(f".{target.name}.sync-{stamp}")
        try:
            with temporary.open("xb") as stream:
                stream.write(contents)
            if target in executable_files:
                temporary.chmod(0o755)
            temporary.replace(target)
        finally:
            temporary.unlink(missing_ok=True)
    for target, directory in removals:
        backup = backup_path(target, stamp)
        if target.is_symlink() or target.is_file():
            shutil.copy2(target, backup, follow_symlinks=False)
            target.unlink()
        else:
            shutil.copytree(target, backup, symlinks=True)
            shutil.rmtree(target)
        print(f"BACKUP: {backup}")
        print(f"DELETED: {target}")
    print(f"Applied {len(changes)} file change(s), {len(removals)} deletion(s). "
          "Restart sessions to load new instructions.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"Sync failed: {error}", file=sys.stderr)
        sys.exit(2)
