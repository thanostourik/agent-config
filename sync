#!/usr/bin/env python3
"""Preview configuration changes; use --apply to install them.

Examples:
  ./sync
  ./sync --apply
  ./sync --apply --replace-existing
  ./sync --check
  ./sync --clean-backups
  ./sync --home /tmp/agent-config-test --apply

Empty Markdown placeholders are skipped. Existing files are replaced only
with --replace-existing and are backed up alongside the destination first.
Cursor rules are installed in ~/.cursor/rules/agent-config.mdc and always
apply. Cursor IDE discovers these for projects under the home directory.
config.json (gitignored) can disable skills, agents, hooks, and MCP servers.
Missing entries stay enabled. Copy config.example.json to start.
Disabled items are removed from the destinations sync installed.
Jira MCP URLs live only in config.json; sync merges server entries into each
tool's MCP config and does not put secrets in those files.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath


ROOT = Path(__file__).resolve().parent
# Per-tool destinations relative to the home directory. Source layout:
#   instructions/<tool>.md  -> instructions (common.md is prepended)
#   skills/<tool>/<name>/   -> skills
#   agents/<tool>/<name>.*  -> agent definitions
#   hooks/<tool>.json       -> hook configuration (copied as is; for Claude Code
#                              it is the "hooks" value merged into settings.json)
# skills/shared/ installs to every skills destination unless harness says otherwise.
# bin/ installs to ~/.local/bin; hooks and skills call those scripts by name.
TOOLS = {
    "claude-code": {"instructions": ".claude/CLAUDE.md", "hooks": ".claude/settings.json",
                    "skills": ".claude/skills", "agents": ".claude/agents"},
    "codex": {"instructions": ".codex/AGENTS.md", "hooks": ".codex/hooks.json",
              "skills": ".codex/skills", "agents": ".codex/agents"},
    "grok": {"instructions": ".grok/AGENTS.md",
             "skills": ".grok/skills", "agents": ".grok/agents"},
    "opencode": {"instructions": ".config/opencode/AGENTS.md",
                 "skills": ".config/opencode/skill", "agents": ".config/opencode/agent"},
    "cursor": {"instructions": ".cursor/rules/agent-config.mdc", "hooks": ".cursor/hooks.json",
               "skills": ".cursor/skills", "agents": ".cursor/agents"},
    "shared": {"skills": ".agents/skills"},
}
CURSOR_HEADER = "---\ndescription: Personal agent configuration\nglobs: \nalwaysApply: true\n---\n\n"
INSTANCE_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*$")
LEGACY_STATE = ".config/agent-config/managed-mcp.json"
STATE = ".config/agent-config/state.json"
BACKUPS = ".config/agent-config/backups"
BLOCKED = object()
MISSING = object()
MCP_JSON = (
    (".cursor/mcp.json", "mcpServers", "stdio"),
    (".claude.json", "mcpServers", "stdio"),
    (".config/opencode/opencode.json", "mcp", "opencode"),
)
MCP_TOML = (".codex/config.toml", ".grok/config.toml")


def load_config():
    """Read config.json. Missing file means everything stays enabled."""
    path = ROOT / "config.json"
    if not path.is_file():
        return {}
    data = json.loads(path.read_text())
    if not isinstance(data, dict):
        raise ValueError("config.json must be a JSON object")
    for section in ("skills", "agents", "hooks"):
        items = data.get(section)
        if items is None:
            continue
        if not isinstance(items, dict):
            raise ValueError(f"config.json {section} must be an object")
        for name, entry in items.items():
            if not isinstance(entry, dict):
                raise ValueError(f"config.json {section}.{name} must be an object")
            if "enabled" in entry and not isinstance(entry["enabled"], bool):
                raise ValueError(
                    f"config.json {section}.{name}.enabled must be true or false")
    mcp = data.get("mcp")
    if mcp is not None:
        if not isinstance(mcp, dict):
            raise ValueError("config.json mcp must be an object")
        for name, entry in mcp.items():
            if not isinstance(entry, dict):
                raise ValueError(f"config.json mcp.{name} must be an object")
            if "enabled" in entry and not isinstance(entry["enabled"], bool):
                raise ValueError(f"config.json mcp.{name}.enabled must be true or false")
    jira_servers(data)
    return data


def is_enabled(config, section, name):
    """Missing section or name is on. enabled: true is the same as missing."""
    items = config.get(section)
    if items is None:
        return True
    if not isinstance(items, dict):
        raise ValueError(f"config.json {section} must be an object")
    entry = items.get(name)
    if entry is None:
        return True
    if not isinstance(entry, dict):
        raise ValueError(f"config.json {section}.{name} must be an object")
    if "enabled" not in entry:
        return True
    return entry["enabled"]


def jira_servers(config):
    """Return (mcp name, url) pairs. One instance is installed as server jira."""
    if not is_enabled(config, "mcp", "jira"):
        return []
    mcp = config.get("mcp")
    if mcp is None:
        return []
    if not isinstance(mcp, dict):
        raise ValueError("config.json mcp must be an object")
    jira = mcp.get("jira")
    if jira is None:
        return []
    if not isinstance(jira, dict):
        raise ValueError("config.json mcp.jira must be an object")
    instances = jira.get("instances")
    if instances is None:
        return []
    if not isinstance(instances, dict):
        raise ValueError("config.json mcp.jira.instances must be an object")
    items = []
    for name, entry in instances.items():
        if not INSTANCE_NAME.fullmatch(name):
            raise ValueError(
                f"config.json mcp.jira.instances key {name!r} must start with a "
                "letter and use only letters, digits, _ or -")
        if not isinstance(entry, dict):
            raise ValueError(f"config.json mcp.jira.instances.{name} must be an object")
        url = entry.get("url")
        if not isinstance(url, str) or not url.strip():
            raise ValueError(
                f"config.json mcp.jira.instances.{name}.url must be a non-empty string")
        items.append((name, url.strip()))
    if len(items) == 1:
        return [("jira", items[0][1])]
    return items


def mcp_gui_env():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return {
        "DISPLAY": os.environ.get("DISPLAY") or ":0",
        "DBUS_SESSION_BUS_ADDRESS": (
            os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime}/bus"),
        "XDG_RUNTIME_DIR": runtime,
    }


def stdio_server(helper, url, env):
    return {"command": str(helper), "args": [url], "env": env}


def opencode_server(helper, url, env):
    return {
        "type": "local",
        "command": [str(helper), url],
        "enabled": True,
        "environment": env,
        "timeout": 180000,
    }


def toml_scalar(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_scalar(item) for item in value) + "]"
    if not isinstance(value, str):
        raise ValueError(f"unsupported TOML value {value!r}")
    return json.dumps(value)


def toml_server(helper, url, env):
    return {"command": str(helper), "args": [url], "startup_timeout_sec": 180,
            "enabled": True, "env": env}


def render_toml_table(header, value):
    lines = [f"[{header}]"]
    lines += [f"{key} = {toml_scalar(item)}" for key, item in value.items()
              if not isinstance(item, dict)]
    text = "\n".join(lines) + "\n"
    for key, item in value.items():
        if isinstance(item, dict):
            text += "\n" + render_toml_table(f"{header}.{key}", item)
    return text


def strip_toml_mcp(text, names):
    names = set(names)
    out = []
    skipping = False
    for line in text.splitlines(True):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            header = stripped[1:-1].strip()
            skipping = False
            for name in names:
                key = f"mcp_servers.{name}"
                if header == key or header.startswith(key + "."):
                    skipping = True
                    break
        if not skipping:
            out.append(line)
    return "".join(out)


def edit_toml(text, changes):
    """Replace or remove sync's [mcp_servers.<name>] tables; keep the rest."""
    text = strip_toml_mcp(text, [keys[-1] for keys in changes])
    chunks = [text.rstrip() + "\n"] if text.strip() else []
    for keys, value in changes.items():
        if value is not MISSING:
            chunks.append(render_toml_table(".".join(keys), value))
    return "\n".join(chunks)


def edit_json(data, changes):
    for keys, value in changes.items():
        bucket = data
        for key in keys[:-1]:
            bucket = bucket.setdefault(key, {})
        if value is not MISSING:
            bucket[keys[-1]] = value
            continue
        bucket.pop(keys[-1], None)
        if not bucket and len(keys) > 1:
            del data[keys[0]]
    return json.dumps(data, indent=2) + "\n"


def read_shared(home, relative):
    """Read a tool-owned file that holds sync entries.

    A symlink is followed: the file belongs to the tool and the user, so it
    stays where they put it.
    """
    path = home / relative
    if path.is_symlink():
        path = path.resolve()
    if not path.exists():
        return path, None, {}
    if not path.is_file():
        raise ValueError(f"{path} is not a file")
    raw = path.read_bytes()
    data = tomllib.loads(raw.decode()) if relative.endswith(".toml") else json.loads(raw)
    if not isinstance(data, dict):
        raise ValueError(f"{path} must be a JSON object")
    return path, raw, data


def entry_value(path, data, keys):
    for key in keys[:-1]:
        data = data.get(key, {})
        if not isinstance(data, dict):
            raise ValueError(f"{path}: {key} must be an object")
    return data.get(keys[-1], MISSING)


def canonical(value):
    """One text form for hashing and comparing entry values, never Python ==."""
    return json.dumps(value, sort_keys=True, default=str)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def load_state(home):
    """Read what earlier runs installed: item -> hash of what sync wrote."""
    path = home / STATE
    if not path.is_file():
        return {"files": {}, "entries": {}}
    state = json.loads(path.read_text())
    if not isinstance(state, dict) or set(state) != {"files", "entries"}:
        raise ValueError(f"{path} must hold exactly files and entries")
    for section in state.values():
        if not isinstance(section, dict) or not all(
                isinstance(value, str) for value in section.values()):
            raise ValueError(f"{path} sections must map items to hashes")
        for key in section:
            relative = PurePosixPath(key.partition("#")[0])
            if relative.is_absolute() or ".." in relative.parts or not relative.parts:
                raise ValueError(f"{path}: {key!r} is not a path inside the home folder")
    if not all(key.partition("#")[2] for key in state["entries"]):
        raise ValueError(f"{path} entries must be named <file>#<key>")
    return state


def file_hash(target):
    """None when missing, BLOCKED for a directory. A symlink never matches a hash."""
    if target.is_symlink():
        return "symlink"
    if target.is_file():
        return digest(target.read_bytes())
    return BLOCKED if target.exists() else None


def decide(wanted, recorded, probe):
    """Apply the ownership rule to every wanted or recorded item.

    An item is clean when it equals what sync wants or what sync recorded.
    Sync changes clean items freely; anything else needs a backup. Items that
    are neither wanted nor recorded are never looked at.
    """
    verbs = {}
    for key in sorted(wanted.keys() | recorded.keys()):
        found = probe(key)
        if found is BLOCKED:
            verbs[key] = "blocked"
        elif key in wanted:
            if found is None:
                verbs[key] = "create"
            elif found == wanted[key]:
                verbs[key] = "keep"
            else:
                verbs[key] = "replace" if found == recorded.get(key) else "replace+backup"
        elif found is None:
            verbs[key] = "forget"
        else:
            verbs[key] = "delete" if found == recorded[key] else "delete+backup"
    return verbs


def blocking_parent(home, target, removed):
    for parent in target.parents:
        if parent == home:
            return None
        if (parent.is_symlink() or parent.exists()) and not parent.is_dir():
            return None if parent in removed else parent
    return None


def back_up(home, relative, stamp, source=None):
    backup = home / BACKUPS / stamp / relative
    backup.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source or home / relative, backup, follow_symlinks=False)
    print(f"BACKUP: {backup}")


def write_file(target, contents, stamp, executable=False):
    target.parent.mkdir(parents=True, exist_ok=True)
    # Replace the directory entry, never write through an existing symlink.
    temporary = target.with_name(f".{target.name}.sync-{stamp}")
    try:
        with temporary.open("xb") as stream:
            stream.write(contents)
        if executable:
            temporary.chmod(0o755)
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)


def prune(home, target):
    """Remove the emptied folders of a skill, never the skills folder itself."""
    for destinations in TOOLS.values():
        root = home / destinations["skills"]
        if root not in target.parents:
            continue
        for folder in target.parents:
            if folder == root or folder.is_symlink():
                return
            try:
                folder.rmdir()
            except OSError:
                return


def default_skill_harnesses(default):
    if default == "shared":
        return [name for name, destinations in TOOLS.items() if "skills" in destinations]
    return [default]


def skill_harnesses(entry, default):
    """Read our single-line metadata.harness string, not general YAML."""
    lines = entry.read_text().splitlines()
    if not lines or lines[0] != "---":
        return default_skill_harnesses(default)
    try:
        end = lines.index("---", 1)
    except ValueError:
        raise ValueError(f"{entry}: frontmatter must end with ---") from None
    in_metadata = False
    harnesses = None
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            in_metadata = line.rstrip() == "metadata:"
            if line.startswith("metadata:") and not in_metadata:
                raise ValueError(f"{entry}: metadata must be a block starting with metadata:")
            continue
        if not in_metadata or not line.lstrip().startswith("harness:"):
            continue
        match = re.fullmatch(r'  harness: "([a-z, -]+)"\s*', line)
        if not match:
            raise ValueError(f'{entry}: use exactly two spaces then harness: "grok, opencode"')
        if harnesses is not None:
            raise ValueError(f"{entry}: duplicate metadata.harness")
        harnesses = [name.strip() for name in match[1].split(",")]
        if any(name not in TOOLS for name in harnesses):
            raise ValueError(f"{entry}: harness names must be one of {', '.join(TOOLS)}")
        if len(set(harnesses)) != len(harnesses):
            raise ValueError(f"{entry}: duplicate harness names")
    return harnesses if harnesses is not None else default_skill_harnesses(default)


def desired_files(config, home):
    """Return the files the repository wants installed, and which are executable."""
    files = {}
    executable = set()
    skill_sources = {}
    common = (ROOT / "instructions/common.md").read_text().strip()

    for tool, destinations in TOOLS.items():
        if "instructions" in destinations:
            specific = (ROOT / f"instructions/{tool}.md").read_text().strip()
            contents = "\n\n".join(part for part in [common, specific] if part)
            if contents:
                if tool == "cursor":
                    contents = CURSOR_HEADER + contents
                files[home / destinations["instructions"]] = (contents + "\n").encode()

        skills_dir = ROOT / "skills" / tool
        if skills_dir.is_dir():
            for skill in sorted(skills_dir.iterdir()):
                entry = skill / "SKILL.md"
                if not entry.is_file() or not entry.read_text().strip():
                    continue
                for harness in skill_harnesses(entry, tool):
                    destination = home / TOOLS[harness]["skills"] / skill.name
                    if destination in skill_sources:
                        raise ValueError(f"Duplicate skill destination {destination}: "
                                         f"{skill_sources[destination]} and {skill}")
                    skill_sources[destination] = skill
                    if not is_enabled(config, "skills", skill.name):
                        continue
                    for file in sorted(skill.rglob("*")):
                        if file.is_file():
                            target = destination / file.relative_to(skill)
                            files[target] = file.read_bytes()
                            if file.stat().st_mode & 0o111:
                                executable.add(target)

        agents_dir = ROOT / "agents" / tool
        if "agents" in destinations and agents_dir.is_dir():
            for agent in sorted(agents_dir.iterdir()):
                if (agent.is_file() and agent.read_text().strip()
                        and is_enabled(config, "agents", agent.stem)):
                    files[home / destinations["agents"] / agent.name] = agent.read_bytes()

        hooks_file = ROOT / "hooks" / f"{tool}.json"
        if ("hooks" in destinations and tool != "claude-code" and hooks_file.is_file()
                and is_enabled(config, "hooks", tool)):
            files[home / destinations["hooks"]] = hooks_file.read_bytes()

    for script in sorted((ROOT / "bin").glob("*")):
        if script.is_file():
            target = home / ".local/bin" / script.name
            files[target] = script.read_bytes()
            executable.add(target)
    return files, executable


def desired_entries(config, home):
    """Return the values sync owns inside tool-owned files, as <file>#<key> -> value."""
    entries = {}
    hooks_file = ROOT / "hooks/claude-code.json"
    if hooks_file.is_file() and is_enabled(config, "hooks", "claude-code"):
        # Claude Code keeps hooks inside settings.json next to unrelated
        # settings, so sync owns only the "hooks" key.
        entries[f"{TOOLS['claude-code']['hooks']}#hooks"] = json.loads(hooks_file.read_text())
    helper = home / ".local/bin/mcp-atlassian-start"
    env = mcp_gui_env()
    for name, url in jira_servers(config):
        for relative, bucket, flavor in MCP_JSON:
            server = opencode_server if flavor == "opencode" else stdio_server
            entries[f"{relative}#{bucket}.{name}"] = server(helper, url, env)
        for relative in MCP_TOML:
            entries[f"{relative}#mcp_servers.{name}"] = toml_server(helper, url, env)
    return entries


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true", help="write the previewed changes")
    mode.add_argument("--check", action="store_true", help="exit nonzero when changes are needed")
    mode.add_argument("--clean-backups", action="store_true",
                      help="delete the backups sync has saved, then exit")
    parser.add_argument("--replace-existing", action="store_true",
                        help="allow replacing or deleting content sync did not write, "
                             "keeping backups")
    parser.add_argument("--home", type=Path, default=Path.home(),
                        help="destination home directory (useful for testing)")
    args = parser.parse_args()
    home = args.home.expanduser().resolve()

    if args.clean_backups:
        backups = home / BACKUPS
        count = len(list(backups.iterdir())) if backups.is_dir() else 0
        shutil.rmtree(backups, ignore_errors=True)
        print(f"Deleted {count} backup run(s).")
        return 0

    config = load_config()
    files, executable = desired_files(config, home)
    entries = desired_entries(config, home)
    state = load_state(home)
    wanted = {target.relative_to(home).as_posix(): digest(contents)
              for target, contents in files.items()}
    verbs = decide(wanted, state["files"], lambda key: file_hash(home / key))
    for key, verb in verbs.items():
        if (verb == "keep" and home / key in executable
                and not (home / key).stat().st_mode & 0o111):
            verbs[key] = "chmod"

    shared = {}

    def entry_hash(key):
        relative, _, dotted = key.partition("#")
        if relative not in shared:
            shared[relative] = read_shared(home, relative)
        path, _raw, data = shared[relative]
        value = entry_value(path, data, dotted.split("."))
        return None if value is MISSING else digest(canonical(value).encode())

    wanted_entries = {key: digest(canonical(value).encode()) for key, value in entries.items()}
    entry_verbs = decide(wanted_entries, state["entries"], entry_hash)

    blocked = False
    removed = {home / key for key, verb in verbs.items() if verb.startswith("delete")}
    for key, verb in verbs.items():
        target = home / key
        parent = blocking_parent(home, target, removed) if verb == "create" else None
        if verb == "blocked":
            print(f"BLOCKED (destination is not a file): {target}")
        elif parent:
            print(f"BLOCKED (parent is not a folder): {parent}")
        elif verb.endswith("+backup") and not args.replace_existing:
            print(f"BLOCKED (requires --replace-existing): {target}")
        else:
            if verb not in ("keep", "forget"):
                print(f"{verb.replace('+', ' + ').upper()}: {target}")
            continue
        blocked = True

    rewrites = {}
    for key, verb in entry_verbs.items():
        if verb.endswith("+backup") and not args.replace_existing:
            print(f"BLOCKED (requires --replace-existing): {home / key}")
            blocked = True
        elif verb not in ("keep", "forget"):
            print(f"{verb.replace('+', ' + ').upper()}: {home / key}")
            relative, _, dotted = key.partition("#")
            rewrites.setdefault(relative, {})[tuple(dotted.split("."))] = entries.get(
                key, MISSING)

    new_state = {"files": wanted, "entries": wanted_entries}
    adopted = sum(1 for section, found in (("files", verbs), ("entries", entry_verbs))
                  for key, verb in found.items()
                  if verb in ("keep", "chmod") and state[section].get(key) != new_state[section][key])
    if adopted:
        print(f"RECORD: {adopted} installed item(s) that already match")

    if blocked:
        print("No files written. Review destinations before using --replace-existing.")
        return 2
    changes = [key for key, verb in verbs.items() if verb != "keep"]
    if not changes and not rewrites and new_state == state:
        print("No changes needed." if files or entries else
              "No populated sources; empty placeholders skipped.")
        return 0
    if args.check:
        return 1
    if not args.apply:
        print("Preview only. Use --apply to write these changes.")
        return 0

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    for relative, changes_here in rewrites.items():
        path, raw, data = shared[relative]
        # The tools rewrite these files while they run. Do not write over a
        # change that arrived after sync read the file.
        if (path.read_bytes() if path.is_file() else None) != raw:
            raise ValueError(f"{path} changed during sync; run again")
        if raw is not None:
            back_up(home, relative, stamp, path)
        if relative.endswith(".toml"):
            contents = edit_toml(raw.decode() if raw else "", changes_here)
        else:
            contents = edit_json(data, changes_here)
        write_file(path, contents.encode(), stamp)
    # Deletions come first so a file that became a folder of the same name works.
    for key, verb in verbs.items():
        target = home / key
        if verb.startswith("delete"):
            if verb == "delete+backup":
                back_up(home, key, stamp)
            target.unlink()
        if verb.startswith("delete") or verb == "forget":
            prune(home, target)
    for key, verb in verbs.items():
        target = home / key
        if verb == "chmod":
            target.chmod(0o755)
        elif verb in ("create", "replace", "replace+backup"):
            if verb == "replace+backup":
                back_up(home, key, stamp)
            write_file(target, files[target], stamp, target in executable)
    # The state file goes last: after a crash the next run finds the written
    # items equal to what it wants and records them then.
    write_file(home / STATE, (json.dumps(new_state, indent=2) + "\n").encode(), stamp)
    (home / LEGACY_STATE).unlink(missing_ok=True)
    print(f"Applied {len(changes) + sum(map(len, rewrites.values()))} change(s). "
          "Restart sessions to load new instructions.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"Sync failed: {error}", file=sys.stderr)
        sys.exit(2)
