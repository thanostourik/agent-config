#!/usr/bin/env python3
"""Preview configuration changes; use --apply to install them.

Examples:
  ./sync
  ./sync --apply
  ./sync --apply --replace-existing
  ./sync --check
  ./sync --clean-backups
  ./sync --home /tmp/agent-config-test --apply

Empty Markdown placeholders are skipped. Existing files are replaced only
with --replace-existing and are backed up alongside the destination first.
Cursor rules are installed in ~/.cursor/rules/agent-config.mdc and always
apply. Cursor IDE discovers these for projects under the home directory.
"""

import argparse
import json
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parent
# Per-tool destinations relative to the home directory. Source layout:
#   instructions/<tool>.md  -> instructions (common.md is prepended)
#   skills/<tool>/<name>/   -> skills
#   agents/<tool>/<name>.*  -> agent definitions
#   hooks/<tool>.json       -> hook configuration (copied as is; for Claude Code
#                              it is the "hooks" value merged into settings.json)
# skills/shared/ installs to ~/.agents/skills, which several tools read.
TOOLS = {
    "claude-code": {"instructions": ".claude/CLAUDE.md", "hooks": ".claude/settings.json",
                    "skills": ".claude/skills", "agents": ".claude/agents"},
    "codex": {"instructions": ".codex/AGENTS.md", "hooks": ".codex/hooks.json",
              "skills": ".codex/skills", "agents": ".codex/agents"},
    "grok": {"instructions": ".grok/AGENTS.md",
             "skills": ".grok/skills", "agents": ".grok/agents"},
    "opencode": {"instructions": ".config/opencode/AGENTS.md",
                 "skills": ".config/opencode/skill", "agents": ".config/opencode/agent"},
    "cursor": {"instructions": ".cursor/rules/agent-config.mdc", "hooks": ".cursor/hooks.json",
               "skills": ".cursor/skills", "agents": ".cursor/agents"},
    "shared": {"skills": ".agents/skills"},
}
CURSOR_HEADER = "---\ndescription: Personal agent configuration\nglobs: \nalwaysApply: true\n---\n\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true", help="write the previewed changes")
    mode.add_argument("--check", action="store_true", help="exit nonzero when changes are needed")
    mode.add_argument("--clean-backups", action="store_true",
                      help="delete backups next to installed files, then exit")
    parser.add_argument("--replace-existing", action="store_true",
                        help="allow replacement of existing destinations, keeping backups")
    parser.add_argument("--home", type=Path, default=Path.home(),
                        help="destination home directory (useful for testing)")
    args = parser.parse_args()
    home = args.home.expanduser().resolve()
    files = {}
    executable_files = set()
    common = (ROOT / "instructions/common.md").read_text().strip()

    for tool, destinations in TOOLS.items():
        if "instructions" in destinations:
            specific = (ROOT / f"instructions/{tool}.md").read_text().strip()
            contents = "\n\n".join(part for part in [common, specific] if part)
            if contents:
                if tool == "cursor":
                    contents = CURSOR_HEADER + contents
                files[home / destinations["instructions"]] = (contents + "\n").encode()

        skills_dir = ROOT / "skills" / tool
        if "skills" in destinations and skills_dir.is_dir():
            for skill in sorted(skills_dir.iterdir()):
                entry = skill / "SKILL.md"
                if not entry.is_file() or not entry.read_text().strip():
                    continue
                for file in sorted(skill.rglob("*")):
                    if file.is_file():
                        target = home / destinations["skills"] / skill.name / file.relative_to(skill)
                        files[target] = file.read_bytes()
                        if file.stat().st_mode & 0o111:
                            executable_files.add(target)

        agents_dir = ROOT / "agents" / tool
        if "agents" in destinations and agents_dir.is_dir():
            for agent in sorted(agents_dir.iterdir()):
                if agent.is_file() and agent.read_text().strip():
                    files[home / destinations["agents"] / agent.name] = agent.read_bytes()

        hooks_file = ROOT / "hooks" / f"{tool}.json"
        if "hooks" in destinations and hooks_file.is_file():
            target = home / destinations["hooks"]
            if tool == "claude-code":
                # Claude Code keeps hooks inside settings.json next to unrelated
                # settings, so replace only the "hooks" key and keep the rest.
                settings = json.loads(target.read_text()) if target.is_file() else {}
                settings["hooks"] = json.loads(hooks_file.read_text())
                files[target] = (json.dumps(settings, indent=2) + "\n").encode()
            else:
                files[target] = hooks_file.read_bytes()

    if args.clean_backups:
        backups = [b for target in files for b in target.parent.glob(f"{target.name}.backup-*")]
        for backup in backups:
            backup.unlink()
            print(f"DELETED: {backup}")
        print(f"Deleted {len(backups)} backup(s).")
        return 0

    changes = []
    blocked = False
    for target, contents in files.items():
        exists = target.exists() or target.is_symlink()
        if (target.is_file() and target.read_bytes() == contents
                and (target not in executable_files or target.stat().st_mode & 0o111)):
            continue
        if exists and not (target.is_file() or target.is_symlink()):
            print(f"BLOCKED (destination is not a file): {target}")
            blocked = True
            continue
        if exists and not args.replace_existing:
            print(f"BLOCKED (requires --replace-existing): {target}")
            blocked = True
        else:
            print(f"{'REPLACE + BACKUP' if exists else 'CREATE'}: {target}")
        changes.append((target, contents, exists))

    if blocked:
        print("No files written. Review destinations before using --replace-existing.")
        return 2
    if not changes:
        print("No changes needed." if files else "No populated sources; empty placeholders skipped.")
        return 0
    if args.check:
        return 1
    if not args.apply:
        print("Preview only. Use --apply to write these changes.")
        return 0

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    for target, contents, exists in changes:
        target.parent.mkdir(parents=True, exist_ok=True)
        if exists:
            backup = target.with_name(f"{target.name}.backup-{stamp}")
            shutil.copy2(target, backup, follow_symlinks=False)
            print(f"BACKUP: {backup}")
        # Replace the directory entry, never write through an existing symlink.
        temporary = target.with_name(f".{target.name}.sync-{stamp}")
        try:
            with temporary.open("xb") as stream:
                stream.write(contents)
            if target in executable_files:
                temporary.chmod(0o755)
            temporary.replace(target)
        finally:
            temporary.unlink(missing_ok=True)
    print(f"Applied {len(changes)} file change(s). Restart sessions to load new instructions.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"Sync failed: {error}", file=sys.stderr)
        sys.exit(2)
